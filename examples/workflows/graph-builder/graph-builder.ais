// graph-builder.ais — Meta-workflow: builds APXM workflows from any goal
//
// Give it a dream. It designs and writes the optimal APXM workflow to achieve it.
// Output: complete .ais infrastructure files, agent profiles, and usage instructions.
//
// Usage: dekk apxm execute examples/workflows/graph-builder/graph-builder.ais

agent GraphBuilder {
    @entry flow main() -> str {

        // ── SET YOUR GOAL HERE ────────────────────────────────────────────
        // This string is the dream/goal you want to turn into a workflow.
        // Change it to describe any project, tool, or system you want to build.
        ask("clic-designer: AI-first commercial app builder. Takes a plain-language brief and produces a production-ready app. Enforces a full design phase before implementation: 4 parallel specialist agents produce 6 JSON spec artifacts (entity_map, navigation_spec, competitor_analysis, design_system, product_spec, screen_manifest), then generate ALL screens x ALL states as verified HTML. 2-stage verification gate: Qwen3 structural audit + Playwright screenshot to Qwen-VL visual review. Then convert verified HTML to any framework (Flutter/React/Vue/SwiftUI). Phases: DISCOVER, GENERATE (2A components + 2B shared + 2C feature screens), CONVERT, IMPLEMENT, TEST. Design the complete APXM workflow infrastructure for this.") -> mission

        // ── Phase 1: Parallel analysis ────────────────────────────────────
        spawn_agent("strategist", "claude", "$APXM_HOME") -> _str
        spawn_agent("architect",  "claude", "$APXM_HOME") -> _arch
        spawn_agent("skeptic",    "claude", "$APXM_HOME") -> _sk

        // Build strategy prompt
        ask("Build a workflow strategy analysis prompt for this goal: " + mission + " The prompt should ask a Workflow Strategist to produce strategy.json with: goal_type, phases (name/purpose/inputs/outputs/can_parallelize), critical_path, parallelization_opportunities, verification_gates, human_checkpoints, estimated_complexity. Keep the prompt concise and direct.") -> strategy_prompt

        communicate("strategist", "acp", strategy_prompt) -> strategy

        // Build architect prompt
        ask("Build an agent topology design prompt. Goal: " + mission + " Strategy already produced: " + strategy + " Ask an Agent Topology Architect to produce topology.json with: agents (name/role/profile/specialization/inputs/outputs/calls), entry_points, sub_workflows, data_artifacts. Profiles are claude/codex/qwen.") -> arch_prompt

        communicate("architect", "acp", arch_prompt) -> topology

        // Build skeptic prompt
        ask("Build a skeptic challenge prompt. Goal: " + mission + " Strategy: " + strategy + " Topology: " + topology + " Ask a Workflow Skeptic to find: over-engineering, missing pieces, wrong ordering, bad profile fits, and define the minimum viable version. Output skeptic_review.json.") -> skeptic_prompt

        communicate("skeptic", "acp", skeptic_prompt) -> skeptic_review

        // ── Phase 2: Generate the .ais files ─────────────────────────────
        spawn_agent("ais_writer", "claude", "$APXM_HOME") -> _aw

        // Build AIS writing prompt
        ask("Build a prompt for an AIS DSL expert to write complete APXM workflow .ais files. Goal: " + mission + " Strategy: " + strategy + " Topology: " + topology + " Skeptic feedback: " + skeptic_review + " Include AIS syntax reference: agent Name { @entry flow main(param: type) -> type { spawn_agent(name, profile, cwd) -> handle; communicate(recipient, protocol, message) -> result; ask(prompt) -> result; think(prompt) -> result; print(message); return value } }. Ask for a JSON map of filename -> complete_ais_content for all entry, phase, and sub-workflow files.") -> ais_prompt

        communicate("ais_writer", "acp", ais_prompt) -> ais_files

        // Build profiles prompt
        ask("Build a prompt for writing focused agent context profiles. Topology: " + topology + " Ask for 100-200 word context blocks for each agent specifying their role, input format, output format, constraints. Output JSON map of agent_name -> context_text.") -> profiles_prompt

        communicate("ais_writer", "acp", profiles_prompt) -> agent_profiles

        // ── Phase 3: Final synthesis ──────────────────────────────────────
        ask("Synthesize a complete actionable summary. Goal: " + mission + " AIS files generated: " + ais_files + " Agent profiles: " + agent_profiles + " Format: ## WORKFLOW DESIGN: [name]\n### What This Builds\n### Files to Create (filename: description)\n### How to Run It (exact commands)\n### Agent Roster (agent: role + profile)\n### Minimum Viable First Run (what to build first)") -> summary

        print("GRAPH-BUILDER OUTPUT\n\n" + summary + "\n\nGENERATED AIS FILES:\n" + ais_files + "\n\nAGENT PROFILES:\n" + agent_profiles)

        return summary
    }
}
