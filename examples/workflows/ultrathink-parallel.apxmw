{
  "name": "ultrathink-parallel",
  "description": "Parallel planning: architect + adversary + impl-expert, then synthesize",
  "parameters": [
    {
      "name": "TASK",
      "type_name": "str"
    }
  ],
  "graphs": [
    {
      "id": "architect",
      "path": "sub/architect.apxm",
      "params": {
        "TASK": "{{TASK}}"
      }
    },
    {
      "id": "adversary",
      "path": "sub/adversary.apxm",
      "params": {
        "TASK": "{{TASK}}"
      }
    },
    {
      "id": "impl_expert",
      "path": "sub/impl-expert.apxm",
      "params": {
        "TASK": "{{TASK}}"
      }
    },
    {
      "id": "synthesize",
      "path": "sub/synthesize.apxm",
      "depends_on": ["architect", "adversary", "impl_expert"],
      "params": {
        "ARCH": "{{architect.output}}",
        "ADVER": "{{adversary.output}}",
        "IMPL": "{{impl_expert.output}}"
      }
    }
  ],
  "output": "{{synthesize.output}}"
}
