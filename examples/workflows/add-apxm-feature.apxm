      "from": 1,
      "to": 6,
      "dependency": "Data"
    },
    {
      "from": 2,
      "to": 6,
      "dependency": "Data"
    },
    {
      "from": 3,
      "to": 6,
      "dependency": "Data"
    },
    {
      "from": 6,
      "to": 7,
      "dependency": "Data"
    },
    {
      "from": 7,
      "to": 8,
      "dependency": "Data"
    },
    {
      "from": 7,
      "to": 9,
      "dependency": "Data"
    },
    {
      "from": 9,
      "to": 10,
      "dependency": "Data"
    },
    {
      "from": 10,
      "to": 11,
      "dependency": "Data"
    },
    {
      "from": 10,
      "to": 12,
      "dependency": "Data"
    },
    {
      "from": 12,
      "to": 13,
      "dependency": "Data"
    },
    {
      "from": 13,
      "to": 14,
      "dependency": "Data"
    }
  ],
  "metadata": {
    "description": "Meta-workflow: 3 parallel THINK planning nodes (architectural, implementation, test-focused), WAIT_ALL sync, MERGE concat, THINK synthesis, THINK formats implementer prompt, INV(codex) implements, THINK formats reviewer prompt, INV(claude) reviews and fixes.",
    "pattern": "think x3 (parallel) \u2192 wait-all \u2192 merge \u2192 think (synthesize) \u2192 think (format impl prompt) \u2192 inv(codex) \u2192 think (format review prompt) \u2192 inv(claude)",
    "ops_demonstrated": [
      "THINK",
      "WAIT_ALL",
      "MERGE",
      "INV",
      "PRINT"
    ],
    "note": "THINK uses {0}=first-input positional substitution at runtime. INV(acp) uses {{input_0}} for the THINK-formatted prompt. Feature text is embedded directly in template_str by launch-feature.sh before execution.",
    "usage": "Use launch-feature.sh to run \u2014 it substitutes {{FEATURE_REQUEST}} with the actual feature text before invoking dekk apxm execute.",
    "is_entry": true
  }
}