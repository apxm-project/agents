{
  "name": "add-apxm-feature",
  "parameters": [],
  "nodes": [
    {
      "id": 1,
      "name": "arch_prompt",
      "op": "THINK",
      "attributes": {
        "template_str": "You are an APXM architect (project at ~/projects/agents/apxm). Think deeply (ultrathink). Read the relevant codebase first. Produce a detailed, file-by-file implementation plan with exact paths and code snippets. Focus: architecture, API design, and integration points.\n\nFeature to implement:\n{{FEATURE_REQUEST}}",
        "budget": 6000
      }
    },
    {
      "id": 2,
      "name": "impl_prompt",
      "op": "THINK",
      "attributes": {
        "template_str": "You are an APXM implementation expert (project at ~/projects/agents/apxm). Think deeply (ultrathink). Focus: exact Rust code, function signatures, error handling, tests. Produce a complete implementation plan with full code blocks.\n\nFeature to implement:\n{{FEATURE_REQUEST}}",
        "budget": 6000
      }
    },
    {
      "id": 3,
      "name": "test_prompt",
      "op": "THINK",
      "attributes": {
        "template_str": "You are an APXM quality engineer (project at ~/projects/agents/apxm). Think deeply (ultrathink). Focus: test coverage, edge cases, error paths, backward compatibility, and minimal viable implementation.\n\nFeature to implement:\n{{FEATURE_REQUEST}}",
        "budget": 6000
      }
    },
    {
      "id": 4,
      "name": "sync_plans",
      "op": "WAIT_ALL",
      "attributes": {
        "tokens": [
          "{{node_1}}",
          "{{node_2}}",
          "{{node_3}}"
        ]
      }
    },
    {
      "id": 5,
      "name": "print_plans_done",
      "op": "PRINT",
      "attributes": {
        "message": "=== 3 PLANS COLLECTED ==="
      }
    },
    {
      "id": 6,
      "name": "all_plans",
      "op": "MERGE",
      "attributes": {
        "strategy": "concat",
        "tokens": [
          "{{node_1}}",
          "{{node_2}}",
          "{{node_3}}"
        ]
      }
    },
    {
      "id": 7,
      "name": "synthesize_plan",
      "op": "THINK",
      "attributes": {
        "template_str": "You are a senior APXM architect. You have 3 implementation plans for the same feature (architectural, implementation, and test-focused). Analyze all plans, pick the best ideas from each, resolve conflicts, and produce ONE unified implementation plan with exact file paths, complete working Rust code, and test cases.\n\nAll 3 plans:\n{0}",
        "budget": 12000
      }
    },
    {
      "id": 8,
      "name": "print_synthesis",
      "op": "PRINT",
      "attributes": {
        "message": "=== SYNTHESIZED PLAN ==="
      }
    },
    {
      "id": 9,
      "name": "implement_prompt",
      "op": "THINK",
      "attributes": {
        "template_str": "You are the APXM implementer. The project is at ~/projects/agents/apxm. Execute this plan EXACTLY: make all code changes, run: source ~/.cargo/env && dekk apxm build, fix any failures, run tests (dekk apxm test or cargo test --workspace --exclude apxm-compiler), git add -A, git commit. Report exactly what you changed.\n\nPlan:\n{0}",
        "budget": 3000
      }
    },
    {
      "id": 10,
      "name": "implement",
      "op": "INV",
      "attributes": {
        "capability": "acp",
        "params_json": "{\"agent\": \"codex\", \"prompt\": \"{{input_0}}\", \"cwd\": \"$APXM_HOME\"}",
        "timeout_ms": 1800000
      }
    },
    {
      "id": 11,
      "name": "print_implement",
      "op": "PRINT",
      "attributes": {
        "message": "=== IMPLEMENTATION COMPLETE ==="
      }
    },
    {
      "id": 12,
      "name": "review_prompt",
      "op": "THINK",
      "attributes": {
        "template_str": "You are the APXM code reviewer at ~/projects/agents/apxm. Review the implementation below: check correctness, run tests, simplify complexity, ensure everything is committed and the build passes. Fix anything that is wrong.\n\nImplementation report:\n{0}",
        "budget": 3000
      }
    },
    {
      "id": 13,
      "name": "review",
      "op": "INV",
      "attributes": {
        "capability": "acp",
        "params_json": "{\"agent\": \"claude\", \"prompt\": \"{{input_0}}\", \"cwd\": \"$APXM_HOME\"}",
        "timeout_ms": 900000
      }
    },
    {
      "id": 14,
      "name": "print_final",
      "op": "PRINT",
      "attributes": {
        "message": "=== FEATURE COMPLETE ==="
      }
    }
  ],
  "edges": [
    {
      "from": 1,
      "to": 4,
      "dependency": "Data"
    },
    {
      "from": 2,
      "to": 4,
      "dependency": "Data"
    },
    {
      "from": 3,
      "to": 4,
      "dependency": "Data"
