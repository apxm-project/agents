// ultrathink-coder.ais
// Ultrathink coding workflow: 3-way parallel speculative planning + synthesis +
// implementation via Claude Code agent.
//
// Usage: dekk apxm execute examples/workflows/ultrathink-coder.ais

agent Thinkers {
    flow architect(task: str) -> str {
        think("ultrathink. You are a Rust systems architect for the APXM project at ~/projects/agents/apxm. Read relevant source files first. Produce: which crates affected, exact file paths to create or modify, public API design (structs, traits, function signatures), integration with existing systems (ContextStack, MemoCache, Scheduler, ModelRouter), and architectural risks. Task: " + task) -> result
        return result
    }

    flow adversary(task: str) -> str {
        think("ultrathink. You are an adversarial reviewer. What already exists that should NOT be re-implemented? Minimal viable change vs over-engineering? Top 3 failure modes? What NOT to build in v1? The ONE thing that breaks everything if done wrong? Be brutal. Adversary wins on scope disputes. Read crates/apxm-runtime/src/model_router/ before answering. Task: " + task) -> result
        return result
    }

    flow impl_expert(task: str) -> str {
        think("ultrathink. You are a Rust implementation expert focused on correctness. Produce: complete Rust structs and impl blocks (not pseudocode), unit tests covering happy path and error paths, exact Cargo.toml additions needed. Build command: dekk apxm build (not bare cargo). Read relevant source files first. Task: " + task) -> result
        return result
    }

    flow synthesize(architect_out: str, adversary_out: str, impl_out: str) -> str {
        think("ultrathink. Synthesize 3 expert analyses into ONE unified implementation brief. Adversary wins on scope disputes. Include exact file paths and complete Rust code blocks. Include test cases. Flag uncertainty with [RISK: ...]. End with CONSERVATIVE APPROACH section and BOLD APPROACH section. ARCHITECT: " + architect_out + " ADVERSARY: " + adversary_out + " IMPL EXPERT: " + impl_out) -> result
        return result
    }
}

agent UltrathinkCoder {
    @entry flow main() -> str {
        spawn_agent("coder", "claude", "$APXM_HOME") -> _coder

        ask("What coding task should ultrathink implement for APXM?") -> task

        Thinkers.architect(task) -> arch_out
        Thinkers.adversary(task) -> adv_out
        Thinkers.impl_expert(task) -> impl_out

        Thinkers.synthesize(arch_out, adv_out, impl_out) -> synthesis

        think("From this synthesis, write a precise coding agent instruction. Include the conservative approach first (minimal, safe) and then the bold approach (full vision). Start with: cd ~/projects/agents/apxm. List exact files with full content. End each approach with: dekk apxm build, fix all errors, run tests, git commit. Synthesis: " + synthesis) -> coding_prompt

        communicate("coder", "acp", coding_prompt) -> implementation_result

        think("Reflect: what was built? Did it compile successfully? Which approach won? Summarize clearly for the engineer. Implementation result: " + implementation_result) -> summary

        update_memory(task, summary)
        print("=== ULTRATHINK COMPLETE ===\n" + summary)
        return summary
    }
}
