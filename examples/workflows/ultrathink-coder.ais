// ultrathink-coder.ais
// Ultrathink coding workflow: 3-way parallel planning + synthesis + implementation.
//
// Uses flow parameters to accept task description.
// Run via: dekk apxm execute ultrathink-coder.ais -- "your task description"

agent Thinkers {
    flow architect(task: str) -> str {
        think("ultrathink. You are a Rust systems architect for the APXM project at ~/projects/agents/apxm. Read relevant source files first. Produce: which crates affected, exact file paths to create or modify, public API design (structs, traits, function signatures), integration with existing systems (ContextStack, MemoCache, Scheduler, ModelRouter), and architectural risks. Task: " + task) -> result
        return result
    }

    flow adversary(task: str) -> str {
        think("ultrathink. You are an adversarial reviewer. What already exists that should NOT be re-implemented? Minimal viable change vs over-engineering? Top 3 failure modes? What NOT to build in v1? The ONE thing that breaks everything? Be brutal. Adversary wins on scope. Read crates/apxm-runtime/src/model_router/ first. Task: " + task) -> result
        return result
    }

    flow impl_expert(task: str) -> str {
        think("ultrathink. You are a Rust implementation expert. Produce: complete Rust structs and impl blocks (not pseudocode), unit tests for happy path and error paths, exact Cargo.toml additions. Build command: dekk apxm build. Read relevant source files first. Task: " + task) -> result
        return result
    }

    flow synthesize(arch: str, adv: str, impl_out: str) -> str {
        think("ultrathink. Synthesize 3 expert analyses into ONE implementation brief. Adversary wins on scope. Exact file paths + complete Rust code blocks. Test cases. Flag uncertainty with [RISK]. End with CONSERVATIVE APPROACH and BOLD APPROACH sections. ARCHITECT: " + arch + " ADVERSARY: " + adv + " IMPL EXPERT: " + impl_out) -> result
        return result
    }
}

agent UltrathinkCoder {
    @entry flow main(TASK: str) -> str {
        // spawn_agent at top — no longer conflicts with flow parameters after E511 fix
        spawn_agent("coder", "claude", "$APXM_HOME") -> _coder

        // Task received via flow parameter
        // Guard: ensure task is specific before proceeding
        think("You received this task. If it is vague or a generic placeholder, stop and say INVALID TASK. Otherwise, repeat it verbatim as confirmation: {{TASK}}") -> task_verified

        Thinkers.architect(task_verified) -> arch_out
        Thinkers.adversary(task_verified) -> adv_out
        Thinkers.impl_expert(task_verified) -> impl_out

        Thinkers.synthesize(arch_out, adv_out, impl_out) -> synthesis

        think("Write a precise coding agent instruction from this synthesis. Conservative approach first (minimal, safe), bold approach second (full vision). Start with: cd ~/projects/agents/apxm. List exact files with full content. End with: dekk apxm build, fix errors, run tests, git commit. Synthesis: " + synthesis) -> coding_prompt

        communicate("coder", "acp", coding_prompt) -> implementation_result

        think("Reflect: what was built? Did it compile? Which approach won? Summary for the engineer. Result: " + implementation_result) -> summary

        print("=== ULTRATHINK COMPLETE ===\n" + summary)
        return summary
    }
}
