// sub/export-to-figma.ais — Atomic: verified HTML → Figma frames + components + tokens
//
// Runs AFTER 2-stage verification passes.
// Creates Figma frames for every HTML screen x variant.
// Creates Figma components for every entry in component_registry.json.
// Syncs design_system.json → Figma variables.
//
// Called by: create.ais (optional step), add-feature.ais

agent FigmaExporter {
    @entry flow main() -> str {

        ask("Figma file key (from the Figma URL)") -> figma_file_key
        ask("Verified HTML files (JSON map of filepath -> html_content)") -> html_files
        ask("component_registry.json content") -> component_registry
        ask("design_system.json content") -> design_system
        ask("Stack for Code Connect (flutter/react/vue/swiftui)") -> stack

        spawn_agent("figma_agent", "claude", "$APXM_HOME") -> _fa

        // Export screens to Figma
        ask("Export verified HTML screens to Figma frames. File key: " + figma_file_key + " HTML files: " + html_files + " For each HTML file: create a Figma frame at web viewport (1440x960) and mobile viewport (393x852). Group frames by capability/audience. Name frames as: Role/Capability/Screen-Variant. Use Figma MCP to create frames. Return JSON: {frames_created: [{html_file, web_frame_id, mobile_frame_id}], figma_url}.") -> screens_prompt
        communicate("figma_agent", "acp", screens_prompt) -> screen_export

        // Export components
        ask("Export component definitions to Figma. Registry: " + component_registry + " Stack: " + stack + " File key: " + figma_file_key + " For each component: create a Figma component with the component's HTML as the design. Set Code Connect mapping to the framework widget from registry implementations." + stack + " field. Return JSON: {components_created: [{id, figma_component_id, code_connect_set}]}.") -> components_prompt
        communicate("figma_agent", "acp", components_prompt) -> component_export

        // Sync design tokens
        ask("Sync design tokens to Figma variables. Design system: " + design_system + " File key: " + figma_file_key + " Create Figma variables for: all colors (with semantic aliases), typography (font + size tokens), spacing (all scale values), radius tokens. Return JSON: {variables_created: [{token, figma_variable_id, type}], figma_url}.") -> tokens_prompt
        communicate("figma_agent", "acp", tokens_prompt) -> token_export

        ask("Summarize Figma export. Screens: " + screen_export + " Components: " + component_export + " Tokens: " + token_export + " Format: ## FIGMA EXPORT COMPLETE\n### Frames Created\n### Components Created\n### Design Tokens Synced\n### Figma File URL\n### Code Connect Status") -> summary

        print("FIGMA EXPORT COMPLETE\n\n" + summary)
        return summary
    }
}
