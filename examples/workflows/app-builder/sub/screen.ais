// sub/screen.ais — Atomic: generate ONE screen file (all variants)
//
// Conservative (Codex) + Bold (Claude) → Claude judges winner → return HTML
//
// Called by: phases/feature-screens.ais, edit-screen.ais
//
// Inputs: screen definition from screen_manifest.json
// Output: HTML content for the screen (all variants)

agent ScreenGenerator {
    @entry flow main() -> str {

        ask("Screen ID (e.g. seller/home/dashboard)") -> screen_id
        ask("Screen definition JSON from manifest (generates[], components_used[], design_notes)") -> screen_def
        ask("Available components JSON (from component_registry.json)") -> components
        ask("Design system JSON (design_system.json)") -> design_system

        spawn_agent("codex_writer",  "codex",  "$APXM_HOME") -> _cw
        spawn_agent("claude_writer", "claude", "$APXM_HOME") -> _clw
        spawn_agent("judge",         "claude", "$APXM_HOME") -> _j

        // Conservative implementation
        ask("Generate conservative HTML for screen: " + screen_id + " Definition: " + screen_def + " Components: " + components + " Design: " + design_system + " Generate ALL variants defined in the screen definition. Each variant in one file showing web 1440px + mobile 393px side by side via CSS classes. Use data-component placeholders. CSS vars only. Return JSON map of variant_file -> html_content.") -> codex_prompt
        communicate("codex_writer", "acp", codex_prompt) -> codex_version

        // Bold implementation
        ask("Generate bold HTML for screen: " + screen_id + " Definition: " + screen_def + " Components: " + components + " Design: " + design_system + " Same requirements as conservative but with richer visual treatment, better typography hierarchy, more polished empty/loading states. Return JSON map of variant_file -> html_content.") -> claude_prompt
        communicate("claude_writer", "acp", claude_prompt) -> claude_version

        // Judge picks winner
        ask("Pick the better screen implementation. Screen: " + screen_id + " Conservative: " + codex_version + " Bold: " + claude_version + " Criteria: visual quality, state clarity, accessibility, component usage correctness, mobile layout. Return JSON: {winner: conservative|bold, reason, winning_files: {variant_file: html_content}}.") -> judge_prompt
        communicate("judge", "acp", judge_prompt) -> winning_screen

        print("Screen " + screen_id + " generated.\n" + winning_screen)
        return winning_screen
    }
}
