// sub/verify-visual.ais — Atomic: Stage 2 visual verification
//
// Playwright renders each HTML file → PNG screenshots
// Qwen-VL reviews all PNGs together for cross-screen visual consistency
//
// Stage 2 gates on Stage 1 passing. CRITICAL = must fix. WARN = should fix.
//
// Called by: phases/feature-screens.ais, edit-screen.ais

agent VisualVerifier {
    @entry flow main() -> str {

        ask("HTML files to screenshot (JSON map of filepath -> html_content)") -> html_files
        ask("Output directory for PNG files") -> png_output_dir
        ask("Stage 1 structural results (must be passing)") -> stage1_results

        spawn_agent("screenshot_agent", "claude", "$APXM_HOME") -> _sa
        spawn_agent("qwen_vl",          "claude", "$APXM_HOME") -> _qv

        // Render screenshots via Playwright tool
        ask("Render these HTML files to PNG screenshots using Playwright headless browser. Files: " + html_files + " Output dir: " + png_output_dir + " For each file render TWO screenshots: web viewport (1440x960) saved as web-{screen}-{variant}.png, mobile viewport (393x852) saved as mobile-{screen}-{variant}.png. Return JSON: {screenshots: [{html_file, web_png, mobile_png, status: ok|error, error_msg}]}.") -> screenshot_prompt
        communicate("screenshot_agent", "acp", screenshot_prompt) -> screenshots

        // Qwen-VL visual review (all PNGs together)
        ask("You are a visual design reviewer with access to ALL app screenshots simultaneously. Review the visual design quality.\n\nSCREENSHOTS:\n" + screenshots + "\n\nSTAGE 1 CONTEXT:\n" + stage1_results + "\n\nFor each screen:\n1. Visual hierarchy — most important info most prominent?\n2. Information density — right for this viewport?\n3. State feel — triage looks urgent? Empty looks welcoming not empty?\n4. Mobile layout — thumb reach? Touch targets 44px+?\n5. Web layout — space used well? Not too sparse?\n\nCross-screen (all PNGs together):\n6. Alert card looks identical on every screen it appears?\n7. Consistent visual language across all role screens?\n8. All empty states use same illustration/layout pattern?\n\nReturn JSON:\n{results: [{file, web_rating: PASS|WARN|CRITICAL, mobile_rating: PASS|WARN|CRITICAL, feedback[]}], cross_screen: {consistency: PASS|WARN|CRITICAL, issues[]}, overall: PASS|WARN|CRITICAL}") -> visual_prompt

        communicate("qwen_vl", "acp", visual_prompt) -> visual_results

        print("VISUAL VERIFICATION COMPLETE\n\n" + visual_results)
        return visual_results
    }
}
