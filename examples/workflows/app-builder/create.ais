// create.ais — apxm-designer entry point: full app from scratch with session isolation
//
// Usage:
//   Edit BRIEF, STACK, BACKEND below then:
//   dekk apxm execute examples/workflows/appbuilder/create.ais
//
// Session isolation:
//   Every run creates ~/.apxm-designer/sessions/{project_name}-{YYYYMMDD-HHMMSS}/
//   All artifacts write to this directory (specs/, components/, screens/, code/)
//   state.json tracks completion status per phase
//
// What it does:
//   Phase 1 DISCOVER → Phase 2A COMMON PARTS → Phase 2B COMMON SCREENS
//   → Phase 2C FEATURE SCREENS → Phase 3A COMPONENT WIDGETS → Phase 3B CONVERT
//   → Phase 3C IMPLEMENT → Phase 4 TEST

agent Creator {
    @entry flow main() -> str {

        // ── CONFIGURE YOUR APP HERE ───────────────────────────────────────
        ask("A marketplace for handmade crafts") -> project_name
        ask("A marketplace for handmade crafts. Sellers list handmade items with photos and pricing. Buyers browse, filter by category/price/location, save favorites, message sellers, and checkout. Sellers have a dashboard with listings, orders, and earnings stats. Both parties can rate each other after a transaction.") -> brief
        ask("flutter") -> stack
        ask("go") -> backend

        // ── Generate session directory ───────────────────────────────────
        bash("date +%Y%m%d-%H%M%S") -> timestamp
        bash("echo ~/.apxm-designer/sessions/" + project_name + "-" + timestamp) -> session_dir_raw
        bash("mkdir -p ~/.apxm-designer/sessions && echo " + session_dir_raw) -> session_dir

        // ── Create session structure ─────────────────────────────────────
        bash("mkdir -p " + session_dir + "/specs " + session_dir + "/components " + session_dir + "/screens " + session_dir + "/code") -> _mkdirs

        // ── Initialize state.json using Python to avoid JSON quoting issues ─
        bash("python3 -c \"import json; json.dump({'version':'1','session':'" + session_dir + "','brief':'" + brief + "','stack':'" + stack + "','backend':'" + backend + "','phases':{}}, open('" + session_dir + "/state.json','w'), indent=2)\"") -> _state

        print("SESSION CREATED: " + session_dir)

        // ── Phase 1: DISCOVER ─────────────────────────────────────────────
        spawn_agent("discover_runner", "claude", "$APXM_HOME") -> _dr
        ask("Run Phase 1 DISCOVER. Write all outputs to session_dir using bash tool. Session dir: " + session_dir + " Brief: " + brief + " Stack: " + stack + " Backend: " + backend + " Run 4 parallel specialists (entity, competitor, nav, design), then architect + adversary produce 6 specs. Write to session_dir/specs/: entity_map.json, navigation_spec.json, competitor_analysis.json, design_system.json, product_spec.json, screen_manifest.json. Update state.json phase=discover status=complete. Return summary.") -> discover_prompt
        communicate("discover_runner", "acp", discover_prompt) -> discover_result

        // ── Phase 2A: COMMON PARTS ────────────────────────────────────────
        spawn_agent("parts_runner", "claude", "$APXM_HOME") -> _pr
        ask("Run Phase 2A COMMON PARTS. Read component_registry.json from session_dir/specs/, generate all components, write HTML to session_dir/components/. Session dir: " + session_dir + " For each component: CODEX conservative + CLAUDE bold, Claude picks winner, 2-stage verify. Update state.json phase=common-parts status=complete. Return summary.") -> parts_prompt
        communicate("parts_runner", "acp", parts_prompt) -> parts_result

        // ── Phase 2B: COMMON SCREENS ──────────────────────────────────────
        spawn_agent("common_runner", "claude", "$APXM_HOME") -> _cr
        ask("Run Phase 2B COMMON SCREENS. Read specs from session_dir/specs/, read components from session_dir/components/. Write screens to session_dir/screens/shared/. Session dir: " + session_dir + " Generate profile, messaging/inbox, messaging/conversation, settings. 2-stage verify. Update state.json phase=common-screens status=complete. Return summary.") -> common_prompt
        communicate("common_runner", "acp", common_prompt) -> common_result

        // ── Phase 2C: FEATURE SCREENS ─────────────────────────────────────
        spawn_agent("features_runner", "claude", "$APXM_HOME") -> _fr
        ask("Run Phase 2C FEATURE SCREENS. Read screen_manifest.json from session_dir/specs/, read components from session_dir/components/. Write all feature screens x variants to session_dir/screens/. Session dir: " + session_dir + " Generate all in parallel, 2-stage verify each. Update state.json phase=feature-screens status=complete. Return summary.") -> features_prompt
        communicate("features_runner", "acp", features_prompt) -> features_result

        // ── Phase 3A: COMPONENT WIDGETS ───────────────────────────────────
        spawn_agent("widgets_runner", "claude", "$APXM_HOME") -> _wr
        ask("Run Phase 3A COMPONENT WIDGETS. Read component_registry.json from session_dir/specs/. For each component: CODEX conservative widget + CLAUDE bold widget, Claude picks winner. Write framework code to session_dir/code/widgets/. Session dir: " + session_dir + " Stack: " + stack + " Update state.json phase=widgets status=complete. Return summary.") -> widgets_prompt
        communicate("widgets_runner", "acp", widgets_prompt) -> widgets_result

        // ── Phase 3B: CONVERT ─────────────────────────────────────────────
        spawn_agent("convert_runner", "claude", "$APXM_HOME") -> _xr
        ask("Run Phase 3B CONVERT. Read all HTML from session_dir/screens/, read widgets from session_dir/code/widgets/. Convert each HTML to framework screen using deterministic mapping. Write to session_dir/code/screens/. Session dir: " + session_dir + " Stack: " + stack + " Backend: " + backend + " Update state.json phase=convert status=complete. Return summary.") -> convert_prompt
        communicate("convert_runner", "acp", convert_prompt) -> convert_result

        // ── Phase 3C: IMPLEMENT ───────────────────────────────────────────
        spawn_agent("impl_runner", "claude", "$APXM_HOME") -> _ir
        ask("Run Phase 3C IMPLEMENT. Read specs from session_dir/specs/, read converted code from session_dir/code/. Generate backend endpoints, routing, state management, DI, auth, i18n. Write to session_dir/code/. Session dir: " + session_dir + " Stack: " + stack + " Backend: " + backend + " Update state.json phase=implement status=complete. Return summary.") -> impl_prompt
        communicate("impl_runner", "acp", impl_prompt) -> impl_result

        // ── Phase 4: TEST ─────────────────────────────────────────────────
        spawn_agent("test_runner", "claude", "$APXM_HOME") -> _tr
        ask("Run Phase 4 TEST. Read code from session_dir/code/. Run stack tests, state-coverage audit, quality gate. Write test results to session_dir/. Session dir: " + session_dir + " Stack: " + stack + " Update state.json phase=test status=complete. Return summary.") -> test_prompt
        communicate("test_runner", "acp", test_prompt) -> test_result

        // ── Final summary ─────────────────────────────────────────────────
        bash("jq . " + session_dir + "/state.json") -> final_state

        ask("Summarize the complete app generation run. Session: " + session_dir + " State: " + final_state + " Brief: " + brief + " Stack: " + stack + " Backend: " + backend + " Discover: " + discover_result + " Parts: " + parts_result + " Common: " + common_result + " Features: " + features_result + " Widgets: " + widgets_result + " Convert: " + convert_result + " Implement: " + impl_result + " Test: " + test_result + " Format: ## APP BUILT\n### Session Directory\n### What Was Built\n### Verification Status\n### Test Results\n### Next Steps") -> final_summary

        print("APXM-DESIGNER COMPLETE\n\nSESSION: " + session_dir + "\n\n" + final_summary)
        return final_summary
    }
}
