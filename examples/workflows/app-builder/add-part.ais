// add-part.ais — Add one new reusable component to the library
//
// Generates a single component: conservative + bold → pick winner → verify
// Adds it to component_registry.json. All screens can use it immediately.
//
// Usage:
//   dekk apxm execute examples/workflows/appbuilder/add-part.ais

agent PartAdder {
    @entry flow main() -> str {

        ask("Component name (e.g. review-card)") -> component_name
        ask("Component description (what it displays, what attributes it takes)") -> component_desc
        ask("Screens it will be used on") -> used_on
        ask("Project directory") -> project_dir

        spawn_agent("codex_gen",  "codex",  "$APXM_HOME") -> _cg
        spawn_agent("claude_gen", "claude", "$APXM_HOME") -> _clg
        spawn_agent("judge",      "claude", "$APXM_HOME") -> _j
        spawn_agent("verifier",   "claude", "$APXM_HOME") -> _v

        // Load design system for this project
        ask("Load design system from project: " + project_dir + "/.apxm-designer/specs/design_system.json Return the design system JSON.") -> load_prompt
        communicate("codex_gen", "acp", load_prompt) -> design_system

        // Generate conservative version
        ask("Generate conservative HTML for component: " + component_name + " Description: " + component_desc + " Used on: " + used_on + " Design system: " + design_system + " Show all states. Use data-component=" + component_name + " on the root element. CSS vars only. Full ARIA. Return HTML content.") -> codex_prompt
        communicate("codex_gen", "acp", codex_prompt) -> codex_version

        // Generate bold version
        ask("Generate bold HTML for component: " + component_name + " Description: " + component_desc + " Same requirements but more polished visual treatment. Return HTML content.") -> claude_prompt
        communicate("claude_gen", "acp", claude_prompt) -> claude_version

        // Pick winner
        ask("Pick the better component implementation. Component: " + component_name + " Conservative: " + codex_version + " Bold: " + claude_version + " Criteria: visual quality, accessibility, state completeness, maintainability. Return JSON: {winner, reason, html_content}.") -> judge_prompt
        communicate("judge", "acp", judge_prompt) -> winning_component

        // Verify
        ask("Verify this component HTML. Component: " + component_name + " HTML: " + winning_component + " Check: data-component attribute set, all states present, ARIA complete, CSS vars only, self-contained. Return JSON: {status: PASS|WARN|FAIL, issues[]}.") -> verify_prompt
        communicate("verifier", "acp", verify_prompt) -> verification

        ask("Summarize add-part run. Component: " + component_name + " Verification: " + verification + " Format: ## COMPONENT ADDED: " + component_name + "\n### What It Does\n### States Implemented\n### Verification Status\n### How to Use It") -> summary

        print("COMPONENT ADDED\n\n" + summary)
        return summary
    }
}
