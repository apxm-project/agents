// phases/common-screens.ais — Phase 2B: COMMON SCREENS
//
// Shared screens used by multiple audiences: profile, messaging, settings.
// Uses verified components from Phase 2A via data-component placeholders.
// 2-stage verification before handoff to Phase 2C.
//
// Inputs: session_dir (reads from specs/ and components/, writes to screens/shared/)
// Output: session_dir/screens/shared/*.html + verification results
//
// Usage (called by create.ais):
//   Receives session_dir as parameter

agent CommonScreensBuilder {
    @entry flow main() -> str {

        ask("Session directory path") -> session_dir

        // Read specs and components from session_dir
        bash("cat " + session_dir + "/specs/navigation_spec.json") -> nav_spec
        bash("cat " + session_dir + "/specs/design_system.json") -> design_system
        bash("cat " + session_dir + "/specs/component_registry.json") -> component_registry
        bash("ls " + session_dir + "/components/*.html") -> components_list

        spawn_agent("screen_gen", "claude", "$APXM_HOME") -> _sg
        spawn_agent("verifier",   "claude", "$APXM_HOME") -> _v

        // Generate all shared screens and write directly
        bash("mkdir -p " + session_dir + "/screens/shared/messaging") -> _mkdir

        ask("Generate shared screens for this app and write them directly to " + session_dir + "/screens/shared/ using bash. Nav spec: " + nav_spec + " Design system: " + design_system + " Components available: " + components_list + " Generate these files (each shows web 1440px + mobile 393px side by side):\n- profile.html (default + edit states)\n- messaging/inbox.html (loaded + empty states)\n- messaging/conversation.html (active + empty states)\n- settings.html\n\nRules: use data-component='component-id' placeholders for any reusable component, CSS vars only, semantic HTML, ARIA, web+mobile in one file using CSS classes (.viewport-web .viewport-mobile). Write each file directly to " + session_dir + "/screens/shared/{filename}. Return list of files written.") -> gen_prompt
        communicate("screen_gen", "acp", gen_prompt) -> files_written

        // Structural verification
        ask("Verify all shared screen HTML files in " + session_dir + "/screens/shared/. Component registry: " + component_registry + " Check: all data-component values exist in registry, all states present per screen, no hardcoded colors, web+mobile layouts included. Write verification results directly to " + session_dir + "/screens/shared/verification.json using bash. Schema: {results: [{file, status: PASS|WARN|FAIL, issues[]}], summary: {pass, warn, fail}}. Return file path when done.") -> verify_prompt
        communicate("verifier", "acp", verify_prompt) -> verification_written

        // Update state.json
        bash("jq '.phases.common_screens = {status: \"complete\", timestamp: \"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'\"}' " + session_dir + "/state.json > " + session_dir + "/state.json.tmp && mv " + session_dir + "/state.json.tmp " + session_dir + "/state.json") -> _update_state

        // ── Live tracking output ──────────────────────────────────────────
        bash("echo '--- PHASE 2B COMMON SCREENS COMPLETE ---' && jq . " + session_dir + "/state.json") -> phase_status
        print("PHASE STATUS:\n" + phase_status)

        // Summary
        bash("find " + session_dir + "/screens/shared/ -name '*.html'") -> screens_listing
        bash("cat " + session_dir + "/screens/shared/verification.json") -> verification
        ask("Summarize Phase 2B results. Session: " + session_dir + " Screens: " + screens_listing + " Verification: " + verification + " Format: ## PHASE 2B COMPLETE\n### Session Directory\n### Screens Generated\n### Verification Results\n### Ready for Phase 2C") -> summary

        print("PHASE 2B COMMON SCREENS COMPLETE\n\nSession: " + session_dir + "\n\n" + summary)
        return summary
    }
}
