// phases/feature-screens.ais — Phase 2C: FEATURE SCREENS
//
// Generates ALL role-specific screens x ALL state variants IN PARALLEL.
// Each screen uses data-component placeholders — never duplicates HTML.
// 2-stage verification: structural + visual review.
//
// File naming convention:
//   dashboard.html         ← default/populated state
//   dashboard-empty.html   ← zero data, onboarding tone
//   dashboard-triage.html  ← high-alert, overflow state
//
// Inputs: session_dir (reads from specs/ and components/, writes to screens/)
// Output: session_dir/screens/**/*.html + verification results
//
// Usage (called by create.ais):
//   Receives session_dir as parameter

agent FeatureScreensBuilder {
    @entry flow main() -> str {

        ask("Session directory path") -> session_dir

        // Read specs and components from session_dir
        bash("cat " + session_dir + "/specs/screen_manifest.json") -> screen_manifest
        bash("cat " + session_dir + "/specs/design_system.json") -> design_system
        bash("cat " + session_dir + "/specs/component_registry.json") -> component_registry
        bash("cat " + session_dir + "/specs/navigation_spec.json") -> nav_spec
        bash("ls " + session_dir + "/components/*.html") -> components_list

        spawn_agent("screen_writer",      "claude", "$APXM_HOME") -> _sw
        spawn_agent("structural_checker", "claude", "$APXM_HOME") -> _sc
        spawn_agent("visual_checker",     "claude", "$APXM_HOME") -> _vc

        // Generate all feature screens and write directly
        bash("mkdir -p " + session_dir + "/screens") -> _mkdir

        ask("Generate ALL feature screens from this manifest and write them directly to " + session_dir + "/screens/ using bash. Manifest: " + screen_manifest + " Components available: " + components_list + " Design system: " + design_system + " For each screen in manifest, generate ALL variants as separate HTML files. Each file shows web (1440px) + mobile (393px) side by side. Use data-component placeholders for reusable parts. Name files exactly as manifest specifies (dashboard.html, dashboard-triage.html, dashboard-empty.html). CSS vars only. Create subdirectories as needed. Write each file directly to " + session_dir + "/screens/{path}. Return list of files written.") -> gen_prompt
        communicate("screen_writer", "acp", gen_prompt) -> files_written

        // Stage 1: structural check (reads ALL HTML + JSON together)
        ask("Stage 1 structural verification. Read ALL HTML files in " + session_dir + "/screens/ and verify against artifacts. Components: " + component_registry + " Manifest: " + screen_manifest + " Nav spec: " + nav_spec + " Check: every data-component value exists in registry, every data-destination points to screen in manifest, required variants present, no hardcoded hex colors, no inline nav markup, cross-screen: same component used for same concept everywhere. Write verification results directly to " + session_dir + "/screens/verification_stage1.json using bash. Schema: {results: [{file, status: PASS|WARN|FAIL, issues[]}], cross_screen_issues[], summary: {pass, warn, fail}}. Return file path when done.") -> stage1_prompt
        communicate("structural_checker", "acp", stage1_prompt) -> stage1_written

        // Stage 2: Visual review
        bash("find " + session_dir + "/screens/ -name '*.html' -type f") -> screen_files_list
        ask("Stage 2 visual design review. Review HTML screens in " + session_dir + "/screens/ for visual design quality. Files: " + screen_files_list + " Evaluate per screen: visual hierarchy (most important info most prominent?), information density (right amount for viewport?), state feel (triage=urgent? empty=welcoming?). Cross-screen: consistent visual language? Same components look identical everywhere? Write verification results directly to " + session_dir + "/screens/verification_stage2.json using bash. Schema: {results: [{file, rating: PASS|WARN|CRITICAL, feedback}], cross_screen_consistency: PASS|WARN|CRITICAL, overall: PASS|WARN|CRITICAL}. Return file path when done.") -> stage2_prompt
        communicate("visual_checker", "acp", stage2_prompt) -> stage2_written

        // Update state.json
        bash("jq '.phases.feature_screens = {status: \"complete\", timestamp: \"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'\"}' " + session_dir + "/state.json > " + session_dir + "/state.json.tmp && mv " + session_dir + "/state.json.tmp " + session_dir + "/state.json") -> _update_state

        // ── Live tracking output ──────────────────────────────────────────
        bash("echo '--- PHASE 2C FEATURE SCREENS COMPLETE ---' && jq . " + session_dir + "/state.json") -> phase_status
        print("PHASE STATUS:\n" + phase_status)

        // Summary
        bash("find " + session_dir + "/screens/ -name '*.html' | wc -l") -> screen_count
        bash("cat " + session_dir + "/screens/verification_stage1.json") -> stage1_results
        bash("cat " + session_dir + "/screens/verification_stage2.json") -> stage2_results
        ask("Summarize Phase 2C results. Session: " + session_dir + " Screens generated: " + screen_count + " Stage 1: " + stage1_results + " Stage 2: " + stage2_results + " Format: ## PHASE 2C COMPLETE\n### Session Directory\n### Screens Generated (count)\n### Stage 1 Structural Results\n### Stage 2 Visual Results\n### Issues Requiring Fix\n### Ready for Phase 3") -> summary

        print("PHASE 2C FEATURE SCREENS COMPLETE\n\nSession: " + session_dir + "\n\n" + summary)
        return summary
    }
}
