// phases/discover.ais — Phase 1: DISCOVER
//
// 4 parallel specialist agents + architect + adversary → 6 JSON spec artifacts
// ALL outputs written to session_dir/specs/ using bash tool
//
// Inputs (parameters):
//   session_dir: session directory path (e.g. ~/.apxm-designer/sessions/marketplace-20260406-143022/)
//   brief:       plain-language app description
//   stack:       target framework (flutter/react/vue/swiftui)
//   backend:     backend language (go/node/python/rust)
//
// Outputs (written to session_dir/specs/):
//   entity_map.json       - all entities, states, relationships, edge cases
//   navigation_spec.json  - screen tree, nav pattern, hierarchy, deep links
//   competitor_analysis.json - top competitors, patterns, differentiation
//   design_system.json    - colors, typography, spacing, CSS vars
//   product_spec.json     - MVP scope, features, personas, success metrics
//   screen_manifest.json  - all screens x all variants to generate
//
// Usage (called by create.ais):
//   Receives session_dir + brief + stack + backend as prompts

agent Discoverer {
    @entry flow main() -> str {

        // Parameters from create.ais
        ask("Session directory path") -> session_dir
        ask("Brief describing the app to build") -> brief
        ask("flutter") -> stack
        ask("go") -> backend

        // ── 4 parallel specialists ────────────────────────────────────────
        spawn_agent("entity_analyst",     "claude", "$APXM_HOME") -> _ea
        spawn_agent("competitor_analyst", "claude", "$APXM_HOME") -> _ca
        spawn_agent("nav_analyst",        "claude", "$APXM_HOME") -> _na
        spawn_agent("design_analyst",     "claude", "$APXM_HOME") -> _da

        // Entity + State Machine Analyst
        ask("You are an Entity and State Machine Analyst. Extract all domain entities, state machines, use cases, edge cases. Brief: " + brief + " Write your output as valid JSON directly to: " + session_dir + "/specs/entity_map.json using bash. Schema: {entities[], user_roles[], entity_states{entity: [states]}, entity_transitions{entity: [{from, to, trigger}]}, use_cases[], edge_cases{entity_state: [scenarios]}}. Return the file path when done.") -> entity_prompt
        communicate("entity_analyst", "acp", entity_prompt) -> entity_written

        // Competitor + Market Analyst
        ask("You are a Competitor and Market Analyst. Research the app category. Brief: " + brief + " Write your output as valid JSON directly to: " + session_dir + "/specs/competitor_analysis.json using bash. Schema: {competitors[{name, strengths[], weaknesses[], design_patterns[]}], common_screen_patterns[], user_loves[], anti_patterns[], differentiation_opportunities[]}. Return the file path when done.") -> competitor_prompt
        communicate("competitor_analyst", "acp", competitor_prompt) -> competitor_written

        // IA + Navigation Analyst
        ask("You are an Information Architecture and Navigation Analyst. Design user navigation. Brief: " + brief + " Stack: " + stack + " Write your output as valid JSON directly to: " + session_dir + "/specs/navigation_spec.json using bash. Schema: {user_roles[{role, sections[], nav_pattern, tab_bar_items[]}], screen_tree{screen: {parent, children[], depth}}, overflow_rules{threshold, behavior}, deep_links[{path, screen}], interaction_model[{action_type, ui_pattern}]}. Return the file path when done.") -> nav_prompt
        communicate("nav_analyst", "acp", nav_prompt) -> nav_written

        // Design Style Analyst
        ask("You are a Design Style Analyst. Research visual identity. Brief: " + brief + " Write your output as valid JSON directly to: " + session_dir + "/specs/design_system.json using bash. Schema: {color_palette{primary, secondary, accent, surface, on_surface, semantic{success, warning, error, info}}, typography{heading{font, scale}, body{font, scale}, mono{font}}, spacing{base_px, scale_factor, tokens{xs,sm,md,lg,xl,2xl}}, radius{card, button, input, badge}, brand_personality[5 adjectives], reference_brands[3 apps]}. All colors as CSS vars like var(--color-primary). Return the file path when done.") -> design_prompt
        communicate("design_analyst", "acp", design_prompt) -> design_written

        // ── Architect + Adversary ─────────────────────────────────────────
        spawn_agent("architect", "claude", "$APXM_HOME") -> _arch
        spawn_agent("adversary", "claude", "$APXM_HOME") -> _adv

        // Read specs from session_dir
        bash("cat " + session_dir + "/specs/entity_map.json") -> entity_map
        bash("cat " + session_dir + "/specs/navigation_spec.json") -> navigation_spec
        bash("cat " + session_dir + "/specs/competitor_analysis.json") -> competitor_analysis
        bash("cat " + session_dir + "/specs/design_system.json") -> design_system

        // Architect writes product spec
        ask("You are the Lead Product Architect. Synthesize analyses into product spec. Entity map: " + entity_map + " Navigation: " + navigation_spec + " Competitors: " + competitor_analysis + " Design: " + design_system + " Brief: " + brief + " Write your output as valid JSON directly to: " + session_dir + "/specs/product_spec_draft.json using bash. Schema: {app_name, tagline, value_proposition, target_users[{role, persona, goals[], frustrations[]}], core_features[{name, priority, acceptance_criteria[]}], mvp_scope{features[], excluded[], timeline_weeks}, out_of_scope[], success_metrics[{name, target, how_measured}]}. Return the file path when done.") -> product_spec_prompt
        communicate("architect", "acp", product_spec_prompt) -> product_spec_written

        // Read product spec draft
        bash("cat " + session_dir + "/specs/product_spec_draft.json") -> product_spec_json

        // Adversary challenges
        ask("You are the Product Adversary. Challenge this spec. Find scope creep, missing critical features, wrong assumptions. Spec: " + product_spec_json + " Brief: " + brief + " Write your output as valid JSON directly to: " + session_dir + "/specs/adversary_challenge.json using bash. Schema: {scope_creep[{feature, issue, recommendation}], missing_critical[], wrong_assumptions[], simplification_wins[], verdict{decision: GO|PIVOT|NO_GO, reason, condition}}. Return the file path when done.") -> adversary_prompt
        communicate("adversary", "acp", adversary_prompt) -> adversary_written

        // Read adversary challenge
        bash("cat " + session_dir + "/specs/adversary_challenge.json") -> adversary_json

        // Architect responds and produces final artifacts
        ask("Respond to adversary and produce final artifacts. Product spec: " + product_spec_json + " Adversary: " + adversary_json + " Navigation: " + navigation_spec + " Entity map: " + entity_map + " For each challenge: ACCEPTED or REJECTED. Write two files using bash: 1) " + session_dir + "/specs/product_spec.json (final product spec incorporating accepted changes), 2) " + session_dir + "/specs/screen_manifest.json (for every screen, list all state variants). Screen manifest schema: {screens[{screen_id, capability, audience, generates[{file, variant, description, components_used[], design_notes}], overflow_policy{field: {show_max, triage_at, see_all_dest}}}]}. Return both file paths when done.") -> final_artifacts_prompt
        communicate("architect", "acp", final_artifacts_prompt) -> final_written

        // Update state.json
        bash("jq '.phases.discover = {status: \"complete\", timestamp: \"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'\"}' " + session_dir + "/state.json > " + session_dir + "/state.json.tmp && mv " + session_dir + "/state.json.tmp " + session_dir + "/state.json") -> _update_state

        // ── Live tracking output ──────────────────────────────────────────
        bash("echo '--- PHASE 1 DISCOVER COMPLETE ---' && jq . " + session_dir + "/state.json") -> phase_status
        print("PHASE STATUS:\n" + phase_status)

        // Summary
        bash("ls -lh " + session_dir + "/specs/") -> specs_listing
        ask("Summarize Phase 1 DISCOVER results. Session: " + session_dir + " Specs written: " + specs_listing + " Format: ## PHASE 1 COMPLETE\n### Session Directory\n### Entities Found\n### Screens to Generate\n### Design Direction\n### MVP Scope\n### Adversary Verdict\n### Ready for Phase 2A") -> summary

        print("PHASE 1 DISCOVER COMPLETE\n\nSession: " + session_dir + "\n\n" + summary)
        return summary
    }
}
