// phase1/discover.ais - apxm-designer Phase 1: DISCOVER
// 4 parallel specialists + architect + adversary -> 6 spec artifacts
// Usage: dekk apxm execute examples/workflows/designer/phase1/discover.ais

agent Discoverer {
    @entry flow main() -> str {
        spawn_agent("entity_analyst",     "claude", "$APXM_HOME") -> _ea
        spawn_agent("navigation_analyst", "claude", "$APXM_HOME") -> _na
        spawn_agent("competitor_analyst", "claude", "$APXM_HOME") -> _ca
        spawn_agent("style_analyst",      "claude", "$APXM_HOME") -> _sa

        communicate("entity_analyst", "acp", "You are an Entity and State Machine Analyst. Brief: vintage watch marketplace. Sellers list watches, buyers browse/filter/favorite/message, sellers have dashboards, buyers make offers sellers accept/reject/counter. Produce entity_map.json: entities[], user_roles[], entity_states with all states per entity, critical_flows[5]. Output ONLY valid JSON.") -> entity_map

        communicate("navigation_analyst", "acp", "You are an IA and Navigation Analyst. Brief: vintage watch marketplace. Produce navigation_spec.json: tab_bar per role, screen_tree with full hierarchy, all_states per screen (loaded/empty/loading/error plus domain states), total_html_files count, shared_screens. Output ONLY valid JSON.") -> navigation_spec

        communicate("competitor_analyst", "acp", "You are a Competitor Analyst. Brief: vintage watch marketplace. Analyze Chrono24, WatchBox, eBay watches, Crown+Caliber. Produce competitor_analysis.json: per-competitor strengths/weaknesses/design_patterns, differentiation_opportunities[5], design_inspiration[3]. Output ONLY valid JSON.") -> competitor_analysis

        communicate("style_analyst", "acp", "You are a Design System Analyst. Brief: vintage watch marketplace. Premium but accessible. Produce design_system.json: color_palette (primary/secondary/accent/semantic), typography (fonts + scale), spacing (4px system), component_patterns, brand_personality[5 adjectives]. Output ONLY valid JSON.") -> design_system

        spawn_agent("architect", "claude", "$APXM_HOME") -> _arch
        spawn_agent("adversary", "claude", "$APXM_HOME") -> _adv

        communicate("architect", "acp", "You are the Lead Product Architect. Synthesize 4 analyses into product_spec.json. Inputs: ENTITY=" + entity_map + " NAVIGATION=" + navigation_spec + " COMPETITORS=" + competitor_analysis + " DESIGN=" + design_system + " Produce: app_name, tagline, target_user_personas, core_features_ranked, mvp_scope (8 weeks), out_of_scope, success_metrics[5]. Output ONLY valid JSON.") -> product_spec

        communicate("adversary", "acp", "You are the Product Adversary. Challenge this spec: " + product_spec + " Identify: scope creep, missing user needs, wrong assumptions, one feature to cut. VERDICT: GO/PIVOT/NO-GO. Output JSON with challenges[] and verdict.") -> challenge

        communicate("architect", "acp", "Adversary challenged your spec: " + challenge + " Respond to each challenge: ACCEPTED or REJECTED with reason. Output updated product_spec.json only.") -> product_spec_final

        communicate("architect", "acp", "Based on navigation_spec: " + navigation_spec + " Produce screen_manifest.json: total_files count, phase_2a (components list), phase_2b (shared screens: profile/settings/messaging), phase_2c (role screens: seller dashboard/listing/messages, buyer browse/detail/favorites/offers), for each file: name, role, description, states[], components_needed[]. Output ONLY valid JSON.") -> screen_manifest

        ask("Summarize apxm-designer Phase 1 results. SPEC: " + product_spec_final + " MANIFEST: " + screen_manifest + " DESIGN: " + design_system + " Format: ## PHASE 1 COMPLETE, ### Product Spec (3 bullets), ### Screen Manifest (file count + breakdown by role), ### MVP Scope, ### Design System, ### Ready for Phase 2: HTML Generation") -> summary

        print("=== APXM-DESIGNER PHASE 1: DISCOVER COMPLETE ===\n\n" + summary)
        return summary
    }
}
