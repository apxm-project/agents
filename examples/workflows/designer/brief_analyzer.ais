// brief_analyzer.ais - apxm-designer v0.4
// Analyze a vintage watch marketplace brief -> structured design manifest
//
// Pipeline: 3 sequential analyst agents -> ASK synthesis -> manifest
//
// Usage: dekk apxm execute examples/workflows/designer/brief_analyzer.ais

agent BriefAnalyzer {
    @entry flow main() -> str {
        // Phase 1: Entity analysis
        spawn_agent("entity_analyst", "claude", "$APXM_HOME") -> _eh
        communicate("entity_analyst", "acp", "You are an Entity and State Machine Analyst for app design.\n\nApp brief: vintage watch marketplace. Sellers list watches with photos and descriptions. Buyers browse, filter by brand/price/condition, save favorites, and message sellers. Sellers have a dashboard showing listings, messages, and sales stats. Buyers can make offers which sellers accept, reject, or counter.\n\nOutput ONLY a JSON object (no markdown): {\"entities\":[...],\"user_roles\":[...],\"entity_states\":{\"EntityName\":[\"state1\"]},\"state_transitions\":[...]}") -> entity_json

        // Phase 2: Screen analysis
        spawn_agent("screen_analyst", "claude", "$APXM_HOME") -> _sh
        communicate("screen_analyst", "acp", "You are a Screen and Navigation Analyst for app design.\n\nYou have entity analysis data. Now produce a complete screen inventory for a vintage watch marketplace.\n\nOutput ONLY a JSON object: {\"screens\":{\"role/capability/screen\":[\"state1\",\"state2\"]},\"shared_screens\":[\"screens used by multiple roles\"],\"screen_count\":N}") -> screen_json

        // Phase 3: Component analysis
        spawn_agent("component_analyst", "claude", "$APXM_HOME") -> _ch
        communicate("component_analyst", "acp", "You are a Component and Design System Analyst for app design.\n\nYou have screen analysis data. Now produce a complete component inventory for a vintage watch marketplace.\n\nOutput ONLY a JSON object: {\"components\":[{\"name\":\"X\",\"variants\":[\"a\",\"b\"],\"states\":[\"normal\",\"hover\"]}],\"patterns\":[\"recurring UI patterns\"],\"component_count\":N}") -> component_json

        // Phase 4: Synthesize manifest
        ask("You are a design manifest synthesizer. Produce a structured design manifest for a vintage watch marketplace app.\n\nThe app has: sellers listing watches with photos, buyers browsing and filtering, messaging, offer negotiation, and seller dashboards.\n\nProduce ONLY this JSON structure (no markdown, no explanation):\n{\"summary\":\"one paragraph describing app scope\",\"stats\":{\"entities\":N,\"screens\":N,\"screen_states\":N,\"components\":N,\"estimated_html_files\":N},\"critical_screens\":[\"top 5 most complex screens\"],\"verification_checklist\":[\"empty states for all lists\",\"loading states for async ops\",\"error screens for all error paths\",\"every entity state has a screen state\"],\"risks\":[\"scope creep risks\"],\"go_signal\":\"GO\"}") -> manifest

        print("=== APXM-DESIGNER v0.4 MANIFEST ===\n\n" + manifest)
        return manifest
    }
}
