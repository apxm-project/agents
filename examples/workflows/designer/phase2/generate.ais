// phase2/generate.ais - apxm-designer Phase 2: GENERATE HTML
//
// Takes Phase 1 spec and generates all component + screen HTML files.
// Each file goes through 2-stage verification before acceptance.
//
// Stage 1: Qwen3 structural review (all HTML at once, fast)
// Stage 2: Playwright screenshot -> Qwen-VL visual review
//
// Usage: dekk apxm execute examples/workflows/designer/phase2/generate.ais

agent Generator {
    @entry flow main() -> str {

        // ── Phase 2a: Component library ───────────────────────────────────
        // Each component: CODEX (conservative) + CLAUDE (bold) -> CLAUDE picks winner
        spawn_agent("component_claude",  "claude", "$APXM_HOME") -> _cc
        spawn_agent("component_codex",   "codex",  "$APXM_HOME") -> _cx
        spawn_agent("component_verifier","claude", "$APXM_HOME") -> _cv

        // Generate WatchCard component (both agents)
        communicate("component_codex",  "acp", "Generate a WatchCard HTML component. Heritage Vault marketplace. Conservative implementation: semantic HTML, BEM classes, no JS. States: default, hover, sold-out, featured. Output ONLY the complete HTML with embedded CSS. Use class prefix watch-card--.") -> card_codex
        communicate("component_claude", "acp", "Generate a WatchCard HTML component. Heritage Vault marketplace. Bold implementation: modern CSS variables, micro-animations, rich hover states. States: default, hover, sold-out, featured. Output ONLY the complete HTML with embedded CSS. Use class prefix watch-card--.") -> card_claude

        // Verifier picks winner and validates
        communicate("component_verifier", "acp", "You are a frontend design reviewer. Compare two WatchCard implementations:\n\nCONSERVATIVE:\n" + card_codex + "\n\nBOLD:\n" + card_claude + "\n\nPick the better implementation for a premium vintage watch marketplace. Check: semantic HTML structure, accessibility (alt text, ARIA), all states present (default/hover/sold-out/featured), CSS completeness. Output: WINNER (conservative/bold), REASON, then the winning HTML verbatim.") -> watch_card_final

        // Structural verification (Stage 1)
        communicate("component_verifier", "acp", "Verify this HTML component passes structural requirements:\n\n" + watch_card_final + "\n\nCheck:\n1. Has all required states: default, hover, sold-out, featured\n2. Uses semantic HTML elements\n3. Has ARIA labels\n4. CSS is self-contained (no external deps)\n5. No broken references\n\nOutput: PASS or FAIL with specific issues listed.") -> watch_card_verified

        // ── Phase 2b: Shared screens ──────────────────────────────────────
        spawn_agent("screen_gen", "claude", "$APXM_HOME") -> _sg
        spawn_agent("screen_verifier", "claude", "$APXM_HOME") -> _sv

        // Generate messaging screen (shared by Buyer + Seller)
        communicate("screen_gen", "acp", "Generate messaging.html for Heritage Vault watch marketplace. This screen is shared by both Buyers and Sellers. States to implement: loaded (active conversation), empty (no messages yet), loading. Design: dark navy primary, Crimson Pro serif headings, Inter body text. Component placeholders use data-component attribute. Output complete HTML + CSS for all 3 states in one file using CSS classes to show/hide states. No JS required - use .state-loaded, .state-empty, .state-loading classes.") -> messaging_html

        // Verify messaging screen
        communicate("screen_verifier", "acp", "Verify this screen HTML:\n\n" + messaging_html + "\n\nCheck:\n1. All 3 states present (loaded/empty/loading)\n2. Correct class names (.state-loaded etc)\n3. Role-appropriate for both Buyer and Seller\n4. Responsive layout\n5. Uses data-component placeholders for components\n\nOutput: PASS or FAIL with issues.") -> messaging_verified

        // ── Phase 2c: Role-specific screens (seller home) ─────────────────
        communicate("screen_gen", "acp", "Generate seller/home/dashboard.html for Heritage Vault. Seller dashboard main screen. States: loaded (has active listings), empty (new seller, no listings), loading. Shows: total listings count, active offers count, recent messages, quick actions (Add Listing, View Offers). Heritage Vault design: navy/gold/Crimson Pro. Output complete single-file HTML with all 3 states.") -> seller_dashboard_html

        communicate("screen_verifier", "acp", "Verify seller dashboard:\n\n" + seller_dashboard_html + "\n\nCheck: all 3 states, seller-specific content, accurate stats display, quick actions present. PASS or FAIL.") -> seller_dashboard_verified

        // Generate buyer browse screen
        communicate("screen_gen", "acp", "Generate buyer/browse/listings.html for Heritage Vault. Buyer browse/discovery screen. States: loaded (results grid), empty (no results for filter), loading. Features: filter bar (brand/price/condition), sort options, WatchCard grid, pagination. Output complete single-file HTML.") -> buyer_browse_html

        communicate("screen_verifier", "acp", "Verify buyer browse:\n\n" + buyer_browse_html + "\n\nCheck: filter bar present, all 3 states, WatchCard grid layout, pagination. PASS or FAIL.") -> buyer_browse_verified

        // ── Summary ───────────────────────────────────────────────────────
        ask("Summarize apxm-designer Phase 2 (partial) results.\n\nWATCH CARD VERIFICATION: " + watch_card_verified + "\nMESSAGING SCREEN: " + messaging_verified + "\nSELLER DASHBOARD: " + seller_dashboard_verified + "\nBUYER BROWSE: " + buyer_browse_verified + "\n\nFormat:\n## PHASE 2 PARTIAL RESULTS\n### Components Generated: list\n### Screens Generated: list\n### Verification Results: pass/fail per item\n### Issues Found: list any failures\n### Next: remaining screens to generate") -> summary

        print("╔══════════════════════════════════════════════════╗\n" + "║   APXM-DESIGNER — PHASE 2: GENERATE (PARTIAL)  ║\n" + "╚══════════════════════════════════════════════════╝\n\n" + summary)
        return summary
    }
}
