{
  "name": "agent_council",
  "description": "Fan a task out to independent planner, executor, and reviewer workers, then synthesize their outputs.",
  "parameters": [
    {
      "name": "task",
      "type_name": "str"
    }
  ],
  "graphs": [
    {
      "id": "planner",
      "path": "planner.air",
      "params": {
        "task": "{{task}}"
      }
    },
    {
      "id": "executor",
      "path": "executor.air",
      "params": {
        "task": "{{task}}"
      }
    },
    {
      "id": "reviewer",
      "path": "reviewer.air",
      "params": {
        "task": "{{task}}"
      }
    },
    {
      "id": "synthesizer",
      "path": "synthesizer.air",
      "depends_on": ["planner", "executor", "reviewer"],
      "params": {
        "summary": "planner={{planner.output}} | executor={{executor.output}} | reviewer={{reviewer.output}}"
      }
    }
  ],
  "output": "task={{task}} | planner={{planner.output}} | executor:{{executor.output}} | reviewer:{{reviewer.output}} | synthesis={{synthesizer.output}}"
}
