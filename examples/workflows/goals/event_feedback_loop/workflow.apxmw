{
  "name": "event_feedback_loop",
  "description": "One deterministic pass through event, trigger, action, eval, and feedback orchestration.",
  "parameters": [
    {
      "name": "event",
      "type_name": "str"
    }
  ],
  "graphs": [
    {
      "id": "event",
      "path": "event.air",
      "params": {
        "event": "{{event}}"
      }
    },
    {
      "id": "trigger",
      "path": "trigger.air",
      "depends_on": ["event"],
      "params": {
        "event": "{{event.output}}"
      }
    },
    {
      "id": "action_write",
      "path": "action_write.air",
      "depends_on": ["trigger"],
      "params": {
        "trigger": "{{trigger.output}}"
      }
    },
    {
      "id": "action_verify",
      "path": "action_verify.air",
      "depends_on": ["trigger"],
      "params": {
        "trigger": "{{trigger.output}}"
      }
    },
    {
      "id": "eval",
      "path": "eval.air",
      "depends_on": ["action_write", "action_verify"],
      "params": {
        "actions": "{{action_write.output}} | {{action_verify.output}}"
      }
    },
    {
      "id": "feedback",
      "path": "feedback.air",
      "depends_on": ["eval"],
      "params": {
        "eval": "{{eval.output}}"
      }
    }
  ],
  "output": "event={{event.output}} | trigger={{trigger.output}} | action.write:{{action_write.output}} | action.verify:{{action_verify.output}} | eval={{eval.output}} | feedback={{feedback.output}}"
}
