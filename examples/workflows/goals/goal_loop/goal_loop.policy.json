{
  "name": "goal-loop-default",
  "description": "Default bounded policy for an APXM-owned goal loop.",
  "max_iterations": 5,
  "timeout_ms": 900000,
  "max_usd": 2.0,
  "requires_approval": false,
  "idempotency": {
    "dedupe_window_ms": 86400000,
    "key_fields": ["source", "kind", "subject", "payload.goal"]
  },
  "interrupt_policy": {
    "on_cancel": "cancel_run",
    "on_timeout": "cancel_run",
    "on_duplicate": "suppress",
    "on_worker_failure": "checkpoint",
    "on_eval_failed": "checkpoint",
    "on_checkpoint": "pause_until_resume"
  },
  "allowed_feedback": ["pass", "needs_more", "blocked", "unsafe"],
  "next_pass": {
    "allowed_when": "needs_more",
    "requires_policy_recheck": true,
    "requires_worker_readmission": true
  }
}
