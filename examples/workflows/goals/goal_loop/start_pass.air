module {
  func.func @start_pass(%arg0: !ais.token {ais.param_name = "pass_request", ais.param_type = "str"}) -> !ais.token attributes {ais.entry} {
    %label = ais.const_str "start.pass: call goal_start once, store execution_id, then sleep until workflow events/status/cancel wake:" : !ais.token
    %out = ais.merge %label, %arg0 : !ais.token, !ais.token -> !ais.token
    func.return %out : !ais.token
  }
}
