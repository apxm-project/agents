{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APXM bounded goal pass request",
  "type": "object",
  "additionalProperties": false,
  "required": ["task"],
  "properties": {
    "task": {
      "type": "string",
      "description": "Concrete task for one bounded goal pass."
    },
    "context": {
      "type": "string",
      "description": "Repository, product, or run context passed to workers."
    },
    "event": {
      "type": "string",
      "description": "Event or provenance that triggered this pass."
    },
    "trigger": {
      "type": "string",
      "description": "Trigger rule or reason for this pass."
    },
    "workers": {
      "type": "array",
      "description": "Optional explicit bounded worker workflow. When omitted, goal_start auto-plans the worker workflow for this pass.",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "prompt": { "type": "string" },
          "profile": { "type": "string" },
          "transport": {
            "type": "string",
            "enum": ["deterministic", "acp"]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mode": { "type": "string" },
          "model": { "type": "string" },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["read", "write", "execute", "critique", "workflow_author"]
            }
          },
          "preferred_profiles": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "model", "static"]
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "model": { "type": "string" },
        "backend": { "type": "string" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "string",
          "enum": ["auto"]
        },
        "require_agents": { "type": "boolean" }
      }
    },
    "supervisor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "profile": { "type": "string" },
        "transport": {
          "type": "string",
          "enum": ["deterministic", "acp"]
        },
        "mode": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["session", "shared", "git_worktree"]
        },
        "repo_root": { "type": "string" },
        "base_ref": { "type": "string" },
        "cleanup": {
          "type": "string",
          "enum": ["keep"]
        }
      }
    },
    "session_id": { "type": "string" },
    "admit_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "imports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1
    },
    "dry_run": { "type": "boolean" }
  }
}
