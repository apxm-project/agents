{
  "name": "goal_loop",
  "description": "Deterministic APXM goal-loop envelope: event -> trigger -> bounded pass request -> start pass -> eval -> feedback.",
  "parameters": [
    {
      "name": "goal",
      "type_name": "str"
    },
    {
      "name": "event",
      "type_name": "str"
    },
    {
      "name": "policy",
      "type_name": "str"
    }
  ],
  "steps": [
    {
      "id": "event",
      "path": "event.air",
      "params": {
        "goal": "{{goal}}",
        "event": "{{event}}"
      }
    },
    {
      "id": "trigger",
      "path": "trigger.air",
      "depends_on": ["event"],
      "params": {
        "event": "{{event.output}}",
        "policy": "{{policy}}"
      }
    },
    {
      "id": "plan_pass",
      "path": "plan_pass.air",
      "depends_on": ["trigger"],
      "params": {
        "goal": "{{goal}}",
        "trigger": "{{trigger.output}}"
      }
    },
    {
      "id": "start_pass",
      "path": "start_pass.air",
      "depends_on": ["plan_pass"],
      "params": {
        "pass_request": "{{plan_pass.output}}"
      }
    },
    {
      "id": "eval",
      "path": "eval.air",
      "depends_on": ["start_pass"],
      "params": {
        "pass_result": "{{start_pass.output}}"
      }
    },
    {
      "id": "feedback",
      "path": "feedback.air",
      "depends_on": ["eval"],
      "params": {
        "eval": "{{eval.output}}"
      }
    }
  ],
  "output": "goal={{goal}} | event={{event.output}} | trigger={{trigger.output}} | pass_request={{plan_pass.output}} | start={{start_pass.output}} | eval={{eval.output}} | feedback={{feedback.output}}"
}
