// adversary.ais
// Adversarial reviewer: finds what will go wrong, what's over-engineered.
//
// Usage: dekk apxm execute examples/workflows/sub/adversary.ais -- "your task"

agent Adversary {
    @entry flow main(TASK: str) -> str {
        reason("ultrathink. You are an adversarial reviewer. Your job is to find what will go wrong and what is over-engineered. For this task:\n- What already exists that should NOT be re-implemented?\n- What is the minimal viable change vs over-engineering?\n- Top 3 failure modes?\n- What should NOT be built in v1?\n- The ONE thing that breaks everything if done wrong?\n\nBe brutal. Adversary wins on scope disputes. Task: {{TASK}}") -> adversary_reason
        return adversary_reason
    }
}
