// synthesize.ais - converted from synthesize.apxm
//
// Usage: dekk apxm execute examples/workflows/sub/synthesize.apxm

agent Synthesize {
    @entry flow main() -> str {
        think("You are a synthesis expert. Given these three perspectives:\n\nARCHITECTURE:\n{{ARCH}}\n\nRISKS & CONCERNS:\n{{ADVER}}\n\nIMPLEMENTATION:\n{{IMPL}}\n\nSynthesize these into a comprehensive plan that:\n1. Incorporates the best architectural ideas\n2. Addresses the identified risks\n3. Provides clear implementation guidance\n\nProvide a unified, actionable plan.") -> synthesize_think
        return synthesize_think
    }
}
