    },
    {
      "id": 9,
      "name": "send_to_strategist",
      "op": "COMMUNICATE",
      "attributes": {"recipient": "strategist", "protocol": "acp"}
    },
    {
      "id": 10,
      "name": "send_to_skeptic",
