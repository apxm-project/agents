    },
    {
      "id": 12,
      "name": "send_to_marketeer",
      "op": "COMMUNICATE",
      "attributes": {"recipient": "marketeer", "protocol": "acp"}
    },
    {
      "id": 13,
      "name": "merge_analyses",
      "op": "MERGE",
      "attributes": {
        "tokens": ["{{node_9}}", "{{node_10}}", "{{node_11}}", "{{node_12}}"],
        "separator": "\n\n═══════════════════════════════════════════════════════════════\n\n"
      }
    },
    {
      "id": 14,
      "name": "spawn_council",
      "op": "SPAWN_AGENT",
      "attributes": {"agent_name": "council", "profile": "claude", "mode": "architect"}
    },
    {
      "id": 15,
      "name": "council_synthesis_prompt",
      "op": "THINK",
      "attributes": {
        "template_str": "COUNCIL SYNTHESIS:\n\nYou are the COUNCIL CHAIR. Synthesize the 4 analyst perspectives:\n\n{0}\n\n1. Where do they AGREE?\n2. Where do they DISAGREE?\n3. What TENSIONS exist?\n4. What KEY DECISIONS must be made?\n5. COUNCIL RECOMMENDATION?",
        "budget": 3000
      }
    },
    {
      "id": 16,
      "name": "send_synthesis_to_council",
      "op": "COMMUNICATE",
      "attributes": {"recipient": "council", "protocol": "acp"}
    },
    {
      "id": 17,
      "name": "adversarial_prompt",
      "op": "CONST_STR",
      "attributes": {"value": "Now apply ADVERSARIAL pressure. What would KILL this plan? What assumption, if wrong, invalidates everything? What competitor response would be fatal?"}
    },
    {
      "id": 18,
      "name": "send_adversarial_to_council",
      "op": "COMMUNICATE",
      "attributes": {"recipient": "council", "protocol": "acp"}
    },
    {
      "id": 19,
      "name": "spawn_chair",
      "op": "SPAWN_AGENT",
      "attributes": {"agent_name": "chair", "profile": "claude", "mode": "architect"}
    },
    {
      "id": 20,
      "name": "merge_for_chair",
      "op": "MERGE",
      "attributes": {
        "tokens": ["{{node_13}}", "{{node_16}}", "{{node_18}}"],
        "separator": "\n\n═══════════════════════════════════════════════════════════════\n\n"
      }
    },
    {
      "id": 21,
      "name": "chair_decision_prompt",
      "op": "THINK",
      "attributes": {
        "template_str": "CHAIR DECISION:\n\nYou have FRESH EYES. Package:\n{0}\n\n## DECISION: GO / NO-GO / PIVOT\n\n## 3 CONCRETE NEXT STEPS\n\n## THE ONE THING",
        "budget": 3000
      }
    },
    {
      "id": 22,
      "name": "send_to_chair",
      "op": "COMMUNICATE",
      "attributes": {"recipient": "chair", "protocol": "acp"}
    },
    {
      "id": 23,
      "name": "final_output",
      "op": "PRINT",
      "attributes": {"message": "═══════════════════════════════════════════════════════════════\n                    APXM PLANNER: FINAL DECISION\n═══════════════════════════════════════════════════════════════\n\n{{node_22}}"}
    }
  ],
