// apxm_planner.ais - Strategic planning council
// 4 parallel analysts -> council + adversarial -> chair decision
//
// Usage: dekk apxm execute examples/workflows/planner/apxm_planner.ais

agent Planner {
    @entry flow main() -> str {
        // Spawn all agents first (compiler requirement)
        spawn_agent("strategist",   "claude", "$APXM_HOME") -> _s
        spawn_agent("skeptic",      "claude", "$APXM_HOME") -> _sk
        spawn_agent("technologist", "claude", "$APXM_HOME") -> _t
        spawn_agent("marketeer",    "claude", "$APXM_HOME") -> _m
        spawn_agent("council",      "claude", "$APXM_HOME") -> _council
        spawn_agent("chair",        "claude", "$APXM_HOME") -> _chair

        // Get the plan name interactively
        ask("What strategic plan or product idea should the council analyze? Be specific.") -> plan_name

        // 4 parallel analyst streams
        communicate("strategist",   "acp", "STRATEGIST analyzing: " + plan_name + ". Cover WHY NOW, THE GAP, THE MOAT, THE WEDGE, LONG-TERM. 400-600 words with headers.") -> s_out
        communicate("skeptic",      "acp", "SKEPTIC analyzing: " + plan_name + ". Find HARDEST PART, MISSING PIECES, SCOPE TRAP, FATAL RISK, HONEST TIMELINE. 400-600 words.") -> sk_out
        communicate("technologist", "acp", "TECHNOLOGIST analyzing: " + plan_name + ". Assess APXM FIT, EXTERNAL DEPS, BUILD ORDER, INCREMENTAL v0.1, GAPS. 400-600 words.") -> t_out
        communicate("marketeer",    "acp", "MARKETEER analyzing: " + plan_name + ". Find THE BUYER, THE PAIN, THE SWITCH, FIRST 10 CUSTOMERS, PRICING MODEL. 400-600 words.") -> m_out

        // Synthesize all 4 analyst reports
        think("EXPERT COUNCIL CHAIR. Synthesize 4 analyst reports:\n\nSTRATEGIST:\n" + s_out + "\n\nSKEPTIC:\n" + sk_out + "\n\nTECHNOLOGIST:\n" + t_out + "\n\nMARKETEER:\n" + m_out + "\n\nStructure:\n## CONVERGENCE\n## DIVERGENCE\n## TENSIONS\n## KEY DECISIONS\n## COUNCIL VERDICT") -> council_prompt

        communicate("council", "acp", council_prompt) -> council_out
        communicate("council", "acp", "Stress-test: 1) What single assumption, if wrong, kills everything? 2) What could a large tech co ship in 6 months that makes this irrelevant? 3) Final verdict?") -> adversarial_out

        // Chair makes the final call
        think("CHAIR with fresh eyes. Full package:\n\nSTRATEGIST:\n" + s_out + "\n\nSKEPTIC:\n" + sk_out + "\n\nCOUNCIL:\n" + council_out + "\n\nADVERSARIAL:\n" + adversarial_out + "\n\nDecide:\n## DECISION (GO/NO-GO/PIVOT)\n## THE WEDGE\n## 3 NEXT STEPS\n## THE ONE THING") -> chair_prompt

        communicate("chair", "acp", chair_prompt) -> decision

        print("=== APXM PLANNER DECISION: " + plan_name + " ===\n\n" + decision)
        return decision
    }
}
