// apxm_planner.ais - Strategic planning council
// 4 parallel analysts -> council + adversarial -> chair decision
//
// Usage: apxm execute examples/workflows/planner/apxm_planner.ais "plan name"

agent Planner {
    @entry flow main(plan_name: str) -> str {
        spawn_agent("strategist",   "claude", "$APXM_HOME") -> _s
        spawn_agent("skeptic",      "claude", "$APXM_HOME") -> _sk
        spawn_agent("technologist", "claude", "$APXM_HOME") -> _t
        spawn_agent("marketeer",    "claude", "$APXM_HOME") -> _m

        communicate("strategist",   "acp", "STRATEGIST analyzing: " + plan_name + ". Cover WHY NOW, THE GAP, THE MOAT, THE WEDGE, LONG-TERM. 400-600 words with headers.") -> s_out
        communicate("skeptic",      "acp", "SKEPTIC analyzing: " + plan_name + ". Find HARDEST PART, MISSING PIECES, SCOPE TRAP, FATAL RISK, HONEST TIMELINE. 400-600 words.") -> sk_out
        communicate("technologist", "acp", "TECHNOLOGIST analyzing: " + plan_name + ". Assess APXM FIT, EXTERNAL DEPS, BUILD ORDER, INCREMENTAL v0.1, GAPS. 400-600 words.") -> t_out
        communicate("marketeer",    "acp", "MARKETEER analyzing: " + plan_name + ". Find THE BUYER, THE PAIN, THE SWITCH, FIRST 10 CUSTOMERS, PRICING MODEL. 400-600 words.") -> m_out

        merge(s_out, sk_out, t_out, m_out) -> all_analyses

        spawn_agent("council", "claude", "$APXM_HOME") -> _council
        think("EXPERT COUNCIL CHAIR. Synthesize 4 analyst reports:\n\n" + all_analyses + "\n\nStructure:\n## CONVERGENCE (where all analysts agree)\n## DIVERGENCE (contradictions)\n## TENSIONS (unavoidable trade-offs)\n## KEY DECISIONS (3-5 that determine success)\n## COUNCIL VERDICT (STRONG-GO/GO-WITH-CONDITIONS/PIVOT/NO-GO)") -> council_prompt
        communicate("council", "acp", council_prompt) -> council_out
        communicate("council", "acp", "Stress-test: 1) What single assumption, if wrong, kills everything? 2) What could Google/Figma/Replit ship in 6 months that makes this irrelevant? 3) What technical dependency could fail? 4) Final verdict?") -> adversarial_out

        spawn_agent("chair", "claude", "$APXM_HOME") -> _chair
        think("CHAIR with fresh eyes. Full package:\n\n" + all_analyses + "\n\n---COUNCIL---\n\n" + council_out + "\n\n---ADVERSARIAL---\n\n" + adversarial_out + "\n\nDecide:\n## DECISION (GO/NO-GO/PIVOT - 2-3 sentence justification)\n## THE WEDGE (smallest thing buildable in 4 weeks that proves core value)\n## 3 CONCRETE NEXT STEPS\n## THE ONE THING") -> chair_prompt
        communicate("chair", "acp", chair_prompt) -> decision

        print("\n=== APXM PLANNER DECISION: " + plan_name + " ===\n\n" + decision)
        return decision
    }
}
