module {
  func.func @fusion_stress() -> !ais.token attributes {ais.entry} {
    %p1 = ais.ask "What is the capital of France? One word." : !ais.token
    %c1 = ais.ask "{prev}\n\nName one famous landmark in that city. Answer in 3 words." [%p1 : !ais.token] {input_names = ["prev"]} : !ais.token
    %p2 = ais.ask "What is the capital of Italy? One word." : !ais.token
    %c2 = ais.ask "{prev}\n\nName one famous landmark in that city. Answer in 3 words." [%p2 : !ais.token] {input_names = ["prev"]} : !ais.token
    %p3 = ais.ask "What is the capital of Germany? One word." : !ais.token
    %c3 = ais.ask "{prev}\n\nName one famous landmark in that city. Answer in 3 words." [%p3 : !ais.token] {input_names = ["prev"]} : !ais.token
    %merged = ais.merge %c1, %c2, %c3 : !ais.token, !ais.token, !ais.token -> !ais.token
    ais.print "=== FUSION STRESS RESULT ===\n\nFrance: {france}\nItaly: {italy}\nGermany: {germany}" [%c1, %c2, %c3 : !ais.token, !ais.token, !ais.token] {input_names = ["france", "italy", "germany"]}
    func.return %merged : !ais.token
  }
}
