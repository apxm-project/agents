module {
  func.func @priority_scheduling() -> !ais.token attributes {ais.entry} {
    %critical_ask = ais.ask "Design a REST API for a simple TODO list application. What are the core endpoints? Provide 3-4 sentences." : !ais.token
    %critical_think = ais.think "{critical_ask}\n\nBased on this API design, what are the key data models needed? Describe the schema in 3-4 sentences." [%critical_ask : !ais.token] : !ais.token
    %critical_reason = ais.reason "{critical_think}\n\nGiven these data models, what are the main scalability challenges? Propose a solution in 3-4 sentences." [%critical_think : !ais.token] : !ais.token
    %critical_final = ais.think "{critical_reason}\n\nSummarize the complete design (API + data model + scalability) in 4-5 sentences." [%critical_reason : !ais.token] : !ais.token
    %bg_naming_analysis = ais.think "Analyze common REST API naming conventions for TODO applications. What are the best practices? Provide 4-5 examples." : !ais.token
    %bg_auth_research = ais.think "Research authentication patterns for TODO applications. Compare JWT vs session-based auth. Which is better and why? Provide 4-5 sentences." : !ais.token
    %bg_database_analysis = ais.think "Compare PostgreSQL vs MongoDB for a TODO list application. What are the tradeoffs? Which would you choose and why? Provide 4-5 sentences." : !ais.token
    %bg_caching_research = ais.think "Research caching strategies for TODO list APIs. Where should caching be applied? What are the tradeoffs? Provide 4-5 sentences." : !ais.token
    %bg_monitoring_analysis = ais.think "Analyze monitoring approaches for TODO list applications. What metrics should be tracked? What tools are commonly used? Provide 4-5 sentences." : !ais.token
    %bg_report = ais.merge %bg_naming_analysis, %bg_auth_research, %bg_database_analysis, %bg_caching_research, %bg_monitoring_analysis : !ais.token, !ais.token, !ais.token, !ais.token, !ais.token -> !ais.token
    ais.print "=== USER-VISIBLE OUTPUT (Critical Path) ===\n\n{critical_final}\n\nThis is the CRITICAL PATH result that the user sees.\nWith priority scheduling, this should complete FIRST,\neven if background tasks are still running." [%critical_final : !ais.token]
    ais.print "=== BACKGROUND ANALYTICS (Low Priority) ===\n\nNaming conventions: {bg_task_1}\n\nAuthentication: {bg_task_2}\n\nDatabase choice: {bg_task_3}\n\nCaching strategy: {bg_task_4}\n\nMonitoring: {bg_task_5}\n\nThis background work completed after the critical path." [%bg_naming_analysis, %bg_auth_research, %bg_database_analysis, %bg_caching_research, %bg_monitoring_analysis : !ais.token, !ais.token, !ais.token, !ais.token, !ais.token]
    %all_done = ais.wait_all %critical_final, %bg_naming_analysis : !ais.token, !ais.token -> !ais.token
    ais.print "=== PRIORITY SCHEDULING STRESS TEST ===\n\nCritical path (ask→think→reason→final): COMPLETED\nBackground tasks (5 parallel speculative nodes): COMPLETED\n\nO0: all nodes scheduled without priority hints\nO2: critical path receives priority hints\n\nMetric: compare critical-path completion time under measured contention."
    func.return %all_done : !ais.token
  }
}
