module {
  func.func @condense_ops_stress() -> !ais.token attributes {ais.entry} {
    %a = ais.qmem "find facts about user" stage "belief_db" in ltm : !ais.handle<ltm>
    %b = ais.qmem "find facts about session" stage "belief_db" in ltm : !ais.handle<ltm>
    %c = ais.qmem "find facts about goals" stage "belief_db" in ltm : !ais.handle<ltm>
    %d = ais.qmem "find facts about constraints" stage "belief_db" in ltm : !ais.handle<ltm>
    %report = ais.ask "Summarize what we know so far." : !ais.token
    func.return %report : !ais.token
  }
}
