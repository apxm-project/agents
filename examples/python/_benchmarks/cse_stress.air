module {
  func.func @cse_stress() -> !ais.token attributes {ais.entry} {
    %analysis_security = ais.ask "Analyze microservices architecture patterns from a SECURITY perspective. What are the key security considerations? Provide 3-4 sentences." : !ais.token
    %analysis_performance = ais.ask "Analyze microservices architecture patterns from a SECURITY perspective. What are the key security considerations? Provide 3-4 sentences." : !ais.token
    %analysis_scalability = ais.ask "Analyze microservices architecture patterns from a SECURITY perspective. What are the key security considerations? Provide 3-4 sentences." : !ais.token
    %extract_bullets = ais.think "{analysis_1}\n\nConvert this analysis into 3 bullet points." [%analysis_security : !ais.token] : !ais.token
    %create_summary = ais.think "{analysis_2}\n\nSummarize this analysis in one sentence." [%analysis_performance : !ais.token] : !ais.token
    %identify_actions = ais.think "{analysis_3}\n\nBased on this analysis, list 2 recommended action items." [%analysis_scalability : !ais.token] : !ais.token
    %final_report = ais.merge %extract_bullets, %create_summary, %identify_actions : !ais.token, !ais.token, !ais.token -> !ais.token
    ais.print "=== CSE STRESS TEST RESULT ===\n\nBullet Points:\n{bullets}\n\nSummary:\n{summary}\n\nAction Items:\n{actions}\n\nThis workflow executed the SAME prompt 3 times in parallel.\nO0: 3 separate LLM calls (no deduplication)\nO2 with CSE: 1 LLM call, result reused 3 times" [%extract_bullets, %create_summary, %identify_actions : !ais.token, !ais.token, !ais.token]
    func.return %extract_bullets : !ais.token
  }
}
