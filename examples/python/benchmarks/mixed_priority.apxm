{
  "name": "mixed_priority",
  "nodes": [
    {
      "id": 1,
      "name": "user_query",
      "op": "CONST_STR",
      "attributes": {
        "value": "What are the top 3 programming languages for web development in 2026?"
      }
    },
    {
      "id": 2,
      "name": "quick_answer",
      "op": "ASK",
      "attributes": {
        "template_str": "Provide a concise answer to this question:\n{0}\n\nAnswer in 2-3 sentences, prioritize speed."
      }
    },
    {
      "id": 3,
      "name": "final_answer",
      "op": "THINK",
      "attributes": {
        "template_str": "Given this quick answer:\n{0}\n\nRefine it to be more precise and add brief justification.\nKeep it under 5 sentences."
      }
    },
    {
      "id": 4,
      "name": "deep_analysis",
      "op": "REASON",
      "attributes": {
        "template_str": "Original query: {0}\n\nProvide a comprehensive analysis covering:\n- Language ecosystem maturity\n- Job market trends\n- Performance characteristics\n- Developer experience\nThis is background analysis, not time-critical."
      }
    },
    {
      "id": 5,
      "name": "comparison",
      "op": "THINK",
      "attributes": {
        "template_str": "Original query: {0}\n\nCreate a detailed comparison table of the top languages.\nInclude: performance, learning curve, community size, ecosystem.\nThis is background analysis, not time-critical."
      }
    },
    {
      "id": 6,
      "name": "future_trends",
      "op": "THINK",
      "attributes": {
        "template_str": "Original query: {0}\n\nPredict language trends for the next 5 years.\nWhat new languages might emerge? What might decline?\nThis is background analysis, not time-critical."
      }
    },
    {
      "id": 7,
      "name": "complete_response",
