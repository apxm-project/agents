{
  "name": "chained_llm",
  "nodes": [
    {
      "id": 1,
      "name": "initial_response",
      "op": "ASK",
      "attributes": {
        "template_str": "You are an AI assistant helping with software architecture.\n\nQuestion: Design a URL shortening service similar to bit.ly. What are the key components and how should they interact?\n\nProvide a high-level architectural overview in 4-5 sentences."
      }
    },
    {
      "id": 2,
      "name": "analysis",
      "op": "THINK",
      "attributes": {
        "template_str": "Given this architectural overview:\n{0}\n\nAnalyze the design in detail:\n1. What are the scalability challenges?\n2. How should data be partitioned?\n3. What caching strategies are needed?\n4. How to handle conflicts in short URL generation?\n\nProvide a detailed technical analysis covering these points."
      }
    },
    {
      "id": 3,
      "name": "final_design",
      "op": "REASON",
      "attributes": {
        "template_str": "Based on this analysis:\n{0}\n\nSynthesize a complete system design that addresses all concerns.\nInclude:\n- Database schema\n- API endpoints\n- Caching layers\n- Scaling strategy\n- Monitoring approach\n\nProvide a comprehensive technical specification."
      }
    },
    {
      "id": 4,
      "name": "print",
      "op": "PRINT",
      "attributes": {
        "message": "=== CHAINED LLM BENCHMARK RESULT ===\n\nInitial Response:\n{0}\n\n---\n\nDetailed Analysis:\n{1}\n\n---\n\nFinal Design:\n{2}\n"
      }
    },
    {
      "id": 5,
      "name": "return",
      "op": "RETURN",
      "attributes": {}
    }
  ],
