{
  "name": "multi_model",
  "nodes": [
    {
      "id": 1,
      "name": "triage",
      "op": "ASK",
      "attributes": {
        "template_str": "Customer Support Ticket #12847\n\n        From: user@example.com\n        Subject: Cannot access premium features after upgrade\n\n        I upgraded to Premium plan 3 days ago (transaction ID: TXN-9481723)\n        but I still cannot access the advanced analytics dashboard or\n        export features. My payment went through successfully.\n\n        This is blocking my team's work. Please help urgently.\n        \n\nClassify this support ticket:\n- Priority: [LOW/MEDIUM/HIGH/URGENT]\n- Category: [BILLING/TECHNICAL/FEATURE_REQUEST/BUG]\n- Sentiment: [POSITIVE/NEUTRAL/FRUSTRATED/ANGRY]\n\nRespond in 3 lines only."
      }
    },
    {
      "id": 2,
      "name": "extracted_data",
      "op": "THINK",
      "attributes": {
        "template_str": "{ticket_text}\n\nExtract structured information:\n- Email: \n- Transaction ID: \n- Plan: \n- Issue Type: \n- Days Since Issue: \n\nOutput as JSON format only."
      }
    },
    {
      "id": 3,
      "name": "solution",
      "op": "REASON",
      "attributes": {
        "template_str": "Ticket: {ticket_text}\n\nTriage: {0}\n\nExtracted Data: {1}\n\nGenerate a comprehensive solution:\n1. Root cause analysis\n2. Immediate remediation steps\n3. Database queries to check account status\n4. Customer communication template\n5. Process improvements to prevent recurrence\n\nBe thorough and precise."
      }
    },
    {
      "id": 4,
      "name": "customer_response",
      "op": "ASK",
      "attributes": {
        "template_str": "Solution: {0}\n\nCreate a friendly, professional customer email response.\nMaximum 200 words. Be empathetic and clear.\nInclude specific next steps."
      }
    },
    {
      "id": 5,
      "name": "final_output",
      "op": "MERGE",
      "attributes": {}
    },
    {
      "id": 6,
      "name": "print",
      "op": "PRINT",
      "attributes": {
        "message": "=== MULTI-MODEL ROUTING BENCHMARK ===\n\nTRIAGE (Fast Model):\n{0}\n\n---\n\nEXTRACTED DATA (Local Model - Privacy):\n{1}\n\n---\n\nSOLUTION (Powerful Model - Quality):\n{2}\n\n---\n\nCUSTOMER RESPONSE (Fast Model - Formatting):\n{3}"
      }
    },
    {
      "id": 7,
      "name": "return",
      "op": "RETURN",
      "attributes": {}
    }
  ],
  "edges": [
