  "metadata": {
    "description": "2-agent negotiation: SPAWN two ACP agents, send them the same topic simultaneously, WAIT_ALL syncs initial positions, each agent counters the other's argument via COMMUNICATE, WAIT_ALL syncs counters, THINK synthesizes consensus, UMEM stores result, CHECKPOINT saves final state.",
    "pattern": "spawn × 2 → communicate × 2 → wait-all → cross-counter × 2 → wait-all → think → umem → checkpoint",
    "ops_demonstrated": ["SPAWN_AGENT", "COMMUNICATE", "CONST_STR", "MERGE", "WAIT_ALL", "CHECKPOINT", "THINK", "UMEM", "PRINT"]
  }
