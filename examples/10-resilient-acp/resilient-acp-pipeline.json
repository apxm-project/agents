{
  "name": "resilient-acp-pipeline",
  "parameters": [],
  "nodes": [
    {
      "id": 1,
      "name": "spawn_primary",
      "op": "SPAWN_AGENT",
      "attributes": {
        "agent_name": "primary",
        "profile": "claude"
      }
    },
    {
      "id": 2,
      "name": "spawn_fallback",
      "op": "SPAWN_AGENT",
      "attributes": {
        "agent_name": "fallback",
        "profile": "codex"
      }
    },
    {
      "id": 3,
      "name": "task_prompt",
      "op": "CONST_STR",
      "attributes": {
        "value": "Analyze the following Rust code for correctness, performance issues, and potential panics. Provide a structured report with severity levels (HIGH/MED/LOW):\n\nfn process_items(items: Vec<String>) -> Vec<usize> {\n    items.iter()\n        .map(|s| s.parse::<usize>().unwrap())\n        .filter(|n| *n > 0)\n        .collect()\n}"
      }
    },
    {
      "id": 4,
      "name": "guard_input",
      "op": "GUARD",
      "attributes": {
        "condition": "not_null",
        "on_fail": "halt",
        "error_message": "No task prompt available — cannot proceed"
      }
    },
    {
      "id": 5,
      "name": "primary_analysis",
      "op": "COMMUNICATE",
      "attributes": {
        "recipient": "primary",
        "protocol": "acp"
      }
    },
    {
      "id": 6,
      "name": "checkpoint_after_primary",
      "op": "CHECKPOINT",
      "attributes": {
        "checkpoint_id": "resilient-pipeline-primary-done",
        "scope": "full",
        "storage": "fs",
        "on_fail": "continue"
      }
    },
    {
      "id": 7,
      "name": "validate_primary",
      "op": "VERIFY",
      "attributes": {
        "claim": "{{node_5}}",
        "evidence": "A valid code review must identify: the unwrap() panic risk, missing error handling, and at least one recommendation."
      }
    },
    {
      "id": 8,
      "name": "check_valid",
      "op": "BRANCH_ON_VALUE",
      "attributes": {
        "token": "{{node_7}}",
        "value": "valid",
        "label_true": "11",
        "label_false": "9"
      }
    },
    {
      "id": 9,
      "name": "fallback_prefix",
      "op": "CONST_STR",
      "attributes": {
        "value": "Primary review was insufficient. Provide a thorough code review identifying all bugs, panics, and improvements:\n\n"
      }
    },
    {
      "id": 10,
      "name": "build_fallback_prompt",
      "op": "MERGE",
      "attributes": {
        "strategy": "concat",
        "tokens": ["{{node_9}}", "{{node_3}}"]
      }
    },
    {
      "id": 11,
      "name": "fallback_analysis",
      "op": "COMMUNICATE",
      "attributes": {
        "recipient": "fallback",
        "protocol": "acp"
      }
    },
    {
      "id": 12,
      "name": "final_synthesis",
      "op": "ASK",
      "attributes": {
        "template_str": "Produce a final consolidated code review. Primary analysis:\n{{node_5}}\n\nFallback analysis (if used):\n{{node_11}}\n\nMerge insights, remove duplicates, rank issues by severity."
      }
    },
    {
      "id": 13,
      "name": "checkpoint_final",
      "op": "CHECKPOINT",
      "attributes": {
        "checkpoint_id": "resilient-pipeline-complete",
        "scope": "full",
        "storage": "fs"
      }
    },
    {
      "id": 14,
      "name": "print_primary",
      "op": "PRINT",
      "attributes": { "message": "=== PRIMARY AGENT ANALYSIS ===" }
    },
    {
      "id": 15,
      "name": "print_validation",
      "op": "PRINT",
      "attributes": { "message": "=== VALIDATION RESULT ===" }
    },
    {
      "id": 16,
      "name": "print_final",
      "op": "PRINT",
      "attributes": { "message": "=== FINAL CONSOLIDATED REVIEW ===" }
    }
  ],
  "edges": [
    { "from": 1, "to": 5, "dependency": "Control" },
    { "from": 2, "to": 11, "dependency": "Control" },
    { "from": 3, "to": 4, "dependency": "Data" },
    { "from": 4, "to": 5, "dependency": "Data" },
    { "from": 5, "to": 14, "dependency": "Data" },
    { "from": 5, "to": 6, "dependency": "Data" },
    { "from": 6, "to": 7, "dependency": "Data" },
    { "from": 7, "to": 15, "dependency": "Data" },
    { "from": 7, "to": 8, "dependency": "Data" },
    { "from": 8, "to": 9, "dependency": "Control" },
    { "from": 9, "to": 10, "dependency": "Data" },
    { "from": 3, "to": 10, "dependency": "Data" },
    { "from": 10, "to": 11, "dependency": "Data" },
    { "from": 5, "to": 12, "dependency": "Data" },
    { "from": 11, "to": 12, "dependency": "Data" },
    { "from": 12, "to": 13, "dependency": "Data" },
    { "from": 13, "to": 16, "dependency": "Data" }
  ],
  "metadata": {
    "description": "Resilient ACP pipeline: GUARD validates input, primary Claude agent reviews code, CHECKPOINT saves state, VERIFY validates the review quality, BRANCH_ON_VALUE routes to fallback Codex if primary is insufficient, final ASK synthesizes both analyses.",
    "pattern": "guard → spawn → communicate → checkpoint → verify → branch → fallback → synthesize",
    "ops_demonstrated": ["SPAWN_AGENT", "COMMUNICATE", "GUARD", "CHECKPOINT", "VERIFY", "BRANCH_ON_VALUE", "MERGE", "CONST_STR", "ASK", "PRINT"]
  }
}
