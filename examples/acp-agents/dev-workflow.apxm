{
  "name": "apxm-dev-workflow",
  "parameters": [],
  "nodes": [
    {
      "id": 1,
      "name": "spawn_architect",
      "op": "SPAWN_AGENT",
      "attributes": {
        "agent_name": "architect",
        "profile": "claude"
      }
    },
    {
      "id": 2,
      "name": "spawn_coder",
      "op": "SPAWN_AGENT",
      "attributes": {
        "agent_name": "coder",
        "profile": "codex"
      }
    },
    {
      "id": 3,
      "name": "task",
      "op": "CONST_STR",
      "attributes": {
        "value": "Add a CHECKPOINT operation to the AIS instruction set at wire index 38. Follow the exact pattern of the existing Pause op in: (1) crates/apxm-ais/src/operations/definitions.rs - add the enum variant, all match arms, and OperationSpec. (2) crates/apxm-runtime/src/executor/handlers/checkpoint.rs - create stub handler. (3) crates/apxm-runtime/src/executor/handlers/mod.rs - register the module. (4) crates/apxm-runtime/src/executor/dispatcher.rs - add match arm and update the count. Required attribute: checkpoint_id (string). The handler should write to STM and return a token."
      }
    },
    {
      "id": 4,
      "name": "architect_prompt",
      "op": "CONST_STR",
      "attributes": {
        "value": "You are the lead architect for APXM. Produce a detailed, file-by-file implementation plan for: "
      }
    },
    {
      "id": 5,
      "name": "build_architect_prompt",
      "op": "MERGE",
      "attributes": {
        "strategy": "concat",
        "tokens": ["{{node_4}}", "{{node_3}}"]
      }
    },
    {
      "id": 6,
      "name": "architect_plans",
      "op": "COMMUNICATE",
      "attributes": {
        "recipient": "architect",
        "protocol": "acp"
      }
    },
    {
      "id": 7,
      "name": "coder_prefix",
      "op": "CONST_STR",
      "attributes": {
        "value": "Implement exactly what the architect planned below. Make the changes in the codebase. Then run: cargo test --workspace --exclude apxm-compiler 2>&1 | tail -10. Report what you changed and test results.\n\nPlan:\n"
      }
    },
    {
      "id": 8,
      "name": "build_coder_prompt",
      "op": "MERGE",
      "attributes": {
        "strategy": "concat",
        "tokens": ["{{node_7}}", "{{node_6}}"]
      }
    },
    {
      "id": 9,
      "name": "coder_implements",
      "op": "COMMUNICATE",
      "attributes": {
        "recipient": "coder",
        "protocol": "acp"
      }
    },
    {
      "id": 10,
      "name": "review_prefix",
      "op": "CONST_STR",
      "attributes": {
        "value": "Review Codex's implementation. Does it match your plan? Any bugs or missing pieces? Ship it or iterate?\n\nCodex's report:\n"
      }
    },
    {
      "id": 11,
      "name": "build_review_prompt",
      "op": "MERGE",
      "attributes": {
        "strategy": "concat",
        "tokens": ["{{node_10}}", "{{node_9}}"]
      }
    },
    {
      "id": 12,
      "name": "architect_reviews",
      "op": "COMMUNICATE",
      "attributes": {
        "recipient": "architect",
        "protocol": "acp"
      }
    },
    {
      "id": 13,
      "name": "print_plan",
      "op": "PRINT",
      "attributes": {
        "message": "=== ARCHITECT PLAN ==="
      }
    },
    {
      "id": 14,
      "name": "print_implementation",
      "op": "PRINT",
      "attributes": {
        "message": "=== CODER IMPLEMENTATION ==="
      }
    },
    {
      "id": 15,
      "name": "print_review",
      "op": "PRINT",
      "attributes": {
        "message": "=== ARCHITECT REVIEW ==="
      }
    }
  ],
  "edges": [
    {"from": 1, "to": 6, "dependency": "Control"},
    {"from": 2, "to": 9, "dependency": "Control"},
    {"from": 3, "to": 5, "dependency": "Data"},
    {"from": 4, "to": 5, "dependency": "Data"},
    {"from": 5, "to": 6, "dependency": "Data"},
    {"from": 6, "to": 13, "dependency": "Data"},
    {"from": 6, "to": 8, "dependency": "Data"},
    {"from": 7, "to": 8, "dependency": "Data"},
    {"from": 8, "to": 9, "dependency": "Data"},
    {"from": 9, "to": 14, "dependency": "Data"},
    {"from": 9, "to": 11, "dependency": "Data"},
    {"from": 10, "to": 11, "dependency": "Data"},
    {"from": 11, "to": 12, "dependency": "Data"},
    {"from": 12, "to": 15, "dependency": "Data"}
  ],
  "metadata": {
    "description": "APXM dev workflow: Claude architects, Codex implements + tests, Claude reviews. Edit node 3 to change the task."
  }
}
