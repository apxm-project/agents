// cross-critique.ais - converted from cross-critique-pipeline.apxm
// Claude and Codex propose next ACP features in parallel, then each critiques the other. True diamond dataflow with cross-agent context passing.
//
// Usage: dekk apxm execute examples/acp-agents/cross-critique-pipeline.apxm

agent CrossCritique {
    @entry flow main() -> str {
        spawn_agent("agent_a", "claude", "$APXM_HOME") -> _agent_a
        spawn_agent("agent_b", "codex", "$APXM_HOME") -> _agent_b
        ask("In the APXM project (this codebase), what is the single most impactful next feature to implement for the ACP multi-agent system? Propose your top idea with a one-paragraph justification. Be specific and concrete. Under 150 words.") -> question
        ask("Critique the following feature proposal from Claude for the APXM project. Is it feasible? Is it truly the most impactful? What's missing? Under 100 words.\n\nClaude's proposal:\n") -> critique_prefix_for_codex
        ask("Critique the following feature proposal from Codex for the APXM project. Is it feasible? Is it truly the most impactful? What's missing? Under 100 words.\n\nCodex's proposal:\n") -> critique_prefix_for_claude
        communicate("agent_a", "acp", question) -> claude_proposes
        communicate("agent_b", "acp", question) -> codex_proposes
        ask(claude_proposes + "" + critique_prefix_for_codex) -> build_codex_critique
        print("=== PROPOSALS (parallel) ===" + "\n" + claude_proposes + "\n" + codex_proposes)
        ask(codex_proposes + "" + critique_prefix_for_claude) -> build_claude_critique
        communicate("agent_b", "acp", build_codex_critique) -> codex_critiques_claude
        communicate("agent_a", "acp", build_claude_critique) -> claude_critiques_codex
        print("=== CRITIQUES ===" + "\n" + codex_critiques_claude + "\n" + claude_critiques_codex)
        return claude_critiques_codex
    }
}
