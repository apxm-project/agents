// cross-critique.ais - converted from cross-critique.apxm
// Cross-critique: two agents propose, then critique each other
//
// Usage: dekk apxm execute examples/acp-agents/cross-critique.apxm

agent CrossCritique {
    @entry flow main() -> str {
        spawn_agent("agent_a", "claude", "$APXM_HOME") -> _agent_a
        spawn_agent("agent_b", "codex", "$APXM_HOME") -> _agent_b
        ask("Propose a design for a REST API for a todo application.") -> design_prompt
        communicate("agent_a", "acp", design_prompt) -> send_prompt_to_a
        communicate("agent_b", "acp", design_prompt) -> send_prompt_to_b
        communicate("agent_a", "acp", send_prompt_to_b) -> send_b_proposal_to_a
        communicate("agent_b", "acp", send_prompt_to_a) -> send_a_proposal_to_b
        ask(send_a_proposal_to_b + "" + send_b_proposal_to_a) -> merge_critiques
        print("\" + merge_critiques + \"")
        return merge_critiques
    }
}
