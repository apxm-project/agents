// architect-implement-review.ais - converted from architect-implement-review.apxm
// Full SDLC in 3 stages: Claude (architect) designs CHECKPOINT op, Codex writes the stub implementation, Claude reviews it. Each stage receives the previous output as context.
//
// Usage: dekk apxm execute examples/acp-agents/architect-implement-review.apxm

agent ArchitectImplementReview {
    @entry flow main() -> str {
        spawn_agent("architect", "claude", "$APXM_HOME") -> _architect
        spawn_agent("coder", "codex", "$APXM_HOME") -> _coder
        ask("You are the architect for the APXM project. Design a CHECKPOINT operation for the AIS instruction set. A CHECKPOINT allows a running graph to save its current execution state so it can be resumed later (useful for long-running agent workflows). Provide: (1) MLIR mnemonic, (2) required and optional node attributes, (3) what the runtime handler should do at a high level, (4) suggested wire index (next available after 37). Be structured and concise, under 250 words.") -> design_prompt
        ask("Based on the following design spec, write the stub implementation. Produce exactly two sections:\n1. Rust handler: crates/apxm-runtime/src/executor/handlers/checkpoint.rs\n2. TableGen op: the def AIS_CheckpointOp block for AISOps.td\nKeep it compilable. Base it on how spawn_agent.rs and AISOps.td are structured in this repo.\n\nDesign spec:\n") -> implement_prefix
        ask("Review the following stub implementation from Codex for the CHECKPOINT op you designed. Does it match your spec? What's correct, what's wrong, and what would you change? Be specific.\n\nCodex's implementation:\n") -> review_prefix
        communicate("architect", "acp", design_prompt) -> architect_designs
        print("=== ARCHITECT DESIGN ===" + "\n" + architect_designs)
        ask(architect_designs + "" + implement_prefix) -> build_implement_prompt
        communicate("coder", "acp", build_implement_prompt) -> coder_implements
        print("=== CODER IMPLEMENTATION ===" + "\n" + coder_implements)
        ask(coder_implements + "" + review_prefix) -> build_review_prompt
        communicate("architect", "acp", build_review_prompt) -> architect_reviews
        print("=== ARCHITECT REVIEW ===" + "\n" + architect_reviews)
        return architect_reviews
    }
}
