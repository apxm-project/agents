// parallel-agents.ais - converted from parallel-agents.apxm
// Parallel: spawn Claude and Codex, compare their analyses
//
// Usage: dekk apxm execute examples/acp-agents/parallel-agents.apxm

agent ParallelAgents {
    @entry flow main() -> str {
        spawn_agent("claude_analyst", "claude", "$APXM_HOME") -> _claude_analyst
        spawn_agent("codex_analyst", "codex", "$APXM_HOME") -> _codex_analyst
        ask("Analyze the architecture of this project and suggest improvements.") -> analysis_prompt
        communicate("claude_analyst", "acp", analysis_prompt) -> send_to_claude
        communicate("codex_analyst", "acp", analysis_prompt) -> send_to_codex
        ask(send_to_claude + "" + send_to_codex) -> merge_analyses
        print("\" + merge_analyses + \"")
        return merge_analyses
    }
}
