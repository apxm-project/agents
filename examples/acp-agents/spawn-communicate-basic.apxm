{
  "name": "spawn-communicate-basic",
  "parameters": [],
  "nodes": [
    {
      "id": 1,
      "name": "spawn_reviewer",
      "op": "SPAWN_AGENT",
      "attributes": {
        "agent_name": "reviewer",
        "profile": "claude",
        "mode": "architect"
      }
    },
    {
      "id": 2,
      "name": "review_prompt",
      "op": "CONST_STR",
      "attributes": {
        "value": "Review the current directory structure and suggest improvements."
      }
    },
    {
      "id": 3,
      "name": "send_to_reviewer",
      "op": "COMMUNICATE",
      "attributes": {
        "recipient": "reviewer",
        "protocol": "acp"
      }
    },
    {
      "id": 4,
      "name": "print_response",
      "op": "PRINT",
      "attributes": {
        "message": "{{node_3}}"
      }
    }
  ],
  "edges": [
    {"from": 1, "to": 3, "dependency": "Control"},
    {"from": 2, "to": 3, "dependency": "Data"},
    {"from": 3, "to": 4, "dependency": "Data"}
  ],
  "metadata": {
    "description": "Basic: spawn a Claude agent and send one message"
  }
}
