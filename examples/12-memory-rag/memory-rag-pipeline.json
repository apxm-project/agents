  "metadata": {
    "description": "Memory-augmented RAG pipeline: QMEM recalls from LTM + episodic, FENCE orders reads, GUARD branches on memory availability, REASON answers with or without context, VERIFY validates the answer, UMEM persists new knowledge + episodic trace, FENCE orders writes, CHECKPOINT saves session state.",
    "pattern": "qmem × 2 → fence → merge → guard → reason → verify → umem × 2 → fence → checkpoint",
    "ops_demonstrated": ["CONST_STR", "QMEM", "FENCE", "MERGE", "GUARD", "REASON", "VERIFY", "UMEM", "CHECKPOINT", "PRINT"]
  }
}
