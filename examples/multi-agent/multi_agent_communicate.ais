// multi_agent_communicate.ais — Cross-agent COMMUNICATE demo
//
// Demonstrates: spawn_agent + communicate(acp) for two-agent pipeline
//
// Usage: apxm execute examples/multi-agent/multi_agent_communicate.ais

agent Pipeline {
    @entry flow main() -> str {
        spawn_agent("analyst", "claude", "$APXM_HOME") -> _a
        spawn_agent("summarizer", "claude", "$APXM_HOME") -> _s

        communicate("analyst", "acp", "Conduct a thorough technical analysis of APXM as an AI execution framework. Cover: architecture, capabilities, use cases, limitations, competitive positioning. 400 words.") -> analysis
        communicate("summarizer", "acp", "Produce a 3-bullet executive summary of this technical analysis:\n\n" + analysis) -> summary

        print("=== ANALYSIS ===\n\n" + analysis + "\n\n=== SUMMARY ===\n\n" + summary)
        return summary
    }
}
