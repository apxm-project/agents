// apxm_council.ais — Multi-model council
//
// Three parallel ASK ops -> synthesis via THINK -> final verdict
//
// Usage: apxm execute examples/multi-agent/apxm_council.ais

agent CouncilAgent {
    @entry flow main() -> str {
        ask("What topic should we analyze? Provide a clear question about hardware or AI inference.") -> question

        ask("You are a hardware architect. Answer concisely: " + question) -> expert1
        ask("You are a performance engineer. Answer concisely: " + question) -> expert2
        ask("You are a TCO analyst. Answer concisely: " + question) -> expert3

        think("Three experts reviewed the question.\n\nHardware architect: " + expert1 + "\nPerformance engineer: " + expert2 + "\nTCO analyst: " + expert3 + "\n\nSynthesize a definitive, balanced answer:") -> synthesis
        print(synthesis)
        return synthesis
    }
}
