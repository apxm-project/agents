// code_review_council.ais — Parallel code review council
//
// Usage: apxm execute examples/multi-agent/code_review_council.ais "code to review"

agent CodeReviewCouncil {
    @entry flow main(code: str) -> str {
        ask("You are a security reviewer. Review this code for vulnerabilities:\n\n{{code}}\n\nIdentify all security issues with severity ratings.") -> security_review
        ask("You are a performance reviewer. Review this code for efficiency:\n\n{{code}}\n\nIdentify performance bottlenecks and optimization opportunities.") -> perf_review
        ask("You are a maintainability reviewer. Review this code for clarity:\n\n{{code}}\n\nAssess readability, structure, and long-term maintainability.") -> maint_review

        think("Three reviewers assessed this code:\n\nSecurity:\n" + security_review + "\n\nPerformance:\n" + perf_review + "\n\nMaintainability:\n" + maint_review + "\n\nSynthesize a final verdict with priority issues and concrete fixes:") -> verdict
        print(verdict)
        return verdict
    }
}
