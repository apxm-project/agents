// iterative-refine-unrolled.ais
// 3 rounds of REFLECT -> ASK self-refinement.
//
// Usage: dekk apxm execute examples/patterns/iterative-refine/iterative-refine.ais

agent IterativeRefineUnrolled {
    @entry flow main() -> str {
        ask("Write a concise technical explanation of how LLM inference works, targeting a software engineer audience. Be thorough but under 300 words.") -> initial_draft

        think("Critique this draft. What is unclear, imprecise, or missing? Be specific and constructive.\n\nDraft:\n" + initial_draft) -> reflect_1
        ask("Improve this draft based on the critique below.\n\nOriginal draft:\n" + initial_draft + "\n\nCritique:\n" + reflect_1 + "\n\nOutput only the improved draft.") -> refine_1

        think("Critique this revised draft. What still needs improvement? Look for technical accuracy and clarity.\n\nDraft:\n" + refine_1) -> reflect_2
        ask("Improve this draft based on the second round of critique.\n\nRevised draft:\n" + refine_1 + "\n\nCritique:\n" + reflect_2 + "\n\nOutput only the improved draft.") -> refine_2

        think("Final critique before publication. Check for: technical accuracy, flow, clarity, conciseness.\n\nDraft:\n" + refine_2) -> reflect_3
        ask("Apply the final polish to this draft.\n\nDraft:\n" + refine_2 + "\n\nFinal critique:\n" + reflect_3 + "\n\nOutput the publication-ready version.") -> refine_3

        print("=== FINAL REFINED DRAFT ===\n" + refine_3)
        return refine_3
    }
}
