// resilient-acp-pipeline.ais
// Resilient ACP pattern: spawn agent, send task, handle result.
//
// Usage: dekk apxm execute examples/patterns/resilient-acp/resilient-acp-pipeline.ais

agent ResilientAcp {
    @entry flow main() -> str {
        spawn_agent("worker", "claude", "$APXM_HOME") -> _worker

        ask("Describe a complex coding task that requires careful implementation.") -> task_description
        think("Format this as a precise coding instruction for an agent:\n" + task_description) -> formatted_task

        communicate("worker", "acp", formatted_task) -> worker_result

        think("Review the worker's result and summarize what was accomplished:\n" + worker_result) -> summary
        print("=== RESULT ===\n" + summary)
        return summary
    }
}
