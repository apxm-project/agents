// negotiate-consensus.ais
// Two agents negotiate to reach consensus on a technical decision.
//
// Usage: dekk apxm execute examples/patterns/multi-agent-negotiate/negotiate-consensus.ais

agent NegotiateConsensus {
    @entry flow main() -> str {
        spawn_agent("agent_a", "claude", "$APXM_HOME") -> _a
        spawn_agent("agent_b", "claude", "$APXM_HOME") -> _b

        ask("What technical architecture decision should we negotiate? Describe a specific choice with trade-offs.") -> topic

        communicate("agent_a", "acp", "You are Agent A. Propose your preferred solution for: " + topic + ". Be specific about your recommendation and why.") -> proposal_a
        communicate("agent_b", "acp", "You are Agent B. Propose your preferred solution for: " + topic + ". Be specific about your recommendation and why.") -> proposal_b

        communicate("agent_a", "acp", "Agent B proposed: " + proposal_b + "\n\nRespond: do you agree, partially agree, or disagree? What compromise can you offer?") -> response_a
        communicate("agent_b", "acp", "Agent A proposed: " + proposal_a + " and responded: " + response_a + "\n\nCan you reach consensus? State the agreed solution.") -> consensus

        think("Two agents negotiated. Summarize the final consensus:\n\nPROPOSAL A:\n" + proposal_a + "\n\nPROPOSAL B:\n" + proposal_b + "\n\nCONSENSUS:\n" + consensus) -> summary
        print("=== CONSENSUS ===\n" + summary)
        return summary
    }
}
