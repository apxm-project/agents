// worker-pool-parallel.ais
// 3 parallel workers process tasks concurrently, then aggregate results.
//
// Usage: dekk apxm execute examples/patterns/worker-pool/worker-pool.ais

agent WorkerPoolParallel {
    @entry flow main() -> str {
        ask("List 3 distinct technical tasks for analysis. Format as:\nTASK A: [description]\nTASK B: [description]\nTASK C: [description]") -> task_list

        think("You are Worker A. From this task list, perform deep analysis of TASK A:\n" + task_list + "\n\nProvide: (1) key findings, (2) confidence score 0-1, (3) recommended next action.") -> worker_a
        think("You are Worker B. From this task list, perform deep analysis of TASK B:\n" + task_list + "\n\nProvide: (1) key findings, (2) confidence score 0-1, (3) recommended next action.") -> worker_b
        think("You are Worker C. From this task list, perform deep analysis of TASK C:\n" + task_list + "\n\nProvide: (1) key findings, (2) confidence score 0-1, (3) recommended next action.") -> worker_c

        think("Three workers processed parallel tasks. Aggregate their findings:\n\nWORKER A:\n" + worker_a + "\n\nWORKER B:\n" + worker_b + "\n\nWORKER C:\n" + worker_c + "\n\nRanked summary: highest confidence findings and priority actions.") -> aggregate

        update_memory("worker_pool_aggregate", aggregate)
        print("=== WORKER POOL RESULTS ===\n" + aggregate)
        return aggregate
    }
}
