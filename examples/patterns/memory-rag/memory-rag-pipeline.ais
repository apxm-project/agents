// memory-rag-pipeline.ais
// Memory-augmented RAG: recall from LTM, answer with or without context.
//
// Usage: dekk apxm execute examples/patterns/memory-rag/memory-rag-pipeline.ais

agent MemoryRagPipeline {
    @entry flow main() -> str {
        ask("What are the trade-offs between Rust async runtimes: Tokio vs async-std vs smol?") -> query
        query_memory("rust async runtimes comparison") -> recall_ltm

        think("Answer this question, using the memory recall as context if relevant.\n\nQUESTION:\n" + query + "\n\nMEMORY RECALL:\n" + recall_ltm + "\n\nProvide a thorough, accurate answer.") -> answer

        think("Verify this answer is accurate, complete, and balanced.\n\nQUESTION:\n" + query + "\n\nANSWER:\n" + answer + "\n\nIs this correct? Any important omissions or errors?") -> verification

        update_memory("rust_async_runtimes_comparison", answer)
        print("=== ANSWER ===\n" + answer)
        print("=== VERIFICATION ===\n" + verification)
        return answer
    }
}
