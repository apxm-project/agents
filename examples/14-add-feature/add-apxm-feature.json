  "metadata": {
    "description": "Meta-workflow for adding new APXM features. Spawns 13 agents: 5 Claude planners + 5 Codex planners (parallel ultrathink), 1 Claude synthesizer (merges 10 plans), 1 Codex implementer (executes plan + commits), 1 Claude simplifier (review + polish). CHECKPOINTs after each phase for recovery.",
    "pattern": "spawn-13 → parallel-plan-10 → synthesize → implement → simplify → verify → commit",
    "ops_demonstrated": ["SPAWN_AGENT", "CONST_STR", "MERGE", "COMMUNICATE", "WAIT_ALL", "CHECKPOINT", "VERIFY", "UMEM", "PRINT"],
    "usage": "apxm execute examples/14-add-feature/add-apxm-feature.json -- 'Add a ROLLBACK operation that reverts to a previous CHECKPOINT'"
  }
