{
  "name": "add-apxm-feature",
  "parameters": [
    { "name": "feature_request", "type_name": "str", "description": "Description of the APXM feature to implement" }
  ],
  "nodes": [
    {"id": 1, "name": "spawn_claude_planner_1", "op": "SPAWN_AGENT", "attributes": {"agent_name": "claude_planner_1", "profile": "claude"}},
    {"id": 2, "name": "spawn_claude_planner_2", "op": "SPAWN_AGENT", "attributes": {"agent_name": "claude_planner_2", "profile": "claude"}},
    {"id": 3, "name": "spawn_claude_planner_3", "op": "SPAWN_AGENT", "attributes": {"agent_name": "claude_planner_3", "profile": "claude"}},
    {"id": 4, "name": "spawn_claude_planner_4", "op": "SPAWN_AGENT", "attributes": {"agent_name": "claude_planner_4", "profile": "claude"}},
    {"id": 5, "name": "spawn_claude_planner_5", "op": "SPAWN_AGENT", "attributes": {"agent_name": "claude_planner_5", "profile": "claude"}},
    {"id": 6, "name": "spawn_codex_planner_1", "op": "SPAWN_AGENT", "attributes": {"agent_name": "codex_planner_1", "profile": "codex"}},
    {"id": 7, "name": "spawn_codex_planner_2", "op": "SPAWN_AGENT", "attributes": {"agent_name": "codex_planner_2", "profile": "codex"}},
    {"id": 8, "name": "spawn_codex_planner_3", "op": "SPAWN_AGENT", "attributes": {"agent_name": "codex_planner_3", "profile": "codex"}},
    {"id": 9, "name": "spawn_codex_planner_4", "op": "SPAWN_AGENT", "attributes": {"agent_name": "codex_planner_4", "profile": "codex"}},
    {"id": 10, "name": "spawn_codex_planner_5", "op": "SPAWN_AGENT", "attributes": {"agent_name": "codex_planner_5", "profile": "codex"}},
    {"id": 11, "name": "spawn_claude_synthesizer", "op": "SPAWN_AGENT", "attributes": {"agent_name": "claude_synthesizer", "profile": "claude"}},
    {"id": 12, "name": "spawn_codex_implementer", "op": "SPAWN_AGENT", "attributes": {"agent_name": "codex_implementer", "profile": "codex"}},
    {"id": 13, "name": "spawn_claude_simplifier", "op": "SPAWN_AGENT", "attributes": {"agent_name": "claude_simplifier", "profile": "claude"}},

    {"id": 14, "name": "feature_prompt", "op": "CONST_STR", "attributes": {"value": "{{feature_request}}"}},

    {"id": 15, "name": "claude_ultrathink_prefix", "op": "CONST_STR", "attributes": {"value": "You are an APXM architect agent. Think VERY deeply (ultrathink mode) about the following feature request. Analyze all angles: what operations are needed, what handlers must be implemented, what tests are required, what documentation should be added. Produce a detailed, step-by-step implementation plan with file paths and code snippets. Be thorough — this will guide implementation.\n\nFeature request:\n"}},

    {"id": 16, "name": "claude_prompt_full", "op": "MERGE", "attributes": {"strategy": "concat", "tokens": ["{{node_15}}", "{{node_14}}"]}},

    {"id": 17, "name": "claude_plan_1", "op": "COMMUNICATE", "attributes": {"recipient": "claude_planner_1", "protocol": "acp"}},
    {"id": 18, "name": "claude_plan_2", "op": "COMMUNICATE", "attributes": {"recipient": "claude_planner_2", "protocol": "acp"}},
    {"id": 19, "name": "claude_plan_3", "op": "COMMUNICATE", "attributes": {"recipient": "claude_planner_3", "protocol": "acp"}},
    {"id": 20, "name": "claude_plan_4", "op": "COMMUNICATE", "attributes": {"recipient": "claude_planner_4", "protocol": "acp"}},
    {"id": 21, "name": "claude_plan_5", "op": "COMMUNICATE", "attributes": {"recipient": "claude_planner_5", "protocol": "acp"}},

    {"id": 22, "name": "sync_claude_plans", "op": "WAIT_ALL", "attributes": {"tokens": ["{{node_17}}", "{{node_18}}", "{{node_19}}", "{{node_20}}", "{{node_21}}"]}},
    {"id": 23, "name": "checkpoint_claude_plans", "op": "CHECKPOINT", "attributes": {"checkpoint_id": "add-feature-claude-plans", "scope": "full", "storage": "fs"}},
    {"id": 24, "name": "print_claude_plans", "op": "PRINT", "attributes": {"message": "=== CLAUDE PLANS (5 agents) ==="}},

    {"id": 25, "name": "codex_ultrathink_prefix", "op": "CONST_STR", "attributes": {"value": "You are an APXM implementation expert. Think VERY deeply (ultrathink mode) about the following feature request. Focus on: Rust code structure, MLIR dialect changes if needed, test coverage, error handling, performance. Produce a detailed implementation plan with exact file paths, function signatures, and code blocks. Be comprehensive.\n\nFeature request:\n"}},

    {"id": 26, "name": "codex_prompt_full", "op": "MERGE", "attributes": {"strategy": "concat", "tokens": ["{{node_25}}", "{{node_14}}"]}},

    {"id": 27, "name": "codex_plan_1", "op": "COMMUNICATE", "attributes": {"recipient": "codex_planner_1", "protocol": "acp"}},
    {"id": 28, "name": "codex_plan_2", "op": "COMMUNICATE", "attributes": {"recipient": "codex_planner_2", "protocol": "acp"}},
    {"id": 29, "name": "codex_plan_3", "op": "COMMUNICATE", "attributes": {"recipient": "codex_planner_3", "protocol": "acp"}},
    {"id": 30, "name": "codex_plan_4", "op": "COMMUNICATE", "attributes": {"recipient": "codex_planner_4", "protocol": "acp"}},
    {"id": 31, "name": "codex_plan_5", "op": "COMMUNICATE", "attributes": {"recipient": "codex_planner_5", "protocol": "acp"}},

    {"id": 32, "name": "sync_codex_plans", "op": "WAIT_ALL", "attributes": {"tokens": ["{{node_27}}", "{{node_28}}", "{{node_29}}", "{{node_30}}", "{{node_31}}"]}},
    {"id": 33, "name": "checkpoint_codex_plans", "op": "CHECKPOINT", "attributes": {"checkpoint_id": "add-feature-codex-plans", "scope": "full", "storage": "fs"}},
    {"id": 34, "name": "print_codex_plans", "op": "PRINT", "attributes": {"message": "=== CODEX PLANS (5 agents) ==="}},

    {"id": 35, "name": "synthesis_prefix", "op": "CONST_STR", "attributes": {"value": "You are a senior APXM architect. You have received 10 independent implementation plans for the same feature — 5 from Claude planners (more architectural) and 5 from Codex planners (more implementation-focused).\n\nYour job:\n1. Analyze all 10 plans for common themes and unique insights\n2. Identify the best ideas from each\n3. Resolve any conflicts or contradictions\n4. Produce ONE unified, comprehensive implementation plan that combines the best of all\n\nThe unified plan must include:\n- Exact file paths and what to change in each\n- Complete code snippets (not pseudocode)\n- Test cases to add\n- Documentation updates\n- Step-by-step execution order\n\nHere are all 10 plans:\n\n"}},

    {"id": 36, "name": "all_plans", "op": "MERGE", "attributes": {"strategy": "concat", "tokens": ["{{node_22}}", "{{node_32}}"]}},
    {"id": 37, "name": "synthesis_prompt", "op": "MERGE", "attributes": {"strategy": "concat", "tokens": ["{{node_35}}", "{{node_36}}"]}},
    {"id": 38, "name": "synthesize_plan", "op": "COMMUNICATE", "attributes": {"recipient": "claude_synthesizer", "protocol": "acp"}},
    {"id": 39, "name": "checkpoint_synthesis", "op": "CHECKPOINT", "attributes": {"checkpoint_id": "add-feature-synthesis", "scope": "full", "storage": "fs"}},
    {"id": 40, "name": "print_synthesis", "op": "PRINT", "attributes": {"message": "=== SYNTHESIZED PLAN ==="}},

    {"id": 41, "name": "implement_prefix", "op": "CONST_STR", "attributes": {"value": "You are the APXM implementer. Execute the following implementation plan EXACTLY as specified. Make all the code changes, run the tests, fix any issues. Use `dekk apxm build` (never bare cargo). After implementation, run `cargo test --workspace --exclude apxm-compiler` and report results.\n\nImplementation plan:\n"}},
    {"id": 42, "name": "implement_prompt", "op": "MERGE", "attributes": {"strategy": "concat", "tokens": ["{{node_41}}", "{{node_38}}"]}},
    {"id": 43, "name": "implement", "op": "COMMUNICATE", "attributes": {"recipient": "codex_implementer", "protocol": "acp"}},
    {"id": 44, "name": "checkpoint_implement", "op": "CHECKPOINT", "attributes": {"checkpoint_id": "add-feature-implementation", "scope": "full", "storage": "fs"}},
    {"id": 45, "name": "print_implement", "op": "PRINT", "attributes": {"message": "=== IMPLEMENTATION COMPLETE ==="}},

    {"id": 46, "name": "simplify_prefix", "op": "CONST_STR", "attributes": {"value": "You are the APXM code reviewer and simplifier. Review the implementation below:\n\n1. Check for correctness — does it match the plan?\n2. Check for bugs, edge cases, error handling\n3. SIMPLIFY — remove unnecessary complexity, redundant code, over-engineering\n4. Ensure tests pass\n5. Suggest any final improvements\n\nIf changes are needed, make them directly. Then run tests again.\n\nImplementation report:\n"}},
    {"id": 47, "name": "simplify_prompt", "op": "MERGE", "attributes": {"strategy": "concat", "tokens": ["{{node_46}}", "{{node_43}}"]}},
    {"id": 48, "name": "simplify", "op": "COMMUNICATE", "attributes": {"recipient": "claude_simplifier", "protocol": "acp"}},
    {"id": 49, "name": "verify_quality", "op": "VERIFY", "attributes": {"claim": "{{node_48}}", "evidence": "Implementation must: (1) compile without errors, (2) pass all tests, (3) follow APXM code patterns, (4) include documentation"}},
    {"id": 50, "name": "checkpoint_final", "op": "CHECKPOINT", "attributes": {"checkpoint_id": "add-feature-final", "scope": "full", "storage": "fs"}},
    {"id": 51, "name": "print_simplify", "op": "PRINT", "attributes": {"message": "=== SIMPLIFIED + REVIEWED ==="}},

    {"id": 52, "name": "commit_prefix", "op": "CONST_STR", "attributes": {"value": "Commit the changes with a descriptive commit message. Use conventional commits format (feat/fix/docs/refactor). Stage all changed files with `git add`, then commit. Report the commit hash and summary of what was committed.\n\nChanges to commit:\n"}},
    {"id": 53, "name": "commit_prompt", "op": "MERGE", "attributes": {"strategy": "concat", "tokens": ["{{node_52}}", "{{node_48}}"]}},
    {"id": 54, "name": "commit", "op": "COMMUNICATE", "attributes": {"recipient": "codex_implementer", "protocol": "acp"}},
    {"id": 55, "name": "store_result", "op": "UMEM", "attributes": {"key": "last_feature_implementation", "value": "{{node_54}}", "memory_tier": "ltm"}},
    {"id": 56, "name": "print_final", "op": "PRINT", "attributes": {"message": "=== FEATURE COMMITTED ==="}}
  ],
