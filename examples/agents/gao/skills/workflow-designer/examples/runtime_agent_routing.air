// runtime_agent_routing.air — spawn an agent with runtime ACP-profile
// routing: `agent_route = "auto"` lets APXM select a profile matching the
// declared `required_capabilities`, preferring `preferred_profiles` when
// available (SPAWN_AGENT).
//
//   apxm validate runtime_agent_routing.air
module {
  func.func @runtime_agent_routing() -> !ais.token attributes {ais.entry} {
    %routed_worker = ais.spawn_agent "routed_worker" {agent_route = "auto", required_capabilities = ["execute"], preferred_profiles = ["codex"]} : !ais.token
    func.return %routed_worker : !ais.token
  }
}
