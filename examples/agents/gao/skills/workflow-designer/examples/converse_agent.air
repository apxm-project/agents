// converse_agent.air — a recall step followed by a conversational
// AUTONOMOUS loop that consumes it (ASK + AUTONOMOUS, converse=true).
//
//   apxm validate converse_agent.air
module {
  func.func @converse_agent(%arg0: !ais.token {ais.param_name = "turns", ais.param_type = "str"}) -> !ais.token attributes {ais.entry} {
    %load_history = ais.ask "Summarize recent context for {{turns}}." : !ais.token
    %reply = ais.autonomous "You are APXM Assistant, a precise conversational agent. Use the transcript for context and keep replies concise." (%load_history : !ais.token) {max_iterations = 50 : i64, converse = "true", tool_groups = ["web", "skills"]} : !ais.token
    func.return %reply : !ais.token
  }
}
