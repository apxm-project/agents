// review-simple-workflow.air — a minimal ask graph to practice reviewing
//: the checkpoint_pipeline / vector fixture
// (workspace/contracts/vectors/air/checkpoint_pipeline.air), copied
// byte-for-byte. The previous version of this file predated the current
// op-spec-driven emitter (`@main func.func { param / ask / ret }`, no
// `module` wrapper, no `!ais.token` typing) and no longer parses against the
// AIR grammar (workspace/contracts/docs/air-grammar.md) — swapped for a real
// vector fixture so this example stays reviewable and provenance-checkable
// (see tools/check_air_provenance.py) instead of drifting stale.
//
//   apxm validate review-simple-workflow.air
module {
  func.func @checkpoint_pipeline() -> !ais.token attributes {ais.entry} {
    %draft_notes = ais.ask "Draft release notes for version {version}." : !ais.token
    %await_signoff = ais.fence : !ais.token
    %polish_notes = ais.ask "Polish this release-notes draft:\n\n{draft}" [%draft_notes : !ais.token] {input_names = ["draft"]} : !ais.token
    func.return %polish_notes : !ais.token
  }
}
