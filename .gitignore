# Generated by Cargo
# will have compiled files and executables
/debug
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/


# Build directories (CMake, etc.)
**/build/

# Node.js
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
.eggs/
.pytest_cache/
.dekk

# macOS
.DS_Store

# Editor/IDE
*.swp
*.swo
*~
.vscode/
.idea/

# Clangd cache
.cache/

# APXM compiled artifacts
*.apxmobj


# Python cache
.python-cache

# Coverage
.coverage
.coverage.*
htmlcov/


# Conda/mamba temp files
condaenv.*.requirements.txt
mamba*

# Build
.apxm

# Local machine-specific cargo config (contains local paths, do not commit)
# Copy .cargo/config.toml.example to .cargo/config.toml and fill in your paths
.cargo/config.toml

# Worktrees (managed by git worktree, not part of main tree)
.worktrees/

# Environment / secrets
.env
.env.*
*.key
*.pem
apxm.toml.local

# Third-party agent tooling state (not APXM)
.openclaw/

# Agent configs (generated by `dekk apxm skills generate`)
# Source-of-truth: apxm-plugin/ (committed)
# Generated output files (gitignored):
/.claude/
/.agents/
/CLAUDE.md
/AGENTS.md
/.cursorrules
/.agents.json
/agents/
.cursor/*
!.cursor/rules/
.codex/
/.github/copilot-instructions.md
/.github/instructions/
/.github/extensions/
# Generated enrichment inside plugin dir
/apxm-plugin/.claude-plugin/
/apxm-plugin/.mcp.json
/apxm-plugin/hooks/
/apxm-plugin/mcp/