# Generated by Cargo
# will have compiled files and executables
/debug
/target
/crates/target/

# Rust internal compiler error dumps
rustc-ice-*.txt

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/


# Build directories (CMake, etc.)
**/build/

# Node.js
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
.eggs/
.pytest_cache/
.dekk

# macOS
.DS_Store

# Editor/IDE
*.swp
*.swo
*~
.vscode/
.idea/

# Clangd cache
.cache/

# APXM compiled artifacts
*.apxmobj

# Prevent accidental re-introduction of private slide/poster binaries
*.pptx
*Poster*.pdf

# Python cache
.python-cache

# Coverage
.coverage
.coverage.*
htmlcov/


# Conda/mamba temp files
condaenv.*.requirements.txt
mamba*

# APXM local workspace; .apxm/config.example.toml is the only tracked file.
/.apxm/*
!/.apxm/config.example.toml

# Claude Code's per-machine cache (regenerated by `dekk agents skills generate`).
# Tracked agent surfaces are .agents/, AGENTS.md, CLAUDE.md, .agents.json,
# .cursorrules, .github/copilot-instructions.md, DOMAIN.md.
/.claude/

# Per-developer MCP client configs (auto-generated by `dekk agents mcp install`).
# Each developer runs the installer locally; paths in this file are
# machine-specific (absolute paths to `target/release/apxm-mcp-server`).
/.mcp.json

# Keep examples source-only; APXM runtime/evaluation artifacts belong in /.apxm/.
examples/python/benchmarks/results/
examples/python/benchmarks/stress/results/
examples/python/demos/gemma4/runs/

# Local machine-specific cargo config (contains local paths, do not commit)
# Copy .cargo/config.toml.example to .cargo/config.toml and fill in your paths
.cargo/config.toml

# Worktrees (managed by git worktree, not part of main tree)
.worktrees/

# Environment / secrets
.env
.env.*
*.key
*.pem
apxm.toml.local
.venv/
.venv-*/
.cursor*/
.tmp/
slurm-*.out

# Operator's local zoo manifest (gitignored; copy zoo.example.toml to seed)
deploy/vllm/zoo.toml

# Vendored upstream benchmarks live as working clones (too large + stale-prone
# to track). Refresh via the pin sha recorded in tools/external/_apxm-notes/.
tools/external/tau2-bench/
.apxm/

# Canonical Python authoring native bridge (built by tests)
crates/compiler/frontend/python/apxm_program/_native.so
