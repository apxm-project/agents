# Rust and native build outputs
/target/
**/target/
**/debug/
**/build/
*.pdb
rustc-ice-*.txt
**/*.rs.bk
**/mutants.out*/

# Native bridge copied into the Python package by the frontend install task.
/crates/compiler/frontend/python/apxm_program/_native.so

# JavaScript and TypeScript build outputs
**/node_modules/
**/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python caches, environments, and packaging outputs
__pycache__/
*.py[cod]
.Python
*.egg-info/
.eggs/
*.whl
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-cache/
.venv/
.venv-*/

# Coverage and profiling output
.coverage
.coverage.*
htmlcov/
**/coverage/
*.profraw
*.profdata

# Operating-system and editor state
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
.cache/

# APXM generated artifacts and local workspace state
*.apxmobj
/.apxm/*
!/.apxm/config.example.toml
/.dekk/
# npm may create a package-local cache when a delegated command supplies a
# relative cache path. Keep that generated state out of the source checkout.
**/.npm-cache/
/.claude/*
!/.claude/skills
/.mcp.json
/.worktrees/

# Local machine configuration and secrets
/.cargo/config.toml
/.env
/.env.*
!/.env.example
*.key
*.pem
*.p12
.cursor*/
.tmp/
*.tmp
*.temp

# Scheduler and local execution output
slurm-*.out
*.log

# Keep example runtime outputs outside Git. Their package manifests and npm
# lockfiles remain tracked so dependency resolution is reproducible.
examples/**/benchmarks/
examples/**/results/
examples/**/runs/
examples/**/sessions/
