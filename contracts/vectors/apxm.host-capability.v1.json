[
  {
    "name": "a-package-declares-one-read-host-capability",
    "input": {
      "schema_version": "apxm.host-capability.v1",
      "capabilities": [
        {
          "id": "notes.search",
          "effect": "read",
          "input_schema": {
            "type": "object",
            "properties": { "query": { "type": "string" } },
            "required": ["query"],
            "additionalProperties": false
          },
          "output_schema": { "type": "object" }
        }
      ]
    },
    "expected_valid": true
  },
  {
    "name": "a-package-declares-a-read-and-a-write-capability",
