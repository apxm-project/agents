        {
          "id": "sale-orders.list",
          "effect": "read",
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" }
        },
        {
          "id": "sale_order.confirm",
          "effect": "write",
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" }
        }
      ]
    },
    "expected_valid": true
  },
  {
    "name": "a-package-declaring-no-host-capability-is-the-empty-set",
