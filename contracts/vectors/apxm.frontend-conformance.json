    {
      "id": "contextual_tool_loop",
      "covers": "A Context-carrying loop Agent with a conditional Tool call and a Model call, and the capability.invoke inside ais.loop it lowers to.",
      "declarations": [
        {
          "name": "SearchWeb",
          "marker": "Tool",
          "target_ref": "search_web"
        },
        {
          "name": "SupportModel",
          "marker": "Model",
          "target_ref": "support.model"
        }
      ],
      "programs": [
        {
          "program_id": "Support",
          "input": "Input",
          "output": "Output",
          "context": "Conversation",
          "body": [
            {
              "stmt": "loop_forever",
              "body": [
                {
                  "stmt": "let_null",
                  "name": "research"
                },
                {
                  "stmt": "if_not_null",
                  "value": {
                    "expr": "name",
                    "name": "input"
                  },
                  "body": [
                    {
                      "stmt": "bind",
                      "name": "research",
                      "value": {
                        "expr": "effect",
                        "binding": "SearchWeb",
                        "arguments": [
                          {
                            "expr": "name",
                            "name": "input"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "stmt": "bind",
                  "name": "response",
                  "value": {
                    "expr": "effect",
                    "binding": "SupportModel",
                    "arguments": [
                      {
                        "expr": "name",
                        "name": "input"
                      }
                    ]
                  }
                },
                {
                  "stmt": "set_context",
                  "context": "Conversation",
                  "values": {}
                },
                {
                  "stmt": "return",
                  "value": {
                    "expr": "name",
                    "name": "response"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expect": [
        {
          "query": "graph:declarations[].decl_kind",
          "set_equals": [
            "context",
            "tool_binding",
            "model_binding"
          ]
        },
        {
