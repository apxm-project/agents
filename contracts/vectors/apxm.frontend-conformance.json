          "marker": "Model",
          "target_ref": "audit.model"
        },
        {
          "name": "AuditTool",
          "marker": "Tool",
          "target_ref": "read",
          "permission": {
            "decision": "ask",
            "reason": "Reads whatever the model asks for."
