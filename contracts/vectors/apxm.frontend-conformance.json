    {
      "id": "composed_agent_event_and_task_group",
      "covers": "Agent composition, event waiting, a structured task scope, a resumable yield, and a model-scope Hook in one program.",
      "declarations": [
        {
          "name": "ReviewModel",
          "marker": "Model",
          "target_ref": "review.model"
        },
        {
          "name": "SpecialistModel",
          "marker": "Model",
          "target_ref": "specialist.model"
        },
        {
          "name": "Approval",
          "marker": "Event",
          "target_ref": "approval.event",
          "payload": "string"
        }
      ],
      "programs": [
        {
          "program_id": "Specialist",
          "input": "Input",
          "output": "Output",
          "context": "ReviewContext",
          "body": [
            {
              "stmt": "return",
              "value": {
                "expr": "effect",
                "binding": "SpecialistModel",
                "arguments": [
                  {
                    "expr": "name",
                    "name": "input"
                  }
                ]
              }
            }
          ]
        },
        {
          "program_id": "Coordinator",
          "input": "ReviewEventRef",
          "output": "Output",
          "context": "ReviewContext",
          "hooks": [
            {
              "name": "RecordModelStart",
              "phase": "before",
              "target": "ReviewModel",
              "scope": "model",
              "body": []
            }
          ],
          "body": [
            {
              "stmt": "loop_forever",
              "body": [
                {
                  "stmt": "new_program",
                  "name": "specialist",
                  "program": "Specialist",
                  "context": "ReviewContext"
                },
                {
                  "stmt": "bind",
                  "name": "review",
                  "value": {
                    "expr": "invoke",
                    "instance": "specialist",
                    "arguments": [
                      {
                        "expr": "name",
                        "name": "input"
                      }
                    ]
                  }
                },
                {
                  "stmt": "bind",
                  "name": "approved",
                  "value": {
                    "expr": "await_event",
                    "event": "Approval",
                    "arguments": [{ "expr": "field", "name": "input", "field": "reference" }]
                  }
                },
                {
                  "stmt": "task_group",
                  "body": [
                    {
                      "stmt": "bind",
                      "name": "result",
                      "value": {
                        "expr": "effect",
                        "binding": "ReviewModel",
                        "arguments": [
                          {
                            "expr": "name",
                            "name": "review"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "stmt": "set_context",
                  "context": "ReviewContext",
                  "values": {
                    "completed": true
                  }
                },
                {
                  "stmt": "yield",
                  "name": "input",
                  "value": {
                    "expr": "name",
                    "name": "review"
                  }
                }
              ]
            }
          ]
        }
      ],
      "expect": [
        {
          "query": "graph:imported_program_refs[].program_ref",
          "equals": [
            "Specialist"
          ]
        },
        {
          "query": "graph:imported_program_refs[].entrypoint",
          "equals": [
            "Specialist"
          ]
        },
        {
          "query": "graph:imported_program_refs[].target_agent_identity_requirement",
          "equals": [
            "Specialist.identity"
          ]
        },
        {
