          ]
        },
        {
          "query": "graph:program_definitions[].input_type_ref",
          "equals": [
            "Input"
          ]
        },
        {
          "query": "graph:program_definitions[].output_type_ref",
          "equals": [
            "Output"
          ]
        },
        {
          "query": "graph:program_definitions[].entrypoint",
          "equals": [
            "Summarizer"
          ]
        },
        {
          "query": "graph:declarations[].decl_kind",
          "equals": [
            "model_binding"
          ]
        },
        {
          "query": "graph:call_intents[].intent_kind",
          "equals": [
            "model_invocation"
          ]
        },
        {
          "query": "graph:model_requirements",
          "equals": [
