    {
      "id": "same_phase_hooks_run_in_declaration_order",
      "covers": "Two same-phase Hooks on one target are numbered by the order their module declared them, densely from zero, so the schedule does not depend on what the Hooks were named.",
      "declarations": [
        {
          "name": "OrderedModel",
          "marker": "Model",
          "target_ref": "ordered.model"
        }
      ],
      "programs": [
        {
          "program_id": "OrderedHooks",
          "input": "Input",
          "output": "Output",
          "hooks": [
            {
              "name": "ZebraRunsFirst",
              "phase": "before",
              "target": "OrderedModel",
              "scope": "model",
              "body": []
            },
            {
              "name": "AlphaRunsSecond",
              "phase": "before",
              "target": "OrderedModel",
              "scope": "model",
              "body": []
            }
          ],
          "body": [
            {
              "stmt": "return",
              "value": {
                "expr": "effect",
                "binding": "OrderedModel",
                "arguments": [
                  {
                    "expr": "name",
                    "name": "input"
                  }
                ]
              }
            }
          ]
        }
      ],
      "expect": [
        {
          "query": "graph:hook_bindings[].handler_ref",
          "equals": [
            "ZebraRunsFirst",
            "AlphaRunsSecond"
          ]
        },
        {
          "query": "graph:hook_bindings[].declaration_order",
          "equals": [
            0,
            1
          ]
        },
        {
          "query": "graph:hook_bindings[0].target_selector",
          "same_as": "graph:hook_bindings[1].target_selector"
        },
        {
          "query": "diagnostics",
          "equals": null
        },
        {
          "query": "air:structural_ir[hook.hook_id=hook.ZebraRunsFirst].execution_order",
          "differs_from": "air:structural_ir[hook.hook_id=hook.AlphaRunsSecond].execution_order"
        }
      ]
    },
