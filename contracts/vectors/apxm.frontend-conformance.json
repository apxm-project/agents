    {
      "id": "minimal_model_agent",
      "covers": "A one-shot Agent whose only effect is a Model call, and the model.call it lowers to.",
      "declarations": [
        {
          "name": "SummarizerModel",
          "marker": "Model",
          "target_ref": "summarizer.model"
        }
      ],
      "programs": [
        {
          "program_id": "Summarizer",
          "input": "Input",
          "output": "Output",
          "body": [
            {
              "stmt": "return",
              "value": {
                "expr": "effect",
                "binding": "SummarizerModel",
                "arguments": [
                  {
                    "expr": "name",
                    "name": "input"
                  }
                ]
              }
            }
          ]
        }
      ],
      "expect": [
        {
          "query": "graph:schema_version",
          "equals": "apxm.frontend-graph"
