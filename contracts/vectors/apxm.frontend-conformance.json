                "arguments": [
                  {
                    "expr": "name",
                    "name": "input"
                  }
                ]
              }
            },
            {
              "stmt": "bind",
              "name": "archived",
              "value": {
                "expr": "effect",
                "binding": "AuditCapability",
                "arguments": [
                  {
                    "expr": "name",
                    "name": "findings"
                  }
