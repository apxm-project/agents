          ]
        },
        {
          "query": "graph:context_flow[0].from_node",
          "same_as": "graph:control_intents[control_kind=task_group][0].node_id"
        },
        {
          "query": "graph:context_flow[0].to_node",
          "same_as": "graph:control_intents[control_kind=yield][0].node_id"
        },
        {
          "query": "graph:hook_bindings[].handler_ref",
          "equals": [
            "RecordModelStart"
          ]
        },
        {
          "query": "graph:hook_bindings[].scope",
          "equals": [
