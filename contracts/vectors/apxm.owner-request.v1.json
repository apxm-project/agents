[
  {
    "name": "choice-request-accepted",
    "input": {
      "schema_version": "apxm.owner-request.v1",
      "prompt": "Send the quote?",
      "answer": {
        "mode": "choice",
        "choices": [
          { "id": "send", "label": "Send it" },
          { "id": "hold", "label": "Hold" }
        ]
      },
      "expires_in_seconds": 3600,
      "schema_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expected_valid": true
  },
  {
    "name": "typed-request-accepted",
    "input": {
      "schema_version": "apxm.owner-request.v1",
      "prompt": "How much?",
      "answer": {
        "mode": "typed",
        "schema": {
          "type": "object",
          "properties": { "amount": { "type": "integer" } },
          "required": ["amount"],
          "additionalProperties": false
        }
      },
      "expires_in_seconds": 60,
      "schema_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expected_valid": true
  },
  {
    "name": "request-without-schema-version-rejected",
    "input": {
      "prompt": "Send the quote?",
      "answer": { "mode": "choice", "choices": [{ "id": "send", "label": "Send it" }] },
      "expires_in_seconds": 3600,
      "schema_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expected_valid": false
  },
  {
    "name": "request-without-digest-rejected",
    "input": {
      "schema_version": "apxm.owner-request.v1",
      "prompt": "Send the quote?",
      "answer": { "mode": "choice", "choices": [{ "id": "send", "label": "Send it" }] },
      "expires_in_seconds": 3600
    },
    "expected_valid": false
  },
  {
    "name": "request-with-empty-choices-rejected",
    "input": {
      "schema_version": "apxm.owner-request.v1",
      "prompt": "Send the quote?",
      "answer": { "mode": "choice", "choices": [] },
      "expires_in_seconds": 3600,
      "schema_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expected_valid": false
  },
  {
    "name": "request-with-zero-expiry-rejected",
    "input": {
      "schema_version": "apxm.owner-request.v1",
      "prompt": "Send the quote?",
      "answer": { "mode": "choice", "choices": [{ "id": "send", "label": "Send it" }] },
      "expires_in_seconds": 0,
      "schema_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expected_valid": false
  },
  {
    "name": "request-with-open-typed-schema-rejected",
    "input": {
      "schema_version": "apxm.owner-request.v1",
      "prompt": "How much?",
      "answer": {
        "mode": "typed",
        "schema": { "type": "object", "properties": {}, "required": [], "additionalProperties": true }
      },
      "expires_in_seconds": 60,
      "schema_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expected_valid": false
  },
  {
    "name": "request-with-authored-kind-rejected",
    "input": {
      "schema_version": "apxm.owner-request.v1",
      "kind": "owner_request",
      "prompt": "Send the quote?",
      "answer": { "mode": "choice", "choices": [{ "id": "send", "label": "Send it" }] },
      "expires_in_seconds": 3600,
      "schema_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expected_valid": false
  },
  {
    "name": "answer-envelope-is-not-a-request-document",
    "input": { "outcome": "answered", "answer": "send" },
    "expected_valid": false
  },
  {
    "name": "answered-envelope-carries-the-value",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": { "outcome": "answered", "answer": "send" },
    "expected_valid": true
  },
  {
    "name": "answered-envelope-carries-a-typed-value",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": { "outcome": "answered", "answer": { "amount": 3 } },
    "expected_valid": true
  },
  {
    "name": "declined-envelope-accepted",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": { "outcome": "declined" },
    "expected_valid": true
  },
  {
    "name": "expired-envelope-accepted",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": { "outcome": "expired" },
    "expected_valid": true
  },
  {
    "name": "answered-envelope-without-an-answer-rejected",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": { "outcome": "answered" },
    "expected_valid": false
  },
  {
    "name": "declined-envelope-carrying-an-answer-rejected",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": { "outcome": "declined", "answer": "send" },
    "expected_valid": false
  },
  {
    "name": "unknown-outcome-rejected",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": { "outcome": "later" },
    "expected_valid": false
  },
  {
    "name": "envelope-with-an-unknown-field-rejected",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": { "outcome": "answered", "answer": "send", "answered_at": "2026-01-01T00:00:00Z" },
    "expected_valid": false
  },
  {
    "name": "envelope-that-is-not-an-object-rejected",
    "schema_pointer": "#/$defs/OwnerAnswer",
    "input": "answered",
    "expected_valid": false
  }
]
