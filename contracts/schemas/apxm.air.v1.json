{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.air.v1",
  "title": "AgentIR",
  "description": "Canonical Agent IR with exactly five public semantic operations (model.call, capability.invoke, program.new, program.invoke, await.event) and compiler-owned structural IR (functions, regions, blocks, values, branches, switches, loops, parallel joins, try/throw/catch, return, yield). Branch, loop, task, try, yield, and return are structural, never public semantic operations; a transient NOP is compiler machinery that is never serialized.",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_operations",
    "structural_ir",
    "source_map"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.air.v1"
    },
    "semantic_operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticOp"
      }
    },
    "structural_ir": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StructuralNode"
      }
    },
    "source_map": {
      "$ref": "apxm.source-map.v1#/$defs/SourceMapBody"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SemanticOp": {
      "type": "object",
      "required": [
        "node_id",
        "op"
      ],
      "properties": {
        "node_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "op": {
          "type": "string",
          "enum": [
            "model.call",
            "capability.invoke",
            "program.new",
            "program.invoke",
            "await.event"
          ]
        },
        "operands": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "StructuralNode": {
      "type": "object",
      "required": [
        "region_id",
        "kind"
      ],
      "properties": {
        "region_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "region",
            "block",
            "value",
            "branch",
            "switch",
            "loop",
            "parallel_join",
            "try",
            "throw",
            "catch",
            "return",
            "yield"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
