{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.air.v1",
  "title": "AgentIR",
  "description": "Canonical Agent IR with exactly five public semantic operations (model.call, capability.invoke, program.new, program.invoke, await.event) and the closed AIS-owned compiler-emitted structural family. ais.loop is structural, never a sixth public semantic operation; a transient NOP is compiler machinery that is never serialized.",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_operations",
    "structural_ir",
    "context_flow",
    "source_map"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.air.v1"
    },
    "semantic_operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticOp"
      }
    },
    "structural_ir": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StructuralNode"
      }
    },
    "context_flow": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextEdge"
      }
    },
    "source_map": {
      "$ref": "apxm.source-map.v1#/$defs/SourceMapBody"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SemanticOp": {
      "type": "object",
      "required": [
        "node_id",
        "op",
        "parent_region_id",
        "execution_order"
      ],
      "properties": {
        "node_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "op": {
          "type": "string",
          "enum": [
            "model.call",
            "capability.invoke",
            "program.new",
            "program.invoke",
            "await.event"
          ]
        },
        "parent_region_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "execution_order": {
          "type": "integer",
          "minimum": 0
        },
        "operands": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "StructuralNode": {
      "type": "object",
      "required": [
        "region_id",
        "kind",
        "execution_order"
      ],
      "properties": {
        "region_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "region",
            "block",
            "value",
            "branch",
            "switch",
            "ais.loop",
            "parallel_join",
            "try",
            "throw",
            "catch",
            "return",
            "yield"
          ]
        },
        "parent_region_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "execution_order": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ContextEdge": {
      "type": "object",
      "required": [
        "from_node",
        "to_node",
        "context_type_ref"
      ],
      "properties": {
        "from_node": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "to_node": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "context_type_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    }
  }
}
