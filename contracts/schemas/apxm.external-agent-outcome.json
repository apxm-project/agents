{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.external-agent-outcome",
  "title": "ExternalAgentOutcome",
  "description": "The closed outer Capability outcome and attributed nested evidence returned by one admitted External Agent implementation.",
  "type": "object",
  "required": ["session_ref", "state", "nested_events", "peer_usage"],
  "properties": {
    "session_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
    "state": { "$ref": "#/$defs/PromptEffectState" },
    "nested_events": {
      "type": "array",
      "items": { "$ref": "apxm.external-agent-evidence#/$defs/AttributedEvent" }
    },
    "peer_usage": {
      "type": "array",
      "items": { "$ref": "apxm.external-agent-evidence#/$defs/PeerUsage" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PromptEffectState": {
      "oneOf": [
        {
          "type": "object",
          "required": ["completed"],
          "properties": {
            "completed": {
              "type": "object",
              "required": ["stop_reason"],
              "properties": { "stop_reason": { "type": ["string", "null"], "maxLength": 256 } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        { "const": "cancelled" },
        {
          "type": "object",
          "required": ["failed"],
          "properties": { "failed": { "$ref": "#/$defs/Message" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["outcome_unknown"],
          "properties": { "outcome_unknown": { "$ref": "#/$defs/Message" } },
          "additionalProperties": false
        }
      ]
    },
    "Message": {
      "type": "object",
      "required": ["message"],
      "properties": { "message": { "type": "string", "minLength": 1, "maxLength": 4096 } },
      "additionalProperties": false
    }
  }
}
