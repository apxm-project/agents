{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.model-inference-request",
  "title": "ModelInferenceRequest",
  "description": "One complete model inference request bound to an admitted target, deployment, Exact Port Binding, sealed context, and stable effect identity.",
  "type": "object",
  "required": [
    "effect_id",
    "node_execution_id",
    "request_digest",
    "resolved_binding",
    "model_context_envelope_ref",
    "idempotency",
    "stream_mode"
  ],
  "properties": {
    "effect_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
    "node_execution_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
    "request_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
    "resolved_binding": { "$ref": "#/$defs/ResolvedModelBinding" },
    "model_context_envelope_ref": { "$ref": "#/$defs/ModelContextEnvelopeRef" },
    "idempotency": { "$ref": "#/$defs/IdempotencyKey" },
    "stream_mode": { "enum": ["buffered", "streamed"] }
  },
  "additionalProperties": false,
  "$defs": {
    "ResolvedModelBinding": {
      "type": "object",
      "required": ["model_target", "model_deployment_ref", "exact_port_binding", "composition_digest", "target_commitment"],
      "properties": {
        "model_target": { "$ref": "#/$defs/ExactModelTargetRef" },
        "model_deployment_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "exact_port_binding": { "$ref": "#/$defs/ExactPortBindingRef" },
        "composition_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "target_commitment": { "$ref": "#/$defs/TargetCommitment" }
      },
      "additionalProperties": false
    },
    "TargetCommitment": {
      "type": "object",
      "required": [
        "schema_version", "target_ref", "target_digest", "model_deployment_ref",
        "exact_port_binding_digest", "port_contract_digest", "composition_digest",
        "target_generation", "deployment_generation", "binding_generation",
        "composition_generation", "generation_cohort_digest", "commit_digest", "state"
      ],
      "properties": {
        "schema_version": { "const": "apxm.inference-target-commitment" },
        "target_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "target_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "model_deployment_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "exact_port_binding_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "port_contract_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "composition_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "target_generation": { "type": "integer", "minimum": 0 },
        "deployment_generation": { "type": "integer", "minimum": 0 },
        "binding_generation": { "type": "integer", "minimum": 0 },
        "composition_generation": { "type": "integer", "minimum": 0 },
        "generation_cohort_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "commit_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "state": { "enum": ["committed", "moving", "stale", "dirty", "mixed_generation", "ambiguous"] }
      },
      "additionalProperties": false
    },
    "ExactModelTargetRef": {
      "type": "object",
      "required": ["reference", "target_digest"],
      "properties": {
        "reference": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "target_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" }
      },
      "additionalProperties": false
    },
    "ExactPortBindingRef": {
      "type": "object",
      "required": ["binding_digest", "port_contract_digest"],
      "properties": {
        "binding_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "port_contract_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" }
      },
      "additionalProperties": false
    },
    "ModelContextEnvelopeRef": {
      "type": "object",
      "required": ["context_id", "sealed_digest"],
      "properties": {
        "context_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "sealed_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" }
      },
      "additionalProperties": false
    },
    "IdempotencyKey": {
      "type": "object",
      "required": ["key_id", "scope_ref"],
      "properties": {
        "key_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "scope_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" }
      },
      "additionalProperties": false
    }
  }
}
