{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.vllm-conformance-join.v1",
  "title": "VllmConformanceJoin",
  "description": "Agents-owned join record that binds released vLLM backend conformance digests to the agents inference-driver contract. Agents never becomes a second owner of vLLM semantics; this record only verifies digest membership of released backend evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "agents_driver_contract_id",
    "vllm_port_contract_id",
    "vllm_port_contract_digest",
    "joined_vector_digests",
    "join_status"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.vllm-conformance-join.v1"
    },
    "agents_driver_contract_id": {
      "const": "apxm.inference-driver-binding.v1"
    },
    "vllm_port_contract_id": {
      "const": "apxm.vllm-inference.v1"
    },
    "vllm_port_contract_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "joined_vector_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "apxm.contract-common.v1#/$defs/Digest"
      },
      "uniqueItems": true
    },
    "join_status": {
      "type": "string",
      "enum": [
        "joined",
        "candidate_awaiting_vllm_release"
      ]
    }
  },
  "additionalProperties": false
}
