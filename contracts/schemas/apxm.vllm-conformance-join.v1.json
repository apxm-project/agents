{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.vllm-conformance-join.v1",
  "title": "VllmConformanceJoin",
  "description": "Agents-owned candidate or joined record that binds exact vLLM backend conformance digests to the agents inference-driver contract. Agents never becomes a second owner of vLLM semantics; candidate records remain pending until exact external release evidence exists, and joined status is rejected without that evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "agents_driver_contract_id",
    "vllm_port_contract_id",
    "vllm_port_contract_digest",
    "joined_vector_digests",
    "join_status"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.vllm-conformance-join.v1"
    },
    "agents_driver_contract_id": {
      "const": "apxm.inference-driver-binding.v1"
    },
    "vllm_port_contract_id": {
      "const": "apxm.vllm-inference.v1"
    },
    "vllm_port_contract_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "joined_vector_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "apxm.contract-common.v1#/$defs/Digest"
      },
      "uniqueItems": true
    },
    "join_status": {
      "type": "string",
      "enum": [
        "joined",
        "candidate_awaiting_vllm_release"
      ]
    },
    "release_attestation": {
      "type": "object",
      "required": [
        "release_id",
        "owner_revision",
        "manifest_digest",
        "port_contract_digest",
        "vector_digests"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "port_contract_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "vector_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "apxm.contract-common.v1#/$defs/Digest"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "join_status": {
          "const": "candidate_awaiting_vllm_release"
        }
      }
    },
    {
      "required": [
        "release_attestation"
      ],
      "properties": {
        "join_status": {
          "const": "joined"
        },
        "release_attestation": {
          "properties": {
            "release_id": {
              "const": "apxm-vllm-5d825f6c1896"
            },
            "owner_revision": {
              "const": "5d825f6c18961c2b38edb15834acbd794fc549eb"
            },
            "manifest_digest": {
              "const": "sha256:b489043b6f723b3e7bf9b4a054f55383dde90f8cf25290275a813c0970bcaeb4"
            },
            "port_contract_digest": {
              "const": "sha256:361aaf5fd82ae1dd8279726769088c2711a55d964a8376faf4646a149fee9f3c"
            },
            "vector_digests": {
              "const": [
                "sha256:7add76f8f7df341785ef45ff51b38e979a309299509b32e76b311268cc93ea32",
                "sha256:a60b2364bbbe1304e96defcf55a8600d501933e0fbae97c140f2bc4377d5e822",
                "sha256:96914ff1d56cc2d1e74fda3a063287615392cb0197bcc1c853cb1a18a5e7e8c3",
                "sha256:5e7abcccf5c7f7276b9398ccd2c255671f23a6914eb23287b44518b30b8c7723",
                "sha256:1e9a389b24f08411738594ca3646bbcbeb18a77c398c6b07933d04903bd9be39"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
