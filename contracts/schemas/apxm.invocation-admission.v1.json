{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.invocation-admission.v1",
  "title": "APXM Invocation Admission",
  "description": "Exact product-neutral authority for one canonical runtime invocation.",
  "type": "object",
  "required": ["schema_version", "invocation_id", "artifact_digest", "release_digest", "port_bindings_digest", "resource_ceiling_digest", "provenance_digest"],
  "properties": {
    "schema_version": {"const": "apxm.invocation-admission.v1"},
    "invocation_id": {"$ref": "#/$defs/Identifier"},
    "artifact_digest": {"$ref": "#/$defs/Digest"},
    "release_digest": {"$ref": "#/$defs/Digest"},
    "port_bindings_digest": {"$ref": "#/$defs/Digest"},
    "resource_ceiling_digest": {"$ref": "#/$defs/Digest"},
    "provenance_digest": {"$ref": "#/$defs/Digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "Identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"},
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
