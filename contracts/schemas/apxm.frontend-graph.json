{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.frontend-graph",
  "title": "FrontendGraph",
  "description": "Language-neutral typed source graph emitted equivalently by the Python and TypeScript source-first frontends. It records typed declarations and bindings, typed values, blocks, regions, data edges, explicit context/state edges, discriminated typed source intents for the model/capability/program/event effects, language-neutral structural control-flow intents, static Hook bindings, exact requirements, digests, and a source map. It carries typed source intent only: it never contains an AIR/AIS operation string, an ais.* kind, an untyped operand bag, runtime placement, credentials, grants, or dynamic registration. Rust alone selects AIS operations from these intents.",
  "type": "object",
  "required": [
    "schema_version",
    "source_language",
    "program_definitions",
    "imported_program_refs",
    "declarations",
    "functions",
    "values",
    "blocks",
    "regions",
    "data_edges",
    "call_intents",
    "control_intents",
    "context_flow",
    "hook_bindings",
    "capability_requirements",
    "model_requirements",
    "source_map"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.frontend-graph"
    },
    "source_language": {
      "type": "string",
      "enum": [
        "python",
        "typescript"
      ]
    },
    "program_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ProgramDefinition"
      }
    },
    "imported_program_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportedProgramRef"
      }
    },
    "declarations": {
      "type": "array",
      "description": "Typed source declarations and bindings resolved by imported symbol identity: Context schema, Model binding, Tool binding/handler, Capability binding/handler, Event type.",
      "items": {
        "$ref": "#/$defs/Declaration"
      }
    },
    "functions": {
      "type": "array",
      "description": "Typed entrypoint and helper functions with typed parameters and a body region.",
      "items": {
        "$ref": "#/$defs/FunctionDef"
      }
    },
    "values": {
      "type": "array",
      "description": "Typed SSA-precursor values produced by parameters, declarations, call-intent results, block arguments, and structural joins. Every value has one typed origin.",
      "items": {
        "$ref": "#/$defs/Value"
      }
    },
    "blocks": {
      "type": "array",
      "description": "Basic blocks with typed block arguments, contained in a region.",
      "items": {
        "$ref": "#/$defs/Block"
      }
    },
    "regions": {
      "type": "array",
      "description": "Lexical regions (function body, conditional arms, loop body, task scope, try/catch). A region owns blocks; Rust reconstructs CFG/SSA and structural AIS from them. This is source lexical structure, not an ais.* kind.",
      "items": {
        "$ref": "#/$defs/Region"
      }
    },
    "data_edges": {
      "type": "array",
      "description": "Typed def-use edges from a producing value to a consuming intent operand or block-argument slot.",
      "items": {
        "$ref": "#/$defs/DataEdge"
      }
    },
    "call_intents": {
      "type": "array",
      "description": "Discriminated typed effect intents. Rust selects exactly one of the five AIS semantic operations from each; a Tool invocation and an advanced Capability invocation are distinct intents that both converge to capability.invoke.",
      "items": {
        "$ref": "#/$defs/CallIntent"
      }
    },
    "control_intents": {
      "type": "array",
      "description": "Discriminated language-neutral structural intents: conditional, loop, task-scope, try/catch, yield, return. Rust constructs the closed structural AIS family from these; source never names ais.loop or any ais.* kind.",
      "items": {
        "$ref": "#/$defs/ControlIntent"
      }
    },
    "context_flow": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextEdge"
      }
    },
    "hook_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HookBinding"
      }
    },
    "capability_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CapabilityRequirement"
      }
    },
    "model_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModelRequirement"
      }
    },
    "source_map": {
      "$ref": "apxm.source-map#/$defs/SourceMapBody"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ProgramDefinition": {
      "type": "object",
      "required": [
        "program_id",
        "entrypoint",
        "input_type_ref",
        "output_type_ref",
        "has_default_context"
      ],
      "properties": {
        "program_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "entrypoint": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "input_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "output_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "context_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "has_default_context": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ImportedProgramRef": {
      "type": "object",
      "required": [
        "program_ref",
        "artifact_digest",
        "entrypoint",
        "target_agent_identity_requirement"
      ],
      "properties": {
        "program_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "artifact_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "entrypoint": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "target_agent_identity_requirement": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" }
      },
      "additionalProperties": false
    },
    "Declaration": {
      "type": "object",
      "description": "One typed source declaration or binding. `decl_kind` discriminates the role; friendly names (Context/Model/Tool/Capability/Event) map to these bound nodes.",
      "required": [
        "decl_id",
        "decl_kind",
        "input_type_ref",
        "output_type_ref"
      ],
      "properties": {
        "decl_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "decl_kind": {
          "type": "string",
          "enum": [
            "context",
            "model_binding",
            "tool_binding",
            "capability_binding",
            "event_type"
          ]
        },
        "input_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "output_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "target_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier",
          "description": "Exact external reference for a binding (ModelTargetRef, CapabilityRef, EventRef)."
        },
        "context_default_present": {
          "type": "boolean",
          "description": "For decl_kind=context, whether a typed default initializer is present."
        }
      },
      "additionalProperties": false
    },
    "FunctionDef": {
      "type": "object",
      "required": [
        "function_id",
        "parameters",
        "body_region_id",
        "is_entrypoint"
      ],
      "properties": {
        "function_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/Parameter" }
        },
        "result_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "body_region_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "is_entrypoint": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "Parameter": {
      "type": "object",
      "required": ["value_id", "type_ref", "role"],
      "properties": {
        "value_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "role": {
          "type": "string",
          "enum": ["agent_facade", "input", "context", "ordinary"]
        }
      },
      "additionalProperties": false
    },
    "Value": {
      "type": "object",
      "description": "One typed value with exactly one typed origin.",
      "required": ["value_id", "type_ref", "origin"],
      "properties": {
        "value_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "origin": {
          "type": "string",
          "enum": [
            "parameter",
            "call_result",
            "block_argument",
            "context_value",
            "literal",
            "resume_input"
          ]
        },
        "origin_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier",
          "description": "The id of the producing parameter, call_intent, block, or context edge."
        },
        "expression": { "$ref": "#/$defs/ValueExpression" }
      },
      "additionalProperties": false
    },
    "ValueExpression": {
      "oneOf": [
        { "$ref": "#/$defs/SsaExpression" },
        { "$ref": "#/$defs/ContextExpression" },
        { "$ref": "#/$defs/ProjectionExpression" },
        { "$ref": "#/$defs/ObjectExpression" },
        { "$ref": "#/$defs/ArrayExpression" },
        { "$ref": "#/$defs/StringExpression" },
        { "$ref": "#/$defs/IntegerExpression" },
        { "$ref": "#/$defs/BooleanExpression" },
        { "$ref": "#/$defs/NullExpression" }
      ]
    },
    "SsaExpression": {
      "type": "object", "required": ["kind", "value_id"],
      "properties": { "kind": { "const": "ssa" }, "value_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" } },
      "additionalProperties": false
    },
    "ContextExpression": {
      "type": "object", "required": ["kind", "property_path"],
      "properties": { "kind": { "const": "context" }, "property_path": { "$ref": "#/$defs/PropertyPath" } },
      "additionalProperties": false
    },
    "ProjectionExpression": {
      "type": "object", "required": ["kind", "root", "property_path"],
      "properties": { "kind": { "const": "projection" }, "root": { "$ref": "#/$defs/ValueExpression" }, "property_path": { "$ref": "#/$defs/NonEmptyPropertyPath" } },
      "additionalProperties": false
    },
    "ObjectExpression": {
      "type": "object", "required": ["kind", "fields"],
      "properties": { "kind": { "const": "object" }, "fields": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/ValueField" } } },
      "additionalProperties": false
    },
    "ValueField": {
      "type": "object", "required": ["name", "value"],
      "properties": { "name": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,128}$" }, "value": { "$ref": "#/$defs/ValueExpression" } },
      "additionalProperties": false
    },
    "ArrayExpression": {
      "type": "object", "required": ["kind", "items"],
      "properties": { "kind": { "const": "array" }, "items": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/ValueExpression" } } },
      "additionalProperties": false
    },
    "StringExpression": {
      "type": "object", "required": ["kind", "value"],
      "properties": { "kind": { "const": "string" }, "value": { "type": "string", "maxLength": 1048576 } },
      "additionalProperties": false
    },
    "IntegerExpression": {
      "type": "object", "required": ["kind", "value"],
      "properties": { "kind": { "const": "integer" }, "value": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 } },
      "additionalProperties": false
    },
    "BooleanExpression": {
      "type": "object", "required": ["kind", "value"],
      "properties": { "kind": { "const": "boolean" }, "value": { "type": "boolean" } },
      "additionalProperties": false
    },
    "NullExpression": {
      "type": "object", "required": ["kind"],
      "properties": { "kind": { "const": "null" } },
      "additionalProperties": false
    },
    "Block": {
      "type": "object",
      "required": ["block_id", "region_id", "block_arguments", "execution_order"],
      "properties": {
        "block_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "region_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "block_arguments": {
          "type": "array",
          "items": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" }
        },
        "execution_order": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "Region": {
      "type": "object",
      "description": "A lexical region. `region_role` is source structure, not an AIS op kind; Rust maps it to structural AIS.",
      "required": ["region_id", "region_role", "execution_order"],
      "properties": {
        "region_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "region_role": {
          "type": "string",
          "enum": [
            "function_body",
            "conditional_arm",
            "loop_body",
            "task_scope",
            "task_child",
            "try_body",
            "catch_body",
            "hook_body"
          ]
        },
        "parent_region_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "execution_order": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "DataEdge": {
      "type": "object",
      "description": "A typed def-use edge from a producing value to a consuming operand slot.",
      "required": ["from_value", "to_consumer", "consumer_slot"],
      "properties": {
        "from_value": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "to_consumer": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier",
          "description": "The consuming call_intent, control_intent, or block id."
        },
        "consumer_slot": {
          "type": "string",
          "description": "The named typed operand slot on the consumer. Lowering carries it into `apxm.air#/$defs/Operand.slot`, which states the closed set."
        }
      },
      "additionalProperties": false
    },
    "CallIntent": {
      "type": "object",
      "description": "One discriminated typed effect intent. `intent_kind` names the SOURCE role; Rust maps it to an AIR/AIS operation. There is no AIR/AIS string here.",
      "required": ["node_id", "intent_kind", "parent_region_id", "execution_order"],
      "properties": {
        "node_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "intent_kind": {
          "type": "string",
          "enum": [
            "model_invocation",
            "tool_invocation",
            "capability_invocation",
            "agent_creation",
            "agent_invocation",
            "event_wait"
          ]
        },
        "parent_region_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "execution_order": { "type": "integer", "minimum": 0 },
        "binding_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier",
          "description": "The declaration or imported-program id this intent invokes."
        },
        "receiver_kind": {
          "type": "string",
          "enum": ["program_ref", "program_instance_ref"],
          "description": "Present only for agent_invocation: distinguishes one-shot from stateful receiver."
        },
        "operand_values": {
          "type": "array",
          "description": "Ordered typed value ids consumed as this intent's operands; slot identity is carried by matching data_edges.",
          "items": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" }
        },
        "result_value": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier",
          "description": "The typed value produced by this intent, if any."
        }
      },
      "additionalProperties": false
    },
    "ControlIntent": {
      "type": "object",
      "description": "One discriminated language-neutral structural intent. Rust constructs structural AIS (branch/switch/ais.loop/parallel_join/try/throw/catch/yield/return) from these.",
      "required": ["node_id", "control_kind", "parent_region_id", "execution_order"],
      "properties": {
        "node_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "control_kind": {
          "type": "string",
          "enum": [
            "conditional",
            "switch",
            "loop",
            "task_group",
            "try_catch",
            "throw",
            "yield",
            "return"
          ]
        },
        "parent_region_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "execution_order": { "type": "integer", "minimum": 0 },
        "body_region_ids": {
          "type": "array",
          "description": "The lexical regions this control intent owns (arms, loop body, task children, try/catch bodies).",
          "items": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" }
        },
        "predicate": {
          "$ref": "#/$defs/ControlPredicate",
          "description": "Closed typed source predicate over one prior value."
        },
        "operand_values": {
          "type": "array",
          "description": "Typed value ids consumed (condition, switch scrutinee, carried loop values, yielded output, returned output).",
          "items": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" }
        },
        "result_value": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier",
          "description": "The typed value produced (e.g. a yield resume input); absent for return."
        }
      },
      "additionalProperties": false
    },
    "ControlPredicate": {
      "oneOf": [
        { "$ref": "#/$defs/TruthyPredicate" },
        { "$ref": "#/$defs/EqualsPredicate" },
        { "$ref": "#/$defs/NotEqualsPredicate" }
      ]
    },
    "TruthyPredicate": {
      "type": "object",
      "required": ["root_value_id", "property_path", "comparator"],
      "properties": {
        "root_value_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "property_path": { "$ref": "#/$defs/PropertyPath" },
        "comparator": { "const": "truthy" }
      },
      "additionalProperties": false
    },
    "EqualsPredicate": {
      "type": "object",
      "required": ["root_value_id", "property_path", "comparator", "literal"],
      "properties": {
        "root_value_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "property_path": { "$ref": "#/$defs/PropertyPath" },
        "comparator": { "const": "equals" },
        "literal": { "$ref": "#/$defs/PredicateLiteral" }
      },
      "additionalProperties": false
    },
    "NotEqualsPredicate": {
      "type": "object",
      "required": ["root_value_id", "property_path", "comparator", "literal"],
      "properties": {
        "root_value_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "property_path": { "$ref": "#/$defs/PropertyPath" },
        "comparator": { "const": "not_equals" },
        "literal": { "$ref": "#/$defs/PredicateLiteral" }
      },
      "additionalProperties": false
    },
    "PropertyPath": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,128}$" }
    },
    "NonEmptyPropertyPath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,128}$" }
    },
    "PredicateLiteral": {
      "oneOf": [
        {
          "type": "object",
          "required": ["scalar_type", "value"],
          "properties": { "scalar_type": { "const": "boolean" }, "value": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["scalar_type", "value"],
          "properties": { "scalar_type": { "const": "string" }, "value": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["scalar_type", "value"],
          "properties": { "scalar_type": { "const": "integer" }, "value": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["scalar_type"],
          "properties": { "scalar_type": { "const": "null" } },
          "additionalProperties": false
        }
      ]
    },
    "ContextEdge": {
      "type": "object",
      "required": ["from_node", "to_node", "context_type_ref", "value_id"],
      "properties": {
        "from_node": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "to_node": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "context_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "value_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" }
      },
      "additionalProperties": false
    },
    "HookBinding": {
      "type": "object",
      "required": [
        "hook_id",
        "scope",
        "phase",
        "target_selector",
        "declaration_order",
        "handler_ref",
        "handler_digest",
        "input_type_ref",
        "output_type_ref",
        "return_mode",
        "body_region_id"
      ],
      "properties": {
        "hook_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "scope": {
          "type": "string",
          "enum": ["agent", "loop", "node", "model", "capability"]
        },
        "phase": { "type": "string", "enum": ["before", "after"] },
        "target_selector": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "declaration_order": { "type": "integer", "minimum": 0 },
        "handler_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "handler_digest": { "$ref": "apxm.contract-common.v1#/$defs/Digest" },
        "input_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "output_type_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "return_mode": {
          "type": "string",
          "enum": ["observe", "replace_result"],
          "description": "Derived from the captured Hook body, never from an unchecked author assertion: a body that assigns Context is replace_result, a body that mutates nothing is observe. An observe Hook that mutates Context or the target result is refused at execution."
        },
        "body_region_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier",
          "description": "The lexical region holding this Hook's captured body. The body is ordinary captured source — its Model and Capability calls are the same typed intents an Agent body records — so a Hook's effects stay visible at the compiler boundary instead of hiding behind a digest-referenced handler."
        },
        "assigned_context_value_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier",
          "description": "The typed Context value the captured body assigns. Present exactly when return_mode is replace_result."
        }
      },
      "additionalProperties": false
    },
    "CapabilityRequirement": {
      "type": "object",
      "description": "One authored Capability declaration. A program may declare the same capability_ref more than once — once as a Tool and once as a plain Capability, for instance — so each declaration is its own record and the array is not keyed by capability_ref.",
      "required": ["capability_ref"],
      "properties": {
        "capability_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
        "tool_schema_present": {
          "type": "boolean",
          "description": "True when this requirement is surfaced to a model as a typed Tool schema."
        },
        "requested_permission": {
          "$ref": "#/$defs/PermissionDecision",
          "description": "The permission decision this declaration requests for the capability, carried verbatim from authored source into the digest-bound source bundle. Absent when the author requested none. It records an authored request only: it grants no authority, and the resolution layer stack may narrow it but may never widen it."
        }
      },
      "additionalProperties": false
    },
    "PermissionDecision": {
      "description": "The closed permission decision, optionally carrying why it was made. A decision with no reason is the bare vocabulary string it has always been; a decision that explains itself is the object form.",
      "oneOf": [
        { "type": "string", "enum": ["allow", "ask", "deny"] },
        {
          "type": "object",
          "required": ["decision", "reason"],
          "properties": {
