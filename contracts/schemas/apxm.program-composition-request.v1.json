{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.program-composition-request.v1",
  "title": "ProgramCompositionRequest",
  "description": "One exact program.new, program.invoke, or instance.invoke request carrying a typed receiver.",
  "type": "object",
  "required": ["node_id", "receiver"],
  "properties": {
    "node_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
    "receiver": { "$ref": "#/$defs/Receiver" }
  },
  "additionalProperties": false,
  "$defs": {
    "Receiver": {
      "oneOf": [
        {
          "type": "object",
          "required": ["program"],
          "properties": {
            "program": {
              "type": "object",
              "required": ["program_ref"],
              "properties": { "program_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["instance"],
          "properties": {
            "instance": {
              "type": "object",
              "required": ["program_instance_ref"],
              "properties": { "program_instance_ref": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
