{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.runtime-evidence",
  "title": "RuntimeEvidence",
  "description": "Append-only sequence of monotonic authoritative facts for one Program Instance and its Invocations: creation, admission, child attach, attempt, park/event, commit, failure/cancellation, terminal, and delivery. Lifecycle truth is reconstructed from the latest scoped state fact; a trace, stream, socket close, or delivery record cannot override it, and an uncertain external effect never silently becomes success.",
  "type": "object",
  "required": [
    "schema_version",
    "program_identity",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.runtime-evidence"
    },
    "program_identity": {
      "$ref": "#/$defs/ProgramIdentity"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Fact"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ProgramIdentity": {
      "type": "object",
      "required": [
        "artifact_digest",
        "entrypoint",
        "agent_identity_binding"
      ],
      "properties": {
        "artifact_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "entrypoint": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "agent_identity_binding": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "program_instance_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "Fact": {
      "oneOf": [
        {
          "$ref": "#/$defs/LoopIterationCompletedFact"
        },
        {
          "$ref": "#/$defs/NodeExecutionRecordedFact"
        },
        {
          "$ref": "#/$defs/ModelAttemptRecordedFact"
        },
        {
          "$ref": "#/$defs/RuntimeFact"
        }
      ]
    },
    "LoopIterationCompletedFact": {
      "type": "object",
      "required": [
        "fact_id",
        "event_sequence",
        "fact_kind",
        "static_loop_id",
        "loop_occurrence_id",
        "iteration_index",
        "program_invocation_id",
        "causal_node_execution_ids"
      ],
      "properties": {
        "fact_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "fact_kind": {
          "const": "LoopIterationCompleted"
        },
        "static_loop_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "loop_occurrence_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "iteration_index": {
          "type": "integer",
          "minimum": 0
        },
        "program_invocation_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "causal_node_execution_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "apxm.contract-common.v1#/$defs/Identifier"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "RuntimeFact": {
      "type": "object",
      "required": [
        "fact_id",
        "event_sequence",
        "fact_kind"
      ],
      "properties": {
        "fact_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "fact_kind": {
          "type": "string",
          "enum": [
            "instance.state_changed",
            "invocation.state_changed",
            "instance.created",
            "invocation.admitted",
            "child.attached",
            "invocation.attempt_recorded",
            "capability.attempt_recorded",
            "invocation.committed",
            "invocation.failed",
            "invocation.cancelled",
            "event.created",
            "event.await_registered",
            "invocation.parked",
            "event.terminal",
            "invocation.resumed",
            "instance.closed",
            "instance.cancelled",
            "effect.outcome_unknown",
            "delivery.recorded",
            "region.occurrence_started",
            "hook.executed",
            "context.transitioned"
          ]
        },
        "ownership_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "instance_state": {
          "type": "string",
          "enum": [
            "admission_pending",
            "ready",
            "invoking",
            "completed",
            "closing",
            "closed",
            "cancelling",
            "cancelled"
          ]
        },
        "invocation_state": {
          "type": "string",
          "enum": [
            "admission_pending",
            "running",
            "waiting_event",
            "committed_yield",
            "committed_return",
            "failed",
            "cancelling",
            "cancelled",
            "cancellation_unconfirmed"
          ]
        },
        "event_state": {
          "type": "string",
          "enum": [
            "pending",
            "fulfilled",
            "expired",
            "cancelled"
          ]
        },
        "model_outcome": {
          "type": "string",
          "enum": [
            "committed_success",
            "typed_failure",
            "cancelled",
            "model_outcome_unknown"
          ]
        },
        "commit_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "node_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "attempt_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "region_occurrence_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "static_region_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "loop_memberships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoopMembership"
          },
          "uniqueItems": true
        },
        "air_node_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "parent_node_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "hook_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "hook_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "hook_scope": {
          "type": "string",
          "enum": [
            "agent",
            "loop",
            "node",
            "model",
            "capability"
          ]
        },
        "hook_phase": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ]
        },
        "context_transition_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "context_before_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
        },
        "context_after_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
        },
        "effect_outcome_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
        },
        "typed_error": {
          "$ref": "apxm.contract-common.v1#/$defs/TypedErrorEnvelope"
        }
      },
      "additionalProperties": false
    },
    "NodeExecutionRecordedFact": {
      "type": "object",
      "required": [
        "fact_id",
        "event_sequence",
        "fact_kind",
        "program_invocation_id",
        "node_execution_id",
        "air_node_id",
        "execution_scope"
      ],
      "properties": {
        "fact_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "fact_kind": {
          "const": "node_execution.recorded"
        },
        "program_invocation_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "node_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "air_node_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "parent_node_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "execution_scope": {
          "$ref": "#/$defs/NodeExecutionScope"
        }
      },
      "additionalProperties": false
    },
    "ModelAttemptRecordedFact": {
      "type": "object",
      "required": [
        "fact_id",
        "event_sequence",
        "fact_kind",
        "program_invocation_id",
        "node_execution_id",
        "air_node_id",
        "attempt_id",
        "attempt_index",
        "model_effect_id",
        "request_digest",
        "model_target_ref",
        "model_target_digest",
        "model_deployment_ref",
        "exact_port_binding_digest",
        "target_commitment_digest",
        "generation_cohort_digest",
        "target_generation",
        "target_port_contract_digest",
        "target_composition_digest",
        "native_input_tokens",
        "native_output_tokens"
      ],
      "properties": {
        "fact_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "fact_kind": {
          "const": "attempt.recorded"
        },
        "program_invocation_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "node_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "air_node_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "attempt_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 0
        },
        "model_effect_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "model_target_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "model_target_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "model_deployment_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "exact_port_binding_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "target_commitment_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "generation_cohort_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "target_generation": {
          "type": "integer",
          "minimum": 0
        },
        "target_port_contract_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "target_composition_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "native_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "native_output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "NodeExecutionScope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "scope_kind"
          ],
          "properties": {
            "scope_kind": {
              "const": "non_loop"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "scope_kind",
            "region_occurrence_id",
            "static_region_id",
            "loop_memberships"
          ],
          "properties": {
            "scope_kind": {
              "const": "loop"
            },
            "region_occurrence_id": {
              "$ref": "apxm.contract-common.v1#/$defs/Identifier"
            },
            "static_region_id": {
              "$ref": "apxm.contract-common.v1#/$defs/Identifier"
            },
            "loop_memberships": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/LoopMembership"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "LoopMembership": {
      "type": "object",
      "required": [
        "static_loop_id",
        "loop_occurrence_id"
      ],
      "properties": {
        "static_loop_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "loop_occurrence_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    }
  }
}
