{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.durable-event-outcome",
  "title": "DurableEventOutcome",
  "description": "The closed outcome of waiting for one exact durable Event Reference.",
  "oneOf": [
    {
      "type": "object",
      "required": ["fulfilled"],
      "properties": {
        "fulfilled": {
          "type": "object",
          "required": ["event_ref", "payload"],
          "properties": {
            "event_ref": { "$ref": "apxm.durable-event-request#/$defs/EventRef" },
            "payload": { "type": "string", "maxLength": 1048576 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    { "const": "parked" },
    { "const": "expired" },
    { "const": "cancelled" },
    {
      "type": "object",
      "required": ["mismatched"],
      "properties": {
        "mismatched": {
          "type": "object",
          "required": ["delivered_event_ref"],
          "properties": {
            "delivered_event_ref": { "$ref": "apxm.durable-event-request#/$defs/EventRef" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["rejected"],
      "properties": {
        "rejected": {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "reason": {
              "enum": [
                "unknown_reference",
                "owner_mismatch",
                "contract_mismatch",
                "already_bound",
                "invalid_payload"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
