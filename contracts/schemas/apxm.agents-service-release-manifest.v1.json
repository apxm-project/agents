{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.agents-service-release-manifest.v1",
  "title": "AgentsServiceReleaseManifest",
  "description": "Content-addressed APXM Compilation and Runtime service release manifest.",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_owner",
    "source_revision",
    "artifact_kind",
    "services",
    "schemas",
    "frontend_native",
    "owner_descriptor_digest",
    "integrity_algorithm"
  ],
  "properties": {
    "schema_version": {"const": "apxm.agents-service-release-manifest.v1"},
    "semantic_owner": {"const": "agents"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_kind": {"const": "compilation-runtime-services"},
    "services": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "path", "digest"],
        "properties": {
          "name": {"enum": ["compilation-service", "runtime-service"]},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "schemas": {
      "description": "Every contract schema this release ships, so a consumer pins the wire contracts the same way it pins the service bytes.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "path", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^contracts/schemas/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "frontend_native": {
      "type": "object",
      "required": ["name", "path", "digest"],
      "properties": {
        "name": {"const": "python-frontend-native"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "owner_descriptor_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "integrity_algorithm": {"const": "sha256"}
  },
  "additionalProperties": false
}
