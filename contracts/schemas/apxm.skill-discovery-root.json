{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.skill-discovery-root",
  "title": "SkillDiscoveryRoot",
  "description": "Canonical metadata-only discovery root for visible Agent Skill packages. It publishes discovery cards, exact package and instruction digests, and scope tier metadata without embedding instruction bodies, activating instructions, minting authority, or referencing downstream product configuration.",
  "type": "object",
  "required": [
    "schema_version",
    "root_id",
    "root_tier",
    "root_ref",
    "discovery_mode",
    "skill_cards",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.skill-discovery-root"
    },
    "root_id": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "root_tier": {
      "type": "string",
      "enum": [
        "global",
        "project",
        "local"
      ]
    },
    "root_ref": {
      "$ref": "apxm.contract-common.v1#/$defs/NonEmptyReference"
    },
    "discovery_mode": {
      "const": "metadata_only"
    },
    "skill_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SkillCard"
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "body_loaded_on_call",
        "activates_on_listing",
        "mutates_authority"
      ],
      "properties": {
        "body_loaded_on_call": {
          "const": true
        },
        "activates_on_listing": {
          "const": false
        },
        "mutates_authority": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SkillCard": {
      "type": "object",
      "required": [
        "skill_id",
        "library_id",
        "package_digest",
        "instruction_digest",
        "name",
        "description",
        "when_to_use",
        "tags",
        "imports",
        "shared"
      ],
      "properties": {
        "skill_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "library_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "package_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "instruction_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "when_to_use": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "apxm.contract-common.v1#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "apxm.contract-common.v1#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "shared": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
