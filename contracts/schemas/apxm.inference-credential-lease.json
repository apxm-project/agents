{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.inference-credential-lease",
  "title": "InferenceCredentialLeaseIdentity",
  "description": "Public identity of one short-lived, target- and purpose-bound inference credential lease. Secret material never appears in this contract, in artifacts, logs, metrics, traces, or checkpoints. Material exists only in adapter memory for the lease scope.",
  "type": "object",
  "required": [
    "schema_version",
    "lease_id",
    "purpose",
    "model_target_ref",
    "exact_port_binding_digest",
    "expires_at_unix_ms",
    "lease_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.inference-credential-lease"
    },
    "lease_id": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "model_inference"
      ]
    },
    "model_target_ref": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "exact_port_binding_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "expires_at_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "lease_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    }
  },
  "additionalProperties": false
}
