{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.model-target.v1",
  "title": "ModelTarget",
  "description": "Portable, content-addressed model.call target requirement authored by one model effect. It pins one exact model, checkpoint, and configuration identity and its deployment-eligibility contract. It carries no endpoint, credential, mutable alias, or environment placement; deployment composition maps it to exactly one Model Deployment and admission materializes one resolved binding without candidate search.",
  "type": "object",
  "required": [
    "schema_version",
    "target_ref",
    "model_identity_digest",
    "configuration_digest",
    "eligibility",
    "target_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.model-target.v1"
    },
    "target_ref": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "model_identity_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "configuration_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "eligibility": {
      "$ref": "#/$defs/DeploymentEligibility"
    },
    "target_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DeploymentEligibility": {
      "type": "object",
      "description": "The content-addressed eligibility contract a Model Deployment must satisfy to serve this target. It states requirements only; it names no deployment, endpoint, or credential.",
      "required": [
        "locality",
        "required_capabilities",
        "minimum_context_tokens"
      ],
      "properties": {
        "locality": {
          "type": "string",
          "enum": [
            "any",
            "local",
            "remote"
          ]
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "tools",
              "structured_output",
              "thinking",
              "vision"
            ]
          }
        },
        "minimum_context_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
