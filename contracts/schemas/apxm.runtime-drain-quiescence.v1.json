{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.runtime-drain-quiescence.v1",
  "title": "APXM Runtime Drain and Quiescence",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "readiness_contract",
    "admission_contract",
    "drain",
    "quiescence",
    "cancellation",
    "recovery"
  ],
  "properties": {
    "schema_version": {"const": "apxm.runtime-drain-quiescence.v1"},
    "contract_id": {"const": "apxm.runtime-drain-quiescence.v1"},
    "readiness_contract": {"const": "apxm.runtime-readiness.v1"},
    "admission_contract": {"const": "apxm.invocation-admission.v1"},
    "drain": {
      "type": "object",
      "required": ["transition", "admission_window", "rejection_code"],
      "properties": {
        "transition": {"const": "stop_admission_then_finish_in_flight"},
        "admission_window": {"const": "closed_before_dispatch"},
        "rejection_code": {"const": "host_not_accepting"}
      },
      "additionalProperties": false
    },
    "quiescence": {
      "type": "object",
      "required": ["readiness_state", "in_flight", "durable_no_work_truth"],
      "properties": {
        "readiness_state": {"const": "stopped"},
        "in_flight": {"const": 0},
        "durable_no_work_truth": {"const": "forbidden"}
      },
      "additionalProperties": false
    },
    "cancellation": {
      "type": "object",
      "required": ["before_admission", "in_flight"],
      "properties": {
        "before_admission": {"const": "cancelled_before_admission"},
        "in_flight": {"const": "cancellation_unconfirmed"}
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["restart", "without_runtime_evidence", "with_runtime_evidence"],
      "properties": {
        "restart": {"const": "reconcile_from_runtime_evidence"},
        "without_runtime_evidence": {"const": "no_runtime_evidence"},
        "with_runtime_evidence": {"const": "reconciled"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
