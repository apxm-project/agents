{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.external-agent-evidence",
  "title": "ExternalAgentEvidence",
  "description": "Ordered attributed nested evidence for one External Agent prompt effect. Every event nests under exactly one outer capability.invoke NodeExecution; the peer's private model and tool cycles are attribution only and are never native model NodeExecutions or authored loop occurrences. Peer usage is third-party provenance preserved verbatim with its own scope, precision, and availability, and never enters native model accounting.",
  "type": "object",
  "required": [
    "schema_version",
    "capability_node_execution_id",
    "session_ref",
    "attributed_events",
    "peer_usage"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.external-agent-evidence"
    },
    "capability_node_execution_id": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "session_ref": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "attributed_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AttributedEvent"
      }
    },
    "peer_usage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PeerUsage"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AttributedEvent": {
      "type": "object",
      "required": [
        "event_sequence",
        "kind"
      ],
      "properties": {
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "message",
            "plan",
            "tool_call",
            "reverse_request"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 4096
        },
        "reverse_operation": {
          "type": "string",
          "maxLength": 256
        },
        "reverse_target": {
          "type": "string",
          "maxLength": 1024
        },
        "reverse_decision": {
          "type": "string",
          "enum": [
            "permit",
            "deny_missing_authority",
            "deny_ceiling_exceeded",
            "deny_policy"
          ]
        }
      },
      "additionalProperties": false
    },
    "PeerUsage": {
      "type": "object",
      "required": [
        "reported_by",
        "metric_scope",
        "reported_value"
      ],
      "properties": {
        "reported_by": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "metric_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reported_value": {
          "type": "string",
          "maxLength": 1024
        },
        "availability_partial": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
