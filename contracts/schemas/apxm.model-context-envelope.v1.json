{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.model-context-envelope.v1",
  "title": "ModelContextEnvelope",
  "description": "Sealed host-assembled model-call context. Ordered layers carry typed provenance, trust, redaction, and token accounting. Frames are either exact prompt content or durable reference-only data; references never acquire instruction authority.",
  "type": "object",
  "required": [
    "schema_version",
    "context_id",
    "invocation_id",
    "policy_ref",
    "layers",
    "frames",
    "tool_schemas",
    "model_requirements",
    "sealed_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.model-context-envelope.v1"
    },
    "context_id": {
      "$ref": "apxm.runtime-common.v1#/$defs/Identifier"
    },
    "invocation_id": {
      "$ref": "apxm.runtime-common.v1#/$defs/Identifier"
    },
    "policy_ref": {
      "$ref": "apxm.runtime-common.v1#/$defs/NonEmptyReference"
    },
    "layers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/ContextLayer"
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextFrame"
      }
    },
    "tool_schemas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolSchema"
      }
    },
    "model_requirements": {
      "$ref": "apxm.runtime-common.v1#/$defs/ModelRequirements"
    },
    "sealed_digest": {
      "$ref": "apxm.runtime-common.v1#/$defs/Digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ContextLayer": {
      "type": "object",
      "required": [
        "kind",
        "position",
        "provenance_ref",
        "trust",
        "redaction",
        "token_budget",
        "token_cost",
        "frame_ids"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ContextLayerKind"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_ref": {
          "$ref": "apxm.runtime-common.v1#/$defs/NonEmptyReference"
        },
        "trust": {
          "$ref": "#/$defs/ContextTrust"
        },
        "redaction": {
          "$ref": "#/$defs/ContextRedaction"
        },
        "token_budget": {
          "type": "integer",
          "minimum": 0
        },
        "token_cost": {
          "type": "integer",
          "minimum": 0
        },
        "frame_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "apxm.runtime-common.v1#/$defs/Identifier"
          }
        }
      },
      "additionalProperties": false
    },
    "ContextLayerKind": {
      "type": "string",
      "enum": [
        "platform_policy",
        "agent_instructions",
        "developer_instructions",
        "selected_skill_instructions",
        "session_and_memory_data",
        "current_input",
        "tool_results"
      ]
    },
    "ContextTrust": {
      "type": "string",
      "enum": [
        "platform_instruction",
        "agent_instruction",
        "developer_instruction",
        "selected_skill_instruction",
        "trusted_policy_hook",
        "data",
        "tool_result"
      ]
    },
    "ContextRedaction": {
      "type": "string",
      "enum": [
        "public",
        "sensitive",
        "secret_ref",
        "redacted"
      ]
    },
    "ContextFrameDisposition": {
      "type": "string",
      "enum": [
        "prompt",
        "reference"
      ]
    },
    "ContextFrame": {
      "type": "object",
      "required": [
        "frame_id",
        "layer",
        "role",
        "source_ref",
        "digest",
        "trust",
        "redaction",
        "scope",
        "truncation",
        "token_cost",
        "content_ref",
        "disposition"
      ],
      "properties": {
        "frame_id": {
          "$ref": "apxm.runtime-common.v1#/$defs/Identifier"
        },
        "layer": {
          "$ref": "#/$defs/ContextLayerKind"
        },
        "role": {
          "type": "string",
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ]
        },
        "source_ref": {
          "$ref": "apxm.runtime-common.v1#/$defs/NonEmptyReference"
        },
        "digest": {
          "$ref": "apxm.runtime-common.v1#/$defs/Digest"
        },
        "trust": {
          "$ref": "#/$defs/ContextTrust"
        },
        "redaction": {
          "$ref": "#/$defs/ContextRedaction"
        },
        "scope": {
          "type": "string",
          "enum": [
            "invocation",
            "session",
            "child",
            "replay"
          ]
        },
        "truncation": {
          "type": "string",
          "enum": [
            "forbidden",
            "deterministic_budget",
            "compact_with_provenance"
          ]
        },
        "token_cost": {
          "type": "integer",
          "minimum": 0
        },
        "content_ref": {
          "$ref": "apxm.runtime-common.v1#/$defs/NonEmptyReference"
        },
        "disposition": {
          "$ref": "#/$defs/ContextFrameDisposition"
        }
      },
      "additionalProperties": false
    },
    "ToolSchema": {
      "type": "object",
      "required": [
        "grant_id",
        "capability_id",
        "schema_ref"
      ],
      "properties": {
        "grant_id": {
          "$ref": "apxm.runtime-common.v1#/$defs/Identifier"
        },
        "capability_id": {
          "$ref": "apxm.runtime-common.v1#/$defs/Identifier"
        },
        "schema_ref": {
          "$ref": "apxm.runtime-common.v1#/$defs/NonEmptyReference"
        }
      },
      "additionalProperties": false
    }
  }
}
