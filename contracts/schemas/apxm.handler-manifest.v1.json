{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.handler-manifest.v1",
  "title": "HandlerManifest",
  "description": "Rust-owned immutable artifact-local handler metadata generated by the TypeScript package-handler build tool. It carries only artifact-local executable source and content-addressed identity; it is never an author-edited protocol, runtime selector, or Python package-local handler shape. A build artifact's handler manifest is decoded and validated against this schema before being trusted as artifact metadata.",
  "type": "object",
  "required": [
    "version",
    "handlers"
  ],
  "properties": {
    "version": {
      "const": "apxm.handler-manifest.v1"
    },
    "handlers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HandlerDescriptor"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "HandlerDescriptor": {
      "description": "One portable tool or hook descriptor. `language` is closed to `typescript`: no Python package-local handler shape is admitted here.",
      "oneOf": [
        {
          "$ref": "#/$defs/ToolHandlerDescriptor"
        },
        {
          "$ref": "#/$defs/HookHandlerDescriptor"
        }
      ]
    },
    "ToolHandlerDescriptor": {
      "type": "object",
      "description": "A capability-addressable tool handler. It must carry an object argument schema and must not carry hook lifecycle fields.",
      "required": [
        "kind",
        "language",
        "handler_id",
        "module",
        "qualname",
        "name",
        "source",
        "schema"
      ],
      "properties": {
        "kind": {
          "const": "tool"
        },
        "language": {
          "$ref": "#/$defs/HandlerLanguage"
        },
        "handler_id": {
          "$ref": "#/$defs/HandlerId"
        },
        "module": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "qualname": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "name": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/HandlerSource"
        },
        "description": {
          "type": "string"
        },
        "schema": {
          "type": "object"
        },
        "read_only": {
          "type": "boolean"
        },
        "requires_approval": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "HookHandlerDescriptor": {
      "type": "object",
      "description": "A lifecycle hook addressed by handler ID. It must carry event, match, and mode, and must not carry tool argument schema or authority fields.",
      "required": [
        "kind",
        "language",
        "handler_id",
        "module",
        "qualname",
        "name",
        "source",
        "event",
        "match",
        "mode"
      ],
      "properties": {
        "kind": {
          "const": "hook"
        },
        "language": {
          "$ref": "#/$defs/HandlerLanguage"
        },
        "handler_id": {
          "$ref": "#/$defs/HandlerId"
        },
        "module": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "qualname": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "name": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/HandlerSource"
        },
        "description": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "observe",
            "gate"
          ]
        }
      },
      "additionalProperties": false
    },
    "HandlerLanguage": {
      "type": "string",
      "enum": [
        "typescript"
      ]
    },
    "HandlerId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "HandlerSource": {
      "type": "object",
      "description": "Artifact-local executable source. `artifact_path` is a relative path confined to the artifact and never a build-host path.",
      "required": [
        "artifact_path",
        "content"
      ],
      "properties": {
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
