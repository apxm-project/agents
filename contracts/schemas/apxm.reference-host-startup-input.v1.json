{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.reference-host-startup-input.v1",
  "title": "APXM Reference Host Startup Input",
  "description": "Exact startup artifact for one reference-host executable over one committed release manifest and explicit admitted digests.",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_owner",
    "owner_executable",
    "owner_executable_path",
    "transport_protocol",
    "reference_host_release_manifest",
    "release_digest",
    "port_bindings_digest",
    "resource_ceiling_digest",
    "provenance",
    "fail_closed_on"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.reference-host-startup-input.v1"
    },
    "semantic_owner": {
      "const": "agents"
    },
    "owner_executable": {
      "const": "apxm-reference-host"
    },
    "owner_executable_path": {
      "const": "crates/tools/cli/src/bin/reference_host.rs"
    },
    "transport_protocol": {
      "const": "jsonl-stdin-stdout"
    },
    "reference_host_release_manifest": {
      "type": "object",
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "release_digest": {
      "$ref": "#/$defs/Digest"
    },
    "port_bindings_digest": {
      "$ref": "#/$defs/Digest"
    },
    "resource_ceiling_digest": {
      "$ref": "#/$defs/Digest"
    },
    "provenance": {
      "type": "object",
      "required": [
        "owner_revision",
        "descriptor_semantic_digest",
        "descriptor_exact_checksum",
        "dirty"
      ],
      "properties": {
        "owner_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "descriptor_semantic_digest": {
          "$ref": "#/$defs/Digest"
        },
        "descriptor_exact_checksum": {
          "$ref": "#/$defs/Digest"
        },
        "dirty": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "fail_closed_on": {
      "const": [
        "missing",
        "placeholder",
        "dirty",
        "mismatched",
        "implicit-default"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
