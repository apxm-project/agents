{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.committed-native-model-usage",
  "title": "CommittedNativeModelUsage",
  "description": "Agents-owned post-commit native model usage measurement. It binds one exact runtime-evidence attempt to the atomic execution commit that made the attempt authoritative. It carries no price, Company, principal, reservation, authorization, or transport policy.",
  "type": "object",
  "required": [
    "schema_version",
    "source_contract_digest",
    "usage_measurement_id",
    "commit_id",
    "evidence_position_ref",
    "attempt"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.committed-native-model-usage"
    },
    "source_contract_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "usage_measurement_id": {
      "description": "Deterministic identity: sha256 of the UTF-8 domain-separated tuple schema_version, commit_id, and attempt.fact_id.",
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "commit_id": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "evidence_position_ref": {
      "$ref": "#/$defs/EvidencePositionRef"
    },
    "attempt": {
      "$ref": "apxm.runtime-evidence#/$defs/ModelAttemptRecordedFact"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "EvidencePositionRef": {
      "type": "object",
      "required": [
        "ref_type",
        "ref"
      ],
      "properties": {
        "ref_type": {
          "const": "EvidencePositionRef"
        },
        "ref": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    }
  }
}
