{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.runtime-evidence.v1",
  "title": "RuntimeEvidence",
  "description": "Append-only sequence of monotonic authoritative facts for one Program Instance and its Invocations: creation, admission, child attach, attempt, park/event, commit, failure/cancellation, terminal, and delivery. Lifecycle truth is reconstructed from the latest scoped state fact; a trace, stream, socket close, or delivery record cannot override it, and an uncertain external effect never silently becomes success.",
  "type": "object",
  "required": [
    "schema_version",
    "program_identity",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.runtime-evidence.v1"
    },
    "program_identity": {
      "$ref": "#/$defs/ProgramIdentity"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Fact"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ProgramIdentity": {
      "type": "object",
      "required": [
        "artifact_digest",
        "entrypoint",
        "agent_identity_binding"
      ],
      "properties": {
        "artifact_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "entrypoint": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "agent_identity_binding": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "program_instance_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "required": [
        "fact_id",
        "event_sequence",
        "fact_kind"
      ],
      "properties": {
        "fact_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "fact_kind": {
          "type": "string",
          "enum": [
            "instance.state_changed",
            "invocation.state_changed",
            "instance.created",
            "invocation.admitted",
            "child.attached",
            "attempt.recorded",
            "invocation.committed",
            "invocation.failed",
            "invocation.cancelled",
            "event.created",
            "event.await_registered",
            "invocation.parked",
            "event.terminal",
            "invocation.resumed",
            "instance.closed",
            "instance.cancelled",
            "effect.outcome_unknown",
            "delivery.recorded",
            "region.occurrence_started",
            "node_execution.recorded",
            "hook.executed",
            "context.transitioned"
          ]
        },
        "ownership_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "instance_state": {
          "type": "string",
          "enum": [
            "admission_pending",
            "ready",
            "invoking",
            "completed",
            "closing",
            "closed",
            "cancelling",
            "cancelled"
          ]
        },
        "invocation_state": {
          "type": "string",
          "enum": [
            "admission_pending",
            "running",
            "waiting_event",
            "committed_yield",
            "committed_return",
            "failed",
            "cancelling",
            "cancelled",
            "cancellation_unconfirmed"
          ]
        },
        "event_state": {
          "type": "string",
          "enum": [
            "pending",
            "fulfilled",
            "expired",
            "cancelled"
          ]
        },
        "model_outcome": {
          "type": "string",
          "enum": [
            "committed_success",
            "typed_failure",
            "cancelled",
            "model_outcome_unknown"
          ]
        },
        "commit_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "node_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "attempt_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "region_occurrence_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "static_region_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "air_node_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "parent_node_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "hook_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "hook_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "hook_scope": {
          "type": "string",
          "enum": [
            "agent",
            "loop",
            "node",
            "model",
            "capability"
          ]
        },
        "hook_phase": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ]
        },
        "context_transition_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "context_before_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
        },
        "context_after_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
        },
        "effect_outcome_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
        },
        "typed_error": {
          "$ref": "apxm.contract-common.v1#/$defs/TypedErrorEnvelope"
        }
      },
      "additionalProperties": false
    }
  }
}
