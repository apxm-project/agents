{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.capability-invocation.v1",
  "title": "CapabilityInvocation",
  "description": "One exact capability.invoke request carrying typed application arguments separately from admitted identity, authority, correlation, and stable effect facts.",
  "type": "object",
  "required": [
    "schema_version",
    "capability_ref",
    "arguments",
    "correlation",
    "authority",
    "effect"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.capability-invocation.v1"
    },
    "capability_ref": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "arguments": {
      "$ref": "#/$defs/CanonicalArguments"
    },
    "correlation": {
      "$ref": "#/$defs/InvocationCorrelation"
    },
    "authority": {
      "$ref": "#/$defs/InvocationAuthority"
    },
    "effect": {
      "$ref": "#/$defs/EffectFacts"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CanonicalArguments": {
      "type": "object",
      "required": [
        "type_ref",
        "canonical_json",
        "digest"
      ],
      "properties": {
        "type_ref": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "canonical_json": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "InvocationCorrelation": {
      "type": "object",
      "required": [
        "program_invocation_ref",
        "node_execution_id"
      ],
      "properties": {
        "program_invocation_ref": {
          "allOf": [
            {
              "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
            },
            {
              "type": "object",
              "properties": {
                "ref_type": {
                  "const": "ProgramInvocationRef"
                }
              }
            }
          ]
        },
        "node_execution_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "InvocationAuthority": {
      "type": "object",
      "required": [
        "acting_principal_ref",
        "agent_identity_ref",
        "capability_grant_ref",
        "approval_refs"
      ],
      "properties": {
        "acting_principal_ref": {
          "allOf": [
            {
              "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
            },
            {
              "type": "object",
              "properties": {
                "ref_type": {
                  "const": "ActingPrincipalRef"
                }
              }
            }
          ]
        },
        "agent_identity_ref": {
          "allOf": [
            {
              "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
            },
            {
              "type": "object",
              "properties": {
                "ref_type": {
                  "const": "AgentIdentityRef"
                }
              }
            }
          ]
        },
        "capability_grant_ref": {
          "allOf": [
            {
              "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
            },
            {
              "type": "object",
              "properties": {
                "ref_type": {
                  "const": "CapabilityGrantRef"
                }
              }
            }
          ]
        },
        "approval_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "apxm.contract-common.v1#/$defs/TypedRef"
              },
              {
                "type": "object",
                "properties": {
                  "ref_type": {
                    "const": "ApprovalRef"
                  }
                }
              }
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "EffectFacts": {
      "type": "object",
      "required": [
        "effect_id",
        "request_digest",
        "idempotency_key"
      ],
      "properties": {
        "effect_id": {
          "$ref": "apxm.contract-common.v1#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "apxm.contract-common.v1#/$defs/Digest"
        },
        "idempotency_key": {
          "$ref": "apxm.contract-common.v1#/$defs/IdempotencyKey"
        }
      },
      "additionalProperties": false
    }
  }
}
