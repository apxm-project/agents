{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.execution-admission.v1",
  "title": "ExecutionAdmission",
  "description": "Signed, expiring, nonce-bound product-neutral authority for one exact Agent Program invocation. The runtime verifies this envelope before constructing an immutable runtime profile.",
  "type": "object",
  "required": [
    "schema_version",
    "admission_ref",
    "admission_digest",
    "artifact_ref",
    "artifact_digest",
    "invocation_ref",
    "context_digest",
    "resource_ceilings",
    "port_bindings",
    "confinement",
    "expires_at_ms",
    "nonce",
    "issuer",
    "audience",
    "caller_correlations",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "apxm.execution-admission.v1"
    },
    "admission_ref": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "admission_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "artifact_ref": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "artifact_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "invocation_ref": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "context_digest": {
      "$ref": "apxm.contract-common.v1#/$defs/Digest"
    },
    "resource_ceilings": {
      "$ref": "#/$defs/ResourceCeilings"
    },
    "port_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/AdmittedPortBinding"
      }
    },
    "model_target": {
      "$ref": "#/$defs/AdmittedModelTarget"
    },
    "confinement": {
      "$ref": "#/$defs/AdmittedConfinement"
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 1
    },
    "nonce": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "issuer": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "audience": {
      "$ref": "apxm.contract-common.v1#/$defs/Identifier"
    },
    "caller_correlations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"
    },
    "SignatureEnvelope": {
      "type": "object",
      "required": ["algorithm", "key_ref", "signature"],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ResourceCeilings": {
      "type": "object",
      "required": ["max_wall_ms", "max_memory_bytes", "max_effect_bytes"],
      "properties": {
        "max_wall_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_effect_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "AdmittedPortBinding": {
      "type": "object",
      "required": [
        "slot",
        "port_contract_schema_id",
        "port_contract_digest",
        "binding_digest",
        "proof_digest"
      ],
      "properties": {
        "slot": {
          "enum": [
            "execution_commit",
            "confinement",
            "model_inference",
            "capability",
            "external_agent_capability",
            "durable_event",
            "program_composition"
          ]
        },
        "port_contract_schema_id": {
          "type": "string",
          "pattern": "^apxm\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.v[0-9]+$"
        },
        "port_contract_digest": {
          "$ref": "#/$defs/Digest"
        },
        "binding_digest": {
          "$ref": "#/$defs/Digest"
        },
        "proof_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "AdmittedModelTarget": {
      "type": "object",
      "required": [
        "model_target_ref",
        "model_deployment_ref",
        "exact_port_binding_digest"
      ],
      "properties": {
        "model_target_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "model_deployment_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "exact_port_binding_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "AdmittedConfinement": {
      "type": "object",
      "required": ["confinement_type", "sandbox_digest", "policy_digest"],
      "properties": {
        "confinement_type": {
          "enum": ["WASM", "DOCKER", "GVISOR", "FIRECRACKER", "NATIVE-SANDBOX"]
        },
        "sandbox_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false
    }
  }
}
