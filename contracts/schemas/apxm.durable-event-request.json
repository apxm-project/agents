{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.durable-event-request",
  "title": "DurableEventRequest",
  "description": "One request to await exactly one authorized durable Event Reference.",
  "type": "object",
  "required": ["node_id", "event_ref"],
  "properties": {
    "node_id": { "$ref": "apxm.contract-common.v1#/$defs/Identifier" },
