{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apxm.runtime.host-response.v1",
  "title": "APXM Reference Host Response",
  "type": "object",
  "required": ["schema_version", "status"],
  "properties": {
    "schema_version": {"const": "apxm.runtime.host-response.v1"},
    "status": {"enum": ["readiness", "committed", "failed", "rejected", "cancelled", "shutdown", "revoked", "restarted", "error"]},
    "readiness": {"$ref": "#/$defs/Readiness"},
    "invocation_id": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "result": {},
    "runtime_evidence": {},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["contract", "status"],
      "properties": {
        "contract": {"const": "reconcile_from_runtime_evidence"},
        "status": {"enum": ["reconciled", "no_runtime_evidence"]},
        "runtime_evidence": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "Readiness": {
      "type": "object",
      "required": ["schema_version", "contract_id", "state", "release_digest", "port_bindings_digest", "resource_ceiling_digest", "in_flight"],
      "properties": {
        "schema_version": {"const": "apxm.runtime.host.v1"},
        "contract_id": {"const": "apxm.runtime.host.v1"},
        "state": {"enum": ["starting", "ready", "draining", "stopped"]},
        "release_digest": {"$ref": "#/$defs/Digest"},
        "port_bindings_digest": {"$ref": "#/$defs/Digest"},
        "resource_ceiling_digest": {"$ref": "#/$defs/Digest"},
        "in_flight": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
