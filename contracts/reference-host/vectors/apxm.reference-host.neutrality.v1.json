{
  "schema_version": "apxm.reference-host.neutrality.v1",
  "semantic_owner": "agents",
  "profiles": ["embedded", "reference-host"],
  "scan_targets": [
    "contracts/descriptors/apxm.agents-owner-descriptor.v1.json",
    "contracts/reference-host/manifests/apxm.reference-host-release-manifest.v1.json",
    "contracts/reference-host/manifests/apxm.reference-host-execution-manifest.v1.json",
    "crates/tools/cli/src/bin/reference_host.rs",
    "docs/agents/runtime-profile-parity.md"
  ],
  "forbidden_patterns": [
    "\\bdownstream[-_](?:product|sdk|client|service)\\b",
    "@[a-z][a-z0-9._-]*/[a-z][a-z0-9._-]+",
    "\\b(?!(?:apxm|host|reference-host|downstream)(?:[-_]|$))[a-z][a-z0-9]*(?:[-_](?:sdk|client|service|product))\\b",
    "\\b(?!(?:apxm_server|downstream)[-_]dependency\\b)[a-z][a-z0-9]*(?:[-_]dependency)\\b"
  ],
  "negative_cases": [
    {
      "name": "downstream_product_coordinate",
      "input": "downstream_product",
      "expected_match": true
    },
    {
      "name": "downstream_sdk_coordinate",
      "input": "downstream-sdk",
      "expected_match": true
    },
    {
      "name": "vendor_client_coordinate",
      "input": "vendor_client",
      "expected_match": true
    },
    {
      "name": "scoped_package_coordinate",
      "input": "@acme/host-sdk",
      "expected_match": true
    },
    {
      "name": "generic_client_coordinate",
      "input": "customer-service",
      "expected_match": true
    },
    {
      "name": "generic_dependency_coordinate",
      "input": "acme_dependency",
      "expected_match": true
    },
    {
      "name": "owner_dependency_invariant",
      "input": "downstream_dependency",
      "expected_match": false
    }
  ]
}
