module {
  func.func @reasoning_flow() -> !ais.token attributes {ais.entry} {
    %n1 = ais.plan "Create a complete implementation plan" {node_name = "plan"} : !ais.token
    %n2 = ais.reflect "most_recent_execution" {node_name = "reflect"} : !ais.token
    %const_1 = ais.const_str "The implementation plan is complete." : !ais.token
    %const_2 = ais.const_str "The review lists every required frontend contract." : !ais.token
    %n3 = ais.verify %const_1 : !ais.token vs %const_2 : !ais.token with "Verify claim against evidence" : !ais.token
    ais.return %n3 {node_name = "out"} : !ais.token
  }
}
