module {
  func.func @control_flow() -> !ais.token attributes {ais.entry} {
    %n1 = ais.ask "Classify the request" : !ais.token
    ais.branch_on_value %n1, "approved_path", "review_path" {value = "approved"} : !ais.token
    %n3 = ais.switch %n1 : !ais.token
        case "approved" {
            ais.yield %n1 : !ais.token
        }
        case "review" {
            ais.yield %n1 : !ais.token
        }
        default {
            ais.yield %n1 : !ais.token
        } -> !ais.token {discriminant = "classification", node_name = "route"}
    ais.try_catch "route" -> "fallback"
    ais.return %n3 {node_name = "out"} : !ais.token
  }
}
