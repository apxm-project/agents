module {
  func.func @main() -> !ais.token attributes {ais.entry} {
    %n1 = ais.flow_call "conversation" "turn" {node_name = "run_turn"} : !ais.token
    ais.return %n1 {node_name = "return_turn"} : !ais.token
  }
  func.func @conversation.turn(%arg0: !ais.token {ais.param_name = "user_message", ais.param_type = "str"}) -> !ais.token {
    %n1 = ais.ask "Reply to: {user_message}" [%arg0 : !ais.token] : !ais.token
    ais.return %n1 {node_name = "out"} : !ais.token
  }
}
