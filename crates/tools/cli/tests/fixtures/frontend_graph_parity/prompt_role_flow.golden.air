module {
  func.func @prompt_role_flow() -> !ais.token attributes {ais.entry} {
    %n1 = ais.ask "Question" : !ais.token
    %n2 = ais.ask "System instructions" : !ais.token
    %n3 = ais.ask "Dependency state" : !ais.token
    %n4 = ais.ask "Tool result" : !ais.token
    %n5 = ais.ask "Control state" : !ais.token
    %n6 = ais.ask "Answer {question}" [%n1, %n2, %n3, %n4, %n5 : !ais.token, !ais.token, !ais.token, !ais.token, !ais.token] {input_names = ["question", "policy", "dependency", "tool_result", "guard"], input_roles = ["user", "system", "dependency_only", "tool_context", "control"]} : !ais.token
    ais.return %n6 {node_name = "out"} : !ais.token
  }
}
