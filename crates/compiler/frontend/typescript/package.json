{
  "name": "@apxm/frontend",
  "version": "0.1.0",
  "type": "module",
  "description": "Generic TypeScript Agent Program authoring frontend for APXM",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "default": "./dist/permissions.js"
    },
    "./scopes": {
      "types": "./dist/scopes.d.ts",
      "default": "./dist/scopes.js"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apxm-project/agents.git",
    "directory": "crates/compiler/frontend/typescript"
  },
  "private": true,
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  }
}
