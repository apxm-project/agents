#!/usr/bin/env bash
#
# APXM/vLLM pre-commit hook.
#
# Install:
#   git config --local core.hooksPath tools/git-hooks
#
# Runs the no-legacy lint in --strict mode. Any legacy CLI token,
# fallback chain, or capability-flag regression fails the commit.
# Mirror of the model-zoo migration mandate.

set -e

repo_root=$(git rev-parse --show-toplevel)
script="$repo_root/tools/scripts/check_no_legacy_vllm.py"

if [ ! -f "$script" ]; then
  # Hook is harmless when the lint script is absent (e.g. detached HEAD on
  # a pre-rebase branch). Don't block commits in that state.
  exit 0
fi

# Prefer the conda env's python so the script's tomllib usage works on
# hosts with older system Python.
if [ -x "$repo_root/.dekk/env/bin/python3" ]; then
  PYTHON="$repo_root/.dekk/env/bin/python3"
else
  PYTHON="python3"
fi

"$PYTHON" "$script" --strict --staged-only
