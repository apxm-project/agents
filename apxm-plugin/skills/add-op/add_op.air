module {
  func.func @add_op_workflow(%arg0: !ais.token {ais.param_name = "op_name", ais.param_type = "str"}, %arg1: !ais.token {ais.param_name = "op_description", ais.param_type = "str"}) -> !ais.token attributes {ais.entry} {
    %architect = ais.spawn_agent "architect" {profile = "claude", cwd = "."} : !ais.token
    %compiler_dev = ais.spawn_agent "compiler_dev" {profile = "claude", cwd = "."} : !ais.token
    %runtime_dev = ais.spawn_agent "runtime_dev" {profile = "codex", cwd = "."} : !ais.token
    %reviewer = ais.spawn_agent "reviewer" {profile = "claude", cwd = "."} : !ais.token
    %architect_msg_1 = ais.communicate "You are the architect for APXM. You need to create an implementation plan\nfor adding a new AIS operation to the APXM codebase.\n\nOperation name: {op_name}\nDescription: {op_description}\n\nRead the following files to understand the pattern:\n- crates/core/apxm-ais/src/definitions.rs (AISOperationType enum)\n- crates/compiler/apxm-compiler/src/lower/ArtifactEmitter.cpp (MLIR lowering)\n- crates/compiler/apxm-compiler/mlir/AISOps.td (TableGen definitions)\n- crates/runtime/apxm-runtime/src/executor/handlers/spawn_agent.rs (example handler)\n- crates/runtime/apxm-runtime/src/executor/mod.rs (dispatcher)\n\nCreate a structured plan with:\n1. Wire index (next available after checking definitions.rs)\n2. Required and optional node attributes\n3. MLIR mnemonic (should be lowercase, e.g., \"ais.checkpoint\")\n4. Handler pseudo-code (what should the runtime do)\n5. TableGen definition structure\n6. Test strategy\n\nKeep the plan under 400 words but be specific about attribute names and types.\n" to "architect" (%architect : !ais.token) {protocol = "acp"} : !ais.token
    ais.print "=== ARCHITECT PLAN ===\n{architect_plan}" [%architect_msg_1 : !ais.token] {input_names = ["architect_plan"]}
    %build_compiler_prompt = ais.ask "Based on this plan, implement the compiler-side changes:\n\nPlan:\n{architect_plan}\n\nYou need to modify:\n1. crates/core/apxm-ais/src/definitions.rs\n   - Add variant to AISOperationType enum\n   - Add to from_wire_index() match\n\n2. crates/compiler/apxm-compiler/mlir/AISOps.td\n   - Add def AIS_<OpName>Op block following the pattern of other ops\n\n3. crates/compiler/apxm-compiler/src/lower/ArtifactEmitter.cpp\n   - Add case to the switch in emitAISOperation()\n\nMake sure the wire index matches the plan. Use the same attribute names.\nOnly modify what's necessary — don't refactor surrounding code.\n" [%architect_msg_1 : !ais.token] {input_names = ["architect_plan"]} : !ais.token
    %build_runtime_prompt = ais.ask "Based on this plan, implement the runtime-side changes:\n\nPlan:\n{architect_plan}\n\nYou need to:\n1. Create crates/runtime/apxm-runtime/src/executor/handlers/<op_name>.rs\n   - Implement the handler function following the pattern in spawn_agent.rs\n   - Extract attributes from the node\n   - Execute the operation logic\n   - Return a ResultToken\n\n2. Modify crates/runtime/apxm-runtime/src/executor/mod.rs\n   - Add mod <op_name> in the handlers module section\n   - Add a new arm to the execute_node() match statement\n\n3. Add tests in the handler file\n   - Basic success case\n   - Error handling if applicable\n\nFollow APXM conventions: use apxm-core types, proper error handling with context.\n" [%architect_msg_1 : !ais.token] {input_names = ["architect_plan"]} : !ais.token
    %compiler_dev_msg_1 = ais.communicate "{compiler_prompt}" to "compiler_dev" (%build_compiler_prompt, %compiler_dev : !ais.token, !ais.token) {protocol = "acp", input_names = ["compiler_prompt"]} : !ais.token
    %runtime_dev_msg_1 = ais.communicate "{runtime_prompt}" to "runtime_dev" (%build_runtime_prompt, %runtime_dev : !ais.token, !ais.token) {protocol = "acp", input_names = ["runtime_prompt"]} : !ais.token
    ais.print "=== COMPILER IMPL ===\n{compiler_impl}" [%compiler_dev_msg_1 : !ais.token] {input_names = ["compiler_impl"]}
    ais.print "=== RUNTIME IMPL ===\n{runtime_impl}" [%runtime_dev_msg_1 : !ais.token] {input_names = ["runtime_impl"]}
    %wait_implementations = ais.wait_all %compiler_dev_msg_1, %runtime_dev_msg_1 : !ais.token, !ais.token -> !ais.token
    %build_review_task = ais.ask "Review both implementations and verify they work together:\n\nCompiler implementation:\n{compiler_impl}\n\nRuntime implementation:\n{runtime_impl}\n\nCheck:\n1. Wire index consistency across all files\n2. Attribute names match between TableGen and handler\n3. MLIR mnemonic follows conventions\n4. Handler properly extracts and validates attributes\n5. Error handling is present\n\nThen run:\n  dekk apxm build\n  cargo test -p apxm-runtime\n\nReport:\n- What's correct\n- What's wrong (if anything)\n- Test results\n- Whether the implementation is ready to merge\n\nIf tests fail, suggest fixes.\n" [%compiler_dev_msg_1, %runtime_dev_msg_1 : !ais.token, !ais.token] {input_names = ["compiler_impl", "runtime_impl"]} : !ais.token
    %reviewer_msg_1 = ais.communicate "{review_task}" to "reviewer" (%build_review_task, %reviewer : !ais.token, !ais.token) {protocol = "acp", input_names = ["review_task"]} : !ais.token
    ais.print "=== REVIEW ===\n{review_result}" [%reviewer_msg_1 : !ais.token] {input_names = ["review_result"]}
    %synthesis = ais.think "Synthesize the add-op workflow results:\n\nPlan: {architect_plan}\nCompiler impl: {compiler_impl}\nRuntime impl: {runtime_impl}\nReview: {review_result}\n\nSummary:\n- Operation name and wire index\n- Implementation status (ready/needs-fixes)\n- Test results\n- Next steps (if any)\n" [%architect_msg_1, %compiler_dev_msg_1, %runtime_dev_msg_1, %reviewer_msg_1 : !ais.token, !ais.token, !ais.token, !ais.token] {input_names = ["architect_plan", "compiler_impl", "runtime_impl", "review_result"]} : !ais.token
    ais.print "=== FINAL SUMMARY ===\n{final}" [%synthesis : !ais.token] {input_names = ["final"]}
    %ret_merge = ais.merge %architect_msg_1, %synthesis : !ais.token, !ais.token -> !ais.token
    func.return %ret_merge : !ais.token
  }
}
