module {
  func.func @add_op_workflow(%arg0: !ais.token {ais.param_name = "op_name", ais.param_type = "str"}, %arg1: !ais.token {ais.param_name = "op_description", ais.param_type = "str"}) -> !ais.token attributes {ais.entry} {
    %architect = ais.spawn_agent "architect" {profile = "claude", cwd = "/home/apxm/projects/agents/apxm"} : !ais.token
    %compiler_dev = ais.spawn_agent "compiler_dev" {profile = "claude", cwd = "/home/apxm/projects/agents/apxm"} : !ais.token
    %runtime_dev = ais.spawn_agent "runtime_dev" {profile = "codex", cwd = "/home/apxm/projects/agents/apxm"} : !ais.token
    %reviewer = ais.spawn_agent "reviewer" {profile = "claude", cwd = "/home/apxm/projects/agents/apxm"} : !ais.token
    %architect_task = ais.const_str "You are the architect for APXM. You need to create an implementation plan\nfor adding a new AIS operation to the APXM codebase.\n\nOperation name: {op_name}\nDescription: {op_description}\n\nRead the following files to understand the pattern:\n- crates/core/apxm-ais/src/definitions.rs (AISOperationType enum)\n- crates/compiler/apxm-compiler/src/lower/ArtifactEmitter.cpp (MLIR lowering)\n- crates/compiler/apxm-compiler/mlir/AISOps.td (TableGen definitions)\n- crates/runtime/apxm-runtime/src/executor/handlers/spawn_agent.rs (example handler)\n- crates/runtime/apxm-runtime/src/executor/mod.rs (dispatcher)\n\nCreate a structured plan with:\n1. Wire index (next available after checking definitions.rs)\n2. Required and optional node attributes\n3. MLIR mnemonic (should be lowercase, e.g., \"ais.checkpoint\")\n4. Handler pseudo-code (what should the runtime do)\n5. TableGen definition structure\n6. Test strategy\n\nKeep the plan under 400 words but be specific about attribute names and types.\n" : !ais.token
    %architect_msg_1 = ais.communicate "{architect_task}" to "architect" (%architect_task : !ais.token) : !ais.token
    ais.print "=== ARCHITECT PLAN ===\n{architect}" [%architect_msg_1 : !ais.token]
    %ask = ais.ask "build_compiler_prompt" [%architect_msg_1 : !ais.token] : !ais.token
    %ask_1 = ais.ask "build_runtime_prompt" [%architect_msg_1 : !ais.token] : !ais.token
    %compiler_dev_msg_1 = ais.communicate "{compiler_prompt}" to "compiler_dev" (%ask : !ais.token) : !ais.token
    %runtime_dev_msg_1 = ais.communicate "{runtime_prompt}" to "runtime_dev" (%ask_1 : !ais.token) : !ais.token
    ais.print "=== COMPILER IMPL ===\n{compiler_dev}" [%compiler_dev_msg_1 : !ais.token]
    ais.print "=== RUNTIME IMPL ===\n{runtime_dev}" [%runtime_dev_msg_1 : !ais.token]
    %wait_implementations = ais.wait_all %compiler_dev_msg_1, %runtime_dev_msg_1 : !ais.token, !ais.token -> !ais.token
    %ask_2 = ais.ask "build_review_task" [%compiler_dev_msg_1, %runtime_dev_msg_1 : !ais.token, !ais.token] : !ais.token
    %reviewer_msg_1 = ais.communicate "{review_task}" to "reviewer" (%ask_2 : !ais.token) : !ais.token
    ais.print "=== REVIEW ===\n{reviewer}" [%reviewer_msg_1 : !ais.token]
    %think = ais.think "synthesis" [%architect_msg_1, %compiler_dev_msg_1, %runtime_dev_msg_1, %reviewer_msg_1 : !ais.token, !ais.token, !ais.token, !ais.token] : !ais.token
    ais.print "=== FINAL SUMMARY ===\n{final}" [%think : !ais.token]
    func.return %think : !ais.token
  }
}
