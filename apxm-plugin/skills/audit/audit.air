module {
  func.func @audit(%arg0: !ais.token {ais.param_name = "scope", ais.param_type = "str"}) -> !ais.token attributes {ais.entry} {
    %architect = ais.spawn_agent "architect" {profile = "claude", cwd = "/home/raherrer/projects/agents/apxm"} : !ais.token
    %text = ais.const_str "Run APXM build and capture warnings/errors:\n\nExecute:\n  dekk apxm build 2>&1\n\nParse the output and report:\n- Build status (success/failure)\n- Number of warnings by type (dead_code, unused_imports, etc.)\n- Number of errors (if any)\n- Critical issues (if any)\n\nOutput JSON:\n{\n  \"status\": \"clean\" | \"warnings\" | \"errors\",\n  \"warnings\": {\n    \"dead_code\": N,\n    \"unused_imports\": N,\n    \"other\": N\n  },\n  \"errors\": [],\n  \"total_warnings\": N,\n  \"total_errors\": N\n}\n" : !ais.token
    %architect_msg_1 = ais.communicate "{0}" to "architect" (%text : !ais.token) : !ais.token
    ais.print "=== BUILD STATUS ===\n{0}" [%architect_msg_1 : !ais.token]
    %text_1 = ais.const_str "Run APXM test suite and report results:\n\nExecute:\n  cargo test --workspace --quiet 2>&1\n\nParse the output and report:\n- Test status (all pass/some failures)\n- Number of tests run\n- Number of tests passed\n- Number of tests failed\n- Failed test names (if any)\n\nOutput JSON:\n{\n  \"status\": \"pass\" | \"fail\",\n  \"total\": N,\n  \"passed\": N,\n  \"failed\": N,\n  \"failed_tests\": [\"test1\", \"test2\", ...]\n}\n" : !ais.token
    %architect_msg_2 = ais.communicate "{0}" to "architect" (%text_1 : !ais.token) : !ais.token
    ais.print "=== TEST STATUS ===\n{0}" [%architect_msg_2 : !ais.token]
    %text_2 = ais.const_str "Run APXM autofix validation and report:\n\nExecute:\n  PYTHONPATH=crates/compiler/apxm-frontend/python python3 scripts/apxm-autofix.py --report-only\n\nParse the output and report:\n- Validation status (all pass/some failures)\n- Number of examples validated\n- Number of examples passed\n- Number of examples failed\n- Failure types (import_error, mlir_parse_error, compile_error, etc.)\n\nOutput JSON:\n{\n  \"status\": \"pass\" | \"fail\",\n  \"total\": N,\n  \"passed\": N,\n  \"failed\": N,\n  \"failures_by_type\": {\n    \"import_error\": N,\n    \"mlir_parse_error\": N,\n    \"compile_error\": N\n  }\n}\n" : !ais.token
    %architect_msg_3 = ais.communicate "{0}" to "architect" (%text_2 : !ais.token) : !ais.token
    ais.print "=== AUTOFIX STATUS ===\n{0}" [%architect_msg_3 : !ais.token]
    %text_3 = ais.const_str "Run APXM policy checks and report violations:\n\nExecute:\n  python3 scripts/apxm-policy-check.py\n\nParse the output and report:\n- Policy status (clean/violations)\n- Number of violations by category\n- Critical violations (if any)\n\nOutput JSON:\n{\n  \"status\": \"clean\" | \"violations\",\n  \"violations\": {\n    \"category1\": N,\n    \"category2\": N\n  },\n  \"total_violations\": N,\n  \"critical\": []\n}\n" : !ais.token
    %architect_msg_4 = ais.communicate "{0}" to "architect" (%text_3 : !ais.token) : !ais.token
    ais.print "=== POLICY STATUS ===\n{0}" [%architect_msg_4 : !ais.token]
    %text_4 = ais.const_str "Count TODOs, FIXMEs, and stub handlers in runtime and compiler:\n\nExecute:\n  grep -r \"TODO\\|FIXME\" crates/apxm-runtime crates/apxm-compiler --include=\"*.rs\" | wc -l\n  grep -r \"stub\\|unimplemented\" crates/runtime/apxm-runtime/src/executor/handlers --include=\"*.rs\" | wc -l\n\nReport:\n- Total TODOs/FIXMEs\n- Total stub handlers\n- High-priority items (if marked as such)\n\nOutput JSON:\n{\n  \"todos_fixmes\": N,\n  \"stub_handlers\": N,\n  \"high_priority\": []\n}\n" : !ais.token
    %architect_msg_5 = ais.communicate "{0}" to "architect" (%text_4 : !ais.token) : !ais.token
    ais.print "=== TODO/STUB STATUS ===\n{0}" [%architect_msg_5 : !ais.token]
    %text_5 = ais.const_str "Check for missing AIS operations in artifact emitter:\n\nCompare:\n1. AIS operations defined in crates/core/apxm-ais/src/operations/definitions.rs (AISOperationType enum)\n2. Operations mapped in crates/compiler/apxm-compiler/mlir/lib/Dialect/AIS/Conversion/Artifact/ArtifactEmitter.cpp (mapOperation function)\n\nReport any operations defined in Rust but missing from the C++ emitter.\n\nExecute:\n  grep \"^\\s*[A-Z][a-zA-Z]*,\" crates/core/apxm-ais/src/operations/definitions.rs | wc -l\n  grep \"Case<.*Op>\" crates/compiler/apxm-compiler/mlir/lib/Dialect/AIS/Conversion/Artifact/ArtifactEmitter.cpp | wc -l\n\nOutput JSON:\n{\n  \"total_ops\": N,\n  \"mapped_ops\": N,\n  \"missing_ops\": [\"Op1\", \"Op2\", ...],\n  \"status\": \"complete\" | \"incomplete\"\n}\n" : !ais.token
    %architect_msg_6 = ais.communicate "{0}" to "architect" (%text_5 : !ais.token) : !ais.token
    ais.print "=== MISSING OPS STATUS ===\n{0}" [%architect_msg_6 : !ais.token]
    %synthesize_report = ais.think "Synthesize comprehensive audit report from all checks:\n\nBuild status: {0}\nTest status: {1}\nAutofix status: {2}\nPolicy status: {3}\nTODO/Stub status: {4}\nMissing ops status: {5}\n\nGenerate structured audit report:\n\n# APXM Project Audit Report\n\n## Summary\n- Overall status: <CLEAN/WARNINGS/ISSUES/CRITICAL>\n- Scope: <scope from param>\n- Timestamp: <current date>\n\n## Build Health\n- Status: <clean/warnings/errors>\n- Total warnings: N\n- Total errors: N\n- Details: <summary>\n\n## Test Coverage\n- Status: <pass/fail>\n- Tests run: N\n- Tests passed: N\n- Tests failed: N\n- Failed tests: <list if any>\n\n## Example Validation\n- Status: <pass/fail>\n- Examples validated: N\n- Examples passed: N\n- Examples failed: N\n- Failure types: <breakdown>\n\n## Policy Compliance\n- Status: <clean/violations>\n- Total violations: N\n- Violations by category: <breakdown>\n- Critical violations: <list if any>\n\n## Code Quality\n- TODOs/FIXMEs: N\n- Stub handlers: N\n- High-priority items: <list if any>\n\n## Completeness\n- Total AIS ops: N\n- Mapped ops: N\n- Missing ops: <list if any>\n\n## Overall Assessment\n<2-3 sentence summary of project health>\n" [%architect_msg_1, %architect_msg_2, %architect_msg_3, %architect_msg_4, %architect_msg_5, %architect_msg_6 : !ais.token, !ais.token, !ais.token, !ais.token, !ais.token, !ais.token] : !ais.token
    ais.print "=== AUDIT REPORT ===\n{0}" [%synthesize_report : !ais.token]
    %generate_recommendations = ais.think "Generate actionable recommendations ranked by impact and effort:\n\nAudit report: {0}\n\nFor each issue category (build warnings, test failures, policy violations, etc.):\n1. Rank by impact (CRITICAL/HIGH/MEDIUM/LOW)\n2. Estimate effort (TRIVIAL/SMALL/MEDIUM/LARGE)\n3. Suggest concrete next steps\n\nOutput recommendations sorted by (impact, effort):\n\n# Actionable Recommendations\n\n## Critical (do now)\n- [ ] <item> - <why critical> - <effort estimate> - <concrete steps>\n\n## High Priority (this week)\n- [ ] <item> - <why important> - <effort estimate> - <concrete steps>\n\n## Medium Priority (this month)\n- [ ] <item> - <why needed> - <effort estimate> - <concrete steps>\n\n## Low Priority (backlog)\n- [ ] <item> - <why nice-to-have> - <effort estimate> - <concrete steps>\n\n## Suggested Focus Areas\n1. <area 1>: <rationale>\n2. <area 2>: <rationale>\n3. <area 3>: <rationale>\n" [%synthesize_report : !ais.token] : !ais.token
    ais.print "=== RECOMMENDATIONS ===\n{0}" [%generate_recommendations : !ais.token]
    func.return %generate_recommendations : !ais.token
  }
}
