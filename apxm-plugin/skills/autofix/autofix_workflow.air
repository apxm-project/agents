module {
  func.func @autofix_workflow(%arg0: !ais.token {ais.param_name = "scope", ais.param_type = "str"}) -> !ais.token attributes {ais.entry} {
    %validator = ais.spawn_agent "validator" {profile = "claude", cwd = "."} : !ais.token
    %validator_msg_1 = ais.communicate "Run the APXM autofix validation for scope: examples/python\n\nExecute:\n  python3 scripts/apxm-autofix.py --scope examples/python --report-only\n\nReport the full output (it will show validation results, task files created in /tmp/autofix-tasks/, etc.)\n" to "validator" (%validator : !ais.token) {protocol = "acp"} : !ais.token
    ais.print "=== VALIDATION OUTPUT ===\n{validate_result}" [%validator_msg_1 : !ais.token] {input_names = ["validate_result"]}
    %classify_failures = ais.think "Analyze the autofix validation output and classify failures:\n\nValidation output from validator:\n{validate_result}\n\nParse the output and create failure clusters:\n1. Group by error type (import_error, mlir_parse_error, compile_error, etc.)\n2. For each cluster, identify:\n   - How many files affected\n   - Common root cause (if any)\n   - Suggested fix strategy\n\nOutput JSON:\n{{\n  \"clusters\": [\n    {{\n      \"type\": \"import_error\",\n      \"count\": 3,\n      \"files\": [\"path1\", \"path2\", \"path3\"],\n      \"root_cause\": \"...\",\n      \"fix_strategy\": \"...\"\n    }},\n    ...\n  ],\n  \"total_failures\": N,\n  \"status\": \"pass\" | \"fail\"\n}}\n\nIf status is \"pass\", output {{\"status\": \"pass\", \"clusters\": []}}.\n" [%validator_msg_1 : !ais.token] {input_names = ["validate_result"]} : !ais.token
    ais.print "=== FAILURE CLASSIFICATION ===\n{classify}" [%classify_failures : !ais.token] {input_names = ["classify"]}
    %fixer_import = ais.spawn_agent "fixer_import" {profile = "claude", cwd = "."} : !ais.token
    %fixer_mlir = ais.spawn_agent "fixer_mlir" {profile = "claude", cwd = "."} : !ais.token
    %fixer_compile = ais.spawn_agent "fixer_compile" {profile = "claude", cwd = "."} : !ais.token
    %build_fix_import_task = ais.ask "Fix import errors from the classification:\n\nClassification: {classify}\n\nIf there are import_error failures:\n1. Read the task file from /tmp/autofix-tasks/import_error.md\n2. For each affected file, fix the import statements:\n   - Update module paths (e.g., apxm.graph → apxm.graph.module)\n   - Add missing imports\n   - Remove obsolete imports\n3. Run validation to verify: python3 scripts/apxm-autofix.py --scope examples/python --verify-only\n\nIf there are no import_error failures, output \"No import errors to fix\".\n\nReport what you fixed and verification results.\n" [%classify_failures : !ais.token] {input_names = ["classify"]} : !ais.token
    %build_fix_mlir_task = ais.ask "Fix MLIR parse errors from the classification:\n\nClassification: {classify}\n\nIf there are mlir_parse_error failures:\n1. Read the task file from /tmp/autofix-tasks/mlir_parse_error.md\n2. For each affected file, fix the AIR output:\n   - Fix malformed attribute syntax\n   - Fix missing required attributes\n   - Fix type mismatches\n3. Run validation to verify: python3 scripts/apxm-autofix.py --scope examples/python --verify-only\n\nIf there are no mlir_parse_error failures, output \"No MLIR errors to fix\".\n\nReport what you fixed and verification results.\n" [%classify_failures : !ais.token] {input_names = ["classify"]} : !ais.token
    %build_fix_compile_task = ais.ask "Fix compile errors from the classification:\n\nClassification: {classify}\n\nIf there are compile_error failures:\n1. Read the task file from /tmp/autofix-tasks/compile_error.md\n2. For each affected file, fix the code:\n   - Add missing parameters\n   - Fix attribute names\n   - Fix method call signatures\n3. Run validation to verify: python3 scripts/apxm-autofix.py --scope examples/python --verify-only\n\nIf there are no compile_error failures, output \"No compile errors to fix\".\n\nReport what you fixed and verification results.\n" [%classify_failures : !ais.token] {input_names = ["classify"]} : !ais.token
    %fixer_import_msg_1 = ais.communicate "{fix_import_task}" to "fixer_import" (%build_fix_import_task, %fixer_import : !ais.token, !ais.token) {protocol = "acp", input_names = ["fix_import_task"]} : !ais.token
    %fixer_mlir_msg_1 = ais.communicate "{fix_mlir_task}" to "fixer_mlir" (%build_fix_mlir_task, %fixer_mlir : !ais.token, !ais.token) {protocol = "acp", input_names = ["fix_mlir_task"]} : !ais.token
    %fixer_compile_msg_1 = ais.communicate "{fix_compile_task}" to "fixer_compile" (%build_fix_compile_task, %fixer_compile : !ais.token, !ais.token) {protocol = "acp", input_names = ["fix_compile_task"]} : !ais.token
    ais.print "=== IMPORT FIXES ===\n{import_fixes}" [%fixer_import_msg_1 : !ais.token] {input_names = ["import_fixes"]}
    ais.print "=== MLIR FIXES ===\n{mlir_fixes}" [%fixer_mlir_msg_1 : !ais.token] {input_names = ["mlir_fixes"]}
    ais.print "=== COMPILE FIXES ===\n{compile_fixes}" [%fixer_compile_msg_1 : !ais.token] {input_names = ["compile_fixes"]}
    %wait_all_fixers = ais.wait_all %fixer_import_msg_1, %fixer_mlir_msg_1, %fixer_compile_msg_1 : !ais.token, !ais.token, !ais.token -> !ais.token
    %verifier = ais.spawn_agent "verifier" {profile = "claude", cwd = "."} : !ais.token
    %verifier_msg_1 = ais.communicate "Run final verification of all fixes:\n\nExecute:\n  python3 scripts/apxm-autofix.py --scope examples/python --verify-only\n\nReport the results (pass/fail counts, any remaining issues).\n" to "verifier" (%verifier : !ais.token) {protocol = "acp"} : !ais.token
    ais.print "=== VERIFICATION OUTPUT ===\n{verify_result}" [%verifier_msg_1 : !ais.token] {input_names = ["verify_result"]}
    %generate_report = ais.think "Generate autofix report:\n\nInitial validation: {validate_result}\nClassification: {classify}\nImport fixes: {import_fixes}\nMLIR fixes: {mlir_fixes}\nCompile fixes: {compile_fixes}\nFinal verification: {verify_result}\n\nReport:\n- Scope: examples/python\n- Initial failures: <count by type>\n- Fixes applied:\n  * Import errors: <count fixed>\n  * MLIR errors: <count fixed>\n  * Compile errors: <count fixed>\n- Final verification: <pass/fail>\n- Remaining issues: <count> (if any)\n- Status: <success/partial/failed>\n\nIf status is partial or failed, list remaining issues and suggested next steps.\n" [%validator_msg_1, %classify_failures, %fixer_import_msg_1, %fixer_mlir_msg_1, %fixer_compile_msg_1, %verifier_msg_1 : !ais.token, !ais.token, !ais.token, !ais.token, !ais.token, !ais.token] {input_names = ["validate_result", "classify", "import_fixes", "mlir_fixes", "compile_fixes", "verify_result"]} : !ais.token
    ais.print "=== AUTOFIX REPORT ===\n{report}" [%generate_report : !ais.token] {input_names = ["report"]}
    func.return %generate_report : !ais.token
  }
}
