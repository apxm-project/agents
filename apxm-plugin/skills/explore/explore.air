module {
  func.func @explore_workflow(%arg0: !ais.token {ais.param_name = "question", ais.param_type = "str"}) -> !ais.token attributes {ais.entry} {
    %architect = ais.spawn_agent "architect" {profile = "claude", cwd = "."} : !ais.token
    %adversary = ais.spawn_agent "adversary" {profile = "claude", cwd = "."} : !ais.token
    %implementer = ais.spawn_agent "implementer" {profile = "codex", cwd = "."} : !ais.token
    %researcher = ais.spawn_agent "researcher" {profile = "claude", cwd = "."} : !ais.token
    %user_advocate = ais.spawn_agent "user_advocate" {profile = "claude", cwd = "."} : !ais.token
    %architect_msg_1 = ais.communicate "You are the APXM systems architect. Answer this question from a systems design perspective:\n\nQuestion: {question}\n\nConsider:\n- How does this fit into the overall APXM architecture (compiler, runtime, AIS, frontend)?\n- What are the architectural implications?\n- How does it interact with existing components (AAM, scheduler, MLIR backend)?\n- What's the cleanest way to implement this in the current design?\n\nBe specific and reference actual APXM components. Keep under 300 words.\n" to "architect" (%architect : !ais.token) {protocol = "acp"} : !ais.token
    %adversary_msg_1 = ais.communicate "You are the adversary. Your job is to find problems with the proposed idea:\n\nQuestion: {question}\n\nChallenge it:\n- What breaks if we do this?\n- What's over-engineered?\n- What assumptions are we making that might be wrong?\n- What are the maintenance costs?\n- Is this solving a real problem or imaginary one?\n- What's the simplest alternative that achieves 80% of the value?\n\nBe brutally honest. If it's a bad idea, say so. Keep under 300 words.\n" to "adversary" (%adversary : !ais.token) {protocol = "acp"} : !ais.token
    %implementer_msg_1 = ais.communicate "You are the implementer. Answer this question with concrete Rust code:\n\nQuestion: {question}\n\nShow:\n- What crates would be modified\n- What new types/traits would be needed\n- Sketch key function signatures\n- Show a minimal working example (pseudocode is fine)\n\nFocus on *how* it would actually be built in Rust. Keep under 300 words.\n" to "implementer" (%implementer : !ais.token) {protocol = "acp"} : !ais.token
    %researcher_msg_1 = ais.communicate "You are the researcher. Answer this question based on what the industry and literature say:\n\nQuestion: {question}\n\nResearch:\n- How do similar systems solve this? (LLVM, Dask, Ray, etc.)\n- What do the papers say? (cite if you know specific ones)\n- What are the standard approaches?\n- What have others tried that failed?\n- What's the state of the art?\n\nCite examples from real systems. Keep under 300 words.\n" to "researcher" (%researcher : !ais.token) {protocol = "acp"} : !ais.token
    %user_advocate_msg_1 = ais.communicate "You are the user advocate. Answer this question from the user's perspective:\n\nQuestion: {question}\n\nConsider:\n- What do APXM users actually need?\n- Is this solving their pain points?\n- How does this affect the user experience (CLI, Python API, workflows)?\n- What would users have to learn or change?\n- Is there a simpler way to give users what they want?\n\nThink about real-world workflow authors using APXM. Keep under 300 words.\n" to "user_advocate" (%user_advocate : !ais.token) {protocol = "acp"} : !ais.token
    ais.print "=== ARCHITECT ===\n{arch_result}" [%architect_msg_1 : !ais.token] {input_names = ["arch_result"]}
    ais.print "=== ADVERSARY ===\n{adv_result}" [%adversary_msg_1 : !ais.token] {input_names = ["adv_result"]}
    ais.print "=== IMPLEMENTER ===\n{impl_result}" [%implementer_msg_1 : !ais.token] {input_names = ["impl_result"]}
    ais.print "=== RESEARCHER ===\n{res_result}" [%researcher_msg_1 : !ais.token] {input_names = ["res_result"]}
    ais.print "=== USER ADVOCATE ===\n{user_result}" [%user_advocate_msg_1 : !ais.token] {input_names = ["user_result"]}
    %wait_all_perspectives = ais.wait_all %architect_msg_1, %adversary_msg_1, %implementer_msg_1, %researcher_msg_1, %user_advocate_msg_1 : !ais.token, !ais.token, !ais.token, !ais.token, !ais.token -> !ais.token
    %synthesis = ais.think "Synthesize the 5 perspectives on this question:\n\nQuestion: {{question}}\n\nArchitect: {arch_result}\nAdversary: {adv_result}\nImplementer: {impl_result}\nResearcher: {res_result}\nUser advocate: {user_result}\n\nSynthesize:\n1. What do all perspectives agree on?\n2. Where do they conflict?\n3. What did the adversary catch that others missed?\n4. What's the balanced view?\n5. Recommendation: should we do this? (yes/no/maybe/different-approach)\n\nLet the adversary win on scope reduction — if they identified over-engineering, take it seriously.\nGive a clear, definitive answer. Keep under 400 words.\n" [%architect_msg_1, %adversary_msg_1, %implementer_msg_1, %researcher_msg_1, %user_advocate_msg_1 : !ais.token, !ais.token, !ais.token, !ais.token, !ais.token] {input_names = ["arch_result", "adv_result", "impl_result", "res_result", "user_result"]} : !ais.token
    ais.print "=== SYNTHESIS ===\n{synthesis}" [%synthesis : !ais.token] {input_names = ["synthesis"]}
    %action_plan = ais.think "Based on the synthesis, extract concrete next steps:\n\nSynthesis: {synthesis}\n\nIf the recommendation is YES or MAYBE:\n- List 3-5 concrete action items with file paths\n- Assign priority (P0/P1/P2)\n- Estimate effort (small/medium/large)\n- Identify risks\n\nIf the recommendation is NO or DIFFERENT-APPROACH:\n- Explain why not\n- Suggest the alternative\n- List what to do instead (if anything)\n\nOutput a structured action plan ready for execution. Keep under 300 words.\n" [%synthesis : !ais.token] {input_names = ["synthesis"]} : !ais.token
    ais.print "=== ACTION PLAN ===\n{action_plan}" [%action_plan : !ais.token] {input_names = ["action_plan"]}
    func.return %action_plan : !ais.token
  }
}
