[
  {
    "name": "valid-one-file-org",
    "input": {
      "org": {
        "org_id": "acme",
        "schema_version": "apxm.org",
        "display_name": "Acme",
        "description": "An org with no members yet.",
        "policy": {
          "approval_default": "manual",
          "autonomy_ceiling": "supervised"
        },
        "topology": {
          "tree": {
            "root": "acme-root",
            "edges": []
          }
        }
      },
      "files": {
        "org.toml": "1111111111111111111111111111111111111111111111111111111111111111"
      }
    },
    "expected_valid": true
  },
  {
    "name": "valid-two-level-tree-with-a-masked-global-capability",
    "input": {
      "org": {
        "org_id": "acme",
        "schema_version": "apxm.org",
        "display_name": "Acme",
        "permissions": {
          "read": "allow",
          "write": {
            "decision": "ask",
            "reason": "This org reviews host writes."
          }
        },
        "members": [
          {
            "id": "root-agent",
            "package": "root-pkg",
            "version": "0.1.0",
            "hierarchy": {
              "permitted_children": [
                "child-agent"
              ]
            }
          },
          {
            "id": "child-agent",
            "package": "child-pkg",
            "version": "^0.2.0",
            "capability_mask": {
              "deny": [
                "write"
              ]
            },
            "hierarchy": {
              "parent": "root-agent"
            }
          }
        ],
        "topology": {
          "tree": {
            "root": "root-agent",
            "edges": [
              {
                "parent": "root-agent",
                "child": "child-agent"
              }
            ]
          },
          "relations": [
            {
              "from": "root-agent",
              "to": "child-agent",
              "type": "delegates_to"
            }
          ]
        }
      },
      "files": {
        "org.toml": "1111111111111111111111111111111111111111111111111111111111111111",
        "prompts/persona.md": "2222222222222222222222222222222222222222222222222222222222222222",
        "tests/README.md": "3333333333333333333333333333333333333333333333333333333333333333"
      }
    },
    "expected_valid": true
  },
